page {
  --color-ink: #14231c;
  --color-muted: #5f7268;
  --color-brand: #0b3d2e;
  --color-brand-soft: #1f6b52;
  --color-accent: #c45c26;
  --color-principal: #1f6b52;
  --color-interest: #c45c26;
  --color-surface: rgba(255, 255, 255, 0.78);
  --color-line: rgba(20, 35, 28, 0.1);
  --radius: 18rpx;
  --font-display: "Source Han Serif SC", "Noto Serif SC", "Songti SC", serif;
  --font-body: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;

  min-height: 100%;
  color: var(--color-ink);
  font-family: var(--font-body);
  background:
    radial-gradient(120% 80% at 0% 0%, rgba(31, 107, 82, 0.14), transparent 55%),
    radial-gradient(90% 70% at 100% 10%, rgba(196, 92, 38, 0.12), transparent 50%),
    linear-gradient(180deg, #eef4f0 0%, #f3f6f4 42%, #f7f3ee 100%);
  box-sizing: border-box;
}

view,
text,
input,
button,
scroll-view,
canvas {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
}

.section-title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-brand);
  letter-spacing: 1rpx;
}

.section-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  flex-shrink: 0;
  width: 220rpx;
  font-size: 28rpx;
  color: var(--color-ink);
}

.field-control {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 8rpx;
  text-align: right;
  font-size: 30rpx;
  color: var(--color-ink);
}

.field-unit {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-muted);
}

.segment {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.segment-item {
  min-width: 140rpx;
  padding: 14rpx 22rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-muted);
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
  transition: all 0.2s ease;
}

.segment-item.active {
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(11, 61, 46, 0.18);
}

.primary-btn {
  margin-top: 36rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  box-shadow: 0 16rpx 36rpx rgba(11, 61, 46, 0.22);
}

.primary-btn::after {
  border: none;
}

.panel {
  margin-top: 28rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius);
  background: var(--color-surface);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(8px);
}

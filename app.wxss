/* 默认：青绿 forest */
page {
  --color-ink: #14231c;
  --color-muted: #5f7268;
  --color-brand: #0b3d2e;
  --color-brand-soft: #1f6b52;
  --color-accent: #c45c26;
  --color-principal: #1f6b52;
  --color-interest: #c45c26;
  --color-surface: rgba(255, 255, 255, 0.78);
  --color-line: rgba(20, 35, 28, 0.1);
  --color-footer: #f3f6f4;
  --color-dialog: #f7f8f6;
  --color-mask: rgba(20, 35, 28, 0.45);
  --color-shadow: rgba(11, 61, 46, 0.18);
  --color-shadow-strong: rgba(11, 61, 46, 0.22);
  --bg-glow-1: rgba(31, 107, 82, 0.14);
  --bg-glow-2: rgba(196, 92, 38, 0.12);
  --bg-grad-1: #eef4f0;
  --bg-grad-2: #f3f6f4;
  --bg-grad-3: #f7f3ee;
  --radius: 18rpx;
  --font-display: "Source Han Serif SC", "Noto Serif SC", "Songti SC", serif;
  --font-body: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;

  min-height: 100%;
  color: var(--color-ink);
  font-family: var(--font-body);
  background: var(--bg-grad-2);
  box-sizing: border-box;
}

.theme-forest {
  --color-ink: #14231c;
  --color-muted: #5f7268;
  --color-brand: #0b3d2e;
  --color-brand-soft: #1f6b52;
  --color-accent: #c45c26;
  --color-principal: #1f6b52;
  --color-interest: #c45c26;
  --color-surface: rgba(255, 255, 255, 0.78);
  --color-line: rgba(20, 35, 28, 0.1);
  --color-footer: #f3f6f4;
  --color-dialog: #f7f8f6;
  --color-mask: rgba(20, 35, 28, 0.45);
  --color-shadow: rgba(11, 61, 46, 0.18);
  --color-shadow-strong: rgba(11, 61, 46, 0.22);
  --bg-glow-1: rgba(31, 107, 82, 0.14);
  --bg-glow-2: rgba(196, 92, 38, 0.12);
  --bg-grad-1: #eef4f0;
  --bg-grad-2: #f3f6f4;
  --bg-grad-3: #f7f3ee;
}

.theme-ocean {
  --color-ink: #13233a;
  --color-muted: #5b6f88;
  --color-brand: #123a6b;
  --color-brand-soft: #1f6fb5;
  --color-accent: #d97706;
  --color-principal: #1f6fb5;
  --color-interest: #d97706;
  --color-surface: rgba(255, 255, 255, 0.82);
  --color-line: rgba(19, 35, 58, 0.1);
  --color-footer: #eef3f9;
  --color-dialog: #f5f8fc;
  --color-mask: rgba(19, 35, 58, 0.45);
  --color-shadow: rgba(18, 58, 107, 0.18);
  --color-shadow-strong: rgba(18, 58, 107, 0.22);
  --bg-glow-1: rgba(31, 111, 181, 0.14);
  --bg-glow-2: rgba(217, 119, 6, 0.12);
  --bg-grad-1: #eaf1f9;
  --bg-grad-2: #eef3f9;
  --bg-grad-3: #f4f0ea;
}

.theme-amber {
  --color-ink: #2b2116;
  --color-muted: #7a6a55;
  --color-brand: #7a4a12;
  --color-brand-soft: #b7791f;
  --color-accent: #c05621;
  --color-principal: #b7791f;
  --color-interest: #c05621;
  --color-surface: rgba(255, 255, 255, 0.8);
  --color-line: rgba(43, 33, 22, 0.1);
  --color-footer: #f7f2ea;
  --color-dialog: #fbf7f0;
  --color-mask: rgba(43, 33, 22, 0.45);
  --color-shadow: rgba(122, 74, 18, 0.18);
  --color-shadow-strong: rgba(122, 74, 18, 0.22);
  --bg-glow-1: rgba(183, 121, 31, 0.16);
  --bg-glow-2: rgba(192, 86, 33, 0.12);
  --bg-grad-1: #f6efe4;
  --bg-grad-2: #f7f2ea;
  --bg-grad-3: #f3ebe2;
}

view,
text,
input,
button,
scroll-view,
canvas {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 80rpx;
  color: var(--color-ink);
  background:
    radial-gradient(120% 80% at 0% 0%, var(--bg-glow-1), transparent 55%),
    radial-gradient(90% 70% at 100% 10%, var(--bg-glow-2), transparent 50%),
    linear-gradient(180deg, var(--bg-grad-1) 0%, var(--bg-grad-2) 42%, var(--bg-grad-3) 100%);
}

.section-title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-brand);
  letter-spacing: 1rpx;
}

.section-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  flex-shrink: 0;
  width: 220rpx;
  font-size: 28rpx;
  color: var(--color-ink);
}

.field-control {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 8rpx;
  text-align: right;
  font-size: 30rpx;
  color: var(--color-ink);
}

.field-unit {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-muted);
}

.segment {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.segment-item {
  min-width: 140rpx;
  padding: 14rpx 22rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-muted);
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
  transition: all 0.2s ease;
}

.segment-item.active {
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx var(--color-shadow);
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 36rpx;
  margin-left: 0;
  margin-right: 0;
  padding: 0;
  height: 96rpx;
  line-height: 1.2;
  text-align: center;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  box-shadow: 0 16rpx 36rpx var(--color-shadow-strong);
}

.primary-btn::after {
  border: none;
}

.panel {
  margin-top: 28rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius);
  background: var(--color-surface);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(8px);
}

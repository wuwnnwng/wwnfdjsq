view,
text,
input,
button,
scroll-view,
canvas {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 80rpx;
  color: var(--color-ink);
  background:
    radial-gradient(120% 80% at 0% 0%, var(--bg-glow-1), transparent 55%),
    radial-gradient(90% 70% at 100% 10%, var(--bg-glow-2), transparent 50%),
    linear-gradient(180deg, var(--bg-grad-1) 0%, var(--bg-grad-2) 42%, var(--bg-grad-3) 100%);
  transition: opacity 0.3s ease, color 0.3s ease;
}

.page.is-theme-fading {
  opacity: 0.5;
}

.section-title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-brand);
  letter-spacing: 1rpx;
  transition: color 0.32s ease;
}

.section-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.5;
  transition: color 0.32s ease;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  flex-shrink: 0;
  width: 220rpx;
  font-size: 28rpx;
  color: var(--color-ink);
}

.field-control {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 8rpx;
  text-align: right;
  font-size: 30rpx;
  color: var(--color-ink);
}

.field-input.disabled {
  color: var(--color-muted);
  opacity: 0.55;
}

.field-unit {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-muted);
}

.segment {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.segment-item {
  min-width: 140rpx;
  padding: 14rpx 22rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-muted);
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
  transition: color 0.32s ease, background 0.32s ease, border-color 0.32s ease, box-shadow 0.32s ease;
}

.segment-item.active {
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx var(--color-shadow);
}

.segment-item.disabled {
  opacity: 0.38;
  background: rgba(255, 255, 255, 0.28);
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 36rpx 0 0;
  padding: 0;
  min-height: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  box-shadow: 0 10rpx 24rpx var(--color-shadow);
  transition: background 0.32s ease, box-shadow 0.32s ease, color 0.32s ease;
}

.primary-btn::after {
  border: none;
}

.panel {
  margin-top: 28rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius);
  background: var(--color-surface);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(8px);
  transition: background-color 0.32s ease, border-color 0.32s ease, box-shadow 0.32s ease, color 0.32s ease;
}

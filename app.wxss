/* 默认：青绿 forest */
page {
  --color-ink: #14231c;
  --color-muted: #5f7268;
  --color-brand: #0b3d2e;
  --color-brand-soft: #1f6b52;
  --color-accent: #b86232;
  --color-principal: #1f6b52;
  --color-interest: #b86232;
  --color-surface: rgba(255, 255, 255, 0.78);
  --color-line: rgba(20, 35, 28, 0.1);
  --color-footer: #f3f6f4;
  --color-dialog: #f7f8f6;
  --color-mask: rgba(20, 35, 28, 0.45);
  --color-shadow: rgba(11, 61, 46, 0.18);
  --color-shadow-strong: rgba(11, 61, 46, 0.22);
  --bg-glow-1: rgba(31, 107, 82, 0.14);
  --bg-glow-2: rgba(184, 98, 50, 0.12);
  --bg-grad-1: #eef4f0;
  --bg-grad-2: #f3f6f4;
  --bg-grad-3: #f7f3ee;
  --radius: 18rpx;
  --font-display: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  --font-body: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;

  min-height: 100%;
  color: var(--color-ink);
  font-family: var(--font-body);
  background: var(--bg-grad-2);
  box-sizing: border-box;
}


.date-picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
  background: var(--color-mask);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.date-picker-sheet {
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  background: var(--color-dialog);
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.date-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 28rpx 4rpx;
}

.date-picker-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.date-picker-action {
  min-width: 88rpx;
  padding: 16rpx 8rpx;
  font-size: 28rpx;
  color: var(--color-muted);
}

.date-picker-action.confirm {
  color: var(--color-brand);
  font-weight: 700;
  text-align: right;
}

.date-picker-view {
  width: 100%;
  height: 440rpx;
}

.date-picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  font-size: 32rpx;
  color: var(--color-ink);
}

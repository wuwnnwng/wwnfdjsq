.page {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #eef3f9;
  box-sizing: border-box;
}

.scan {
  position: relative;
  width: 560rpx;
  height: 280rpx;
  margin: 180rpx auto 0;
}

.corner {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border: 8rpx solid #3b82f6;
}

.corner.tl {
  left: 0;
  top: 0;
  border-right: none;
  border-bottom: none;
}

.corner.tr {
  right: 0;
  top: 0;
  border-left: none;
  border-bottom: none;
}

.corner.bl {
  left: 0;
  bottom: 0;
  border-right: none;
  border-top: none;
}

.corner.br {
  right: 0;
  bottom: 0;
  border-left: none;
  border-top: none;
}

.beam {
  position: absolute;
  left: 70rpx;
  right: 70rpx;
  height: 72rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, rgba(191, 219, 254, 0.15), rgba(96, 165, 250, 0.85));
  animation: scan 1.6s ease-in-out infinite alternate;
}

@keyframes scan {
  from { top: 36rpx; }
  to { top: 150rpx; }
}

.scan-title {
  margin: 72rpx 48rpx 28rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #334155;
}

.task {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin: 18rpx 64rpx 0;
  font-size: 26rpx;
  line-height: 1.5;
  color: #94a3b8;
}

.task-ico {
  width: 28rpx;
  height: 28rpx;
  margin-top: 4rpx;
  border: 3rpx solid #cbd5e1;
  border-top-color: #3b82f6;
  border-radius: 50%;
  box-sizing: border-box;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.fail-scroll {
  height: calc(100% - 140rpx - env(safe-area-inset-bottom));
  padding: 24rpx 28rpx 12rpx;
  box-sizing: border-box;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
}

.result-card {
  display: flex;
  gap: 24rpx;
}

.thumb {
  width: 168rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #e2e8f0;
  flex-shrink: 0;
}

.result-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.issue {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #f97316;
}

.issue-ico {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
}

.sample-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.sample-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.sample {
  width: 180rpx;
  flex-shrink: 0;
  text-align: center;
}

.sample-photo {
  height: 220rpx;
  border-radius: 12rpx;
  background: #3b82f6;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
}

.person-head {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e2e8f0;
}

.person-body {
  width: 110rpx;
  height: 90rpx;
  margin-top: -6rpx;
  border-radius: 16rpx 16rpx 0 0;
  background: #1e3a8a;
}

.person {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sample-cap {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.tips {
  flex: 1;
  min-width: 0;
}

.tip {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #334155;
}

.tip-ok {
  color: #22c55e;
  font-weight: 800;
}

.fail-bar {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 96rpx;
}

.again {
  height: 96rpx;
  border-radius: 48rpx;
  background: #3b82f6;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 72rpx;
  box-sizing: border-box;
}

.again-on {
  opacity: 0.86;
}

.forward {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  height: 80rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 40rpx;
  background: #fff;
  color: #2563eb;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 80rpx;
}

.forward::after {
  border: none;
}

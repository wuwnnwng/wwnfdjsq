<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll make-scroll" show-scrollbar="{{false}}">
    <view class="head">
      <view class="head-main" bindtap="onPickSpec">
        <view class="head-name">{{specName}}</view>
        <view class="head-change" wx:if="{{showSpec}}">更换规格</view>
      </view>
      <button class="share-btn" open-type="share">
        <view class="share-ico"></view>
        <text>分享</text>
      </button>
    </view>

    <view class="facts">
      <view class="fact">
        <text class="fact-k">打印尺寸：</text>
        <text class="fact-v">{{printText}}</text>
      </view>
      <view class="fact">
        <text class="fact-k">像素尺寸：</text>
        <text class="fact-v">{{pixelText}}</text>
      </view>
      <view class="fact">
        <text class="fact-k">文件大小：</text>
        <text class="fact-v">{{fileText}}</text>
      </view>
      <view class="fact">
        <text class="fact-k">分辨率：</text>
        <text class="fact-v">{{dpiText}}</text>
      </view>
    </view>

    <view class="color-line" wx:if="{{showBg}}">
      <text class="fact-k">背景色：</text>
      <view class="swatches">
        <view
          class="swatch {{colorId === item.id ? 'on' : ''}} {{item.hex === '#FFFFFF' ? 'white' : ''}}"
          wx:for="{{colors}}"
          wx:key="id"
          style="background: {{item.hex}}"
          data-id="{{item.id}}"
          bindtap="onColor"
        ></view>
        <view class="swatch more {{moreOpen ? 'on' : ''}}" bindtap="onMore">更多</view>
        <block wx:if="{{moreOpen}}">
          <view
            class="swatch {{colorId === item.id ? 'on' : ''}}"
            wx:for="{{moreColors}}"
            wx:key="id"
            style="background: {{item.hex}}"
            data-id="{{item.id}}"
            bindtap="onColor"
          ></view>
        </block>
      </view>
    </view>

    <view class="field format-line" wx:if="{{showFormat}}" bindtap="onPickFormat">
      <text class="fact-k">图片类型：</text>
      <text class="fact-v">{{fileName}} ›</text>
    </view>

    <view class="step-card">
      <view class="steps">
        <view class="step-track"></view>
        <view class="step {{index === 1 ? 'mid' : ''}}" wx:for="{{steps}}" wx:key="no">
          <view class="step-no">{{item.no}}</view>
          <view class="step-name">{{item.name}}</view>
          <view class="step-sub">{{item.sub}}</view>
        </view>
      </view>

      <view class="preview" wx:if="{{src}}" style="background: {{showBg ? colorHex : '#F4F7FB'}}">
        <image class="preview-img" src="{{result || src}}" mode="aspectFit" />
      </view>
      <view class="demo" wx:else>
        <view class="demo-grid">
          <view class="demo-cell" wx:for="{{demoCells}}" wx:key="*this">
            <view class="person">
              <view class="person-head"></view>
              <view class="person-body"></view>
            </view>
          </view>
        </view>
        <view class="demo-focus">
          <view class="person focus">
            <view class="person-head"></view>
            <view class="person-body"></view>
          </view>
          <text class="demo-tag">证件照</text>
        </view>
        <view class="demo-portrait">
          <view class="person large">
            <view class="person-head"></view>
            <view class="person-body suit"></view>
          </view>
        </view>
      </view>
      <view class="preview-meta" wx:if="{{resultMeta}}">{{resultMeta}}</view>
    </view>

    <view class="tune" wx:if="{{src && (showStrength || showOffset)}}">
      <block wx:if="{{showStrength}}">
        <view class="tune-label">换底强度</view>
        <view class="segment">
          <view
            class="segment-item {{strength === item.id ? 'active' : ''}}"
            wx:for="{{strengths}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onStrength"
          >{{item.name}}</view>
        </view>
      </block>
      <block wx:if="{{showOffset}}">
        <view class="tune-label">取景位置</view>
        <slider
          value="{{offset}}"
          min="0"
          max="100"
          activeColor="#3B82F6"
          block-size="20"
          bindchanging="onOffset"
          bindchange="onOffset"
        />
      </block>
    </view>

    <view class="guide">
      <view class="guide-title">拍摄指南</view>
      <view class="guide-item" wx:for="{{guide}}" wx:key="*this">
        <text class="guide-ok">✓</text>
        <text>{{item}}</text>
      </view>
    </view>

    <view class="tool-note warn" wx:if="{{warn}}">{{warn}}</view>
    <view class="tool-note" wx:if="{{showBg}}">换底只替换和边缘相近的颜色。衣服颜色贴近底色时，可能被一起换掉。</view>
    <view class="tool-note" wx:elif="{{mode === 'sharp'}}">在原图上锐化，不能凭空补出没有拍到的细节。</view>
    <view class="tool-note" wx:elif="{{mode === 'format'}}">导出为 JPG 或 PNG。最长边超过 1400 像素时会先缩小。</view>
    <view class="tool-note" wx:else>按规格居中裁切。照片比目标更长或更宽时，用取景位置挪一下。</view>
  </scroll-view>

  <view class="bar">
    <view class="bar-btn line" hover-class="bar-on" bindtap="onAlbum">{{src ? '重新选择' : '相册选择'}}</view>
    <view class="bar-btn fill {{making ? 'busy' : ''}}" hover-class="bar-on" bindtap="onBarPrimary">{{making ? '制作中…' : (result ? '保存到相册' : (src ? '开始制作' : '开始拍摄'))}}</view>
  </view>

  <canvas type="2d" id="outCanvas" class="out-canvas"></canvas>

  <view class="privacy-mask" wx:if="{{privacyOpen}}" bindtap="onRejectPrivacy" catchtouchmove="onHoldPrivacy">
    <view class="privacy-sheet" catchtap="onHoldPrivacy">
      <view class="privacy-title">隐私保护提示</view>
      <view class="privacy-text">制作证件照会读取你选中的照片，用于制作和内容安全检测。请先阅读并同意{{privacyName}}。</view>
      <view class="privacy-link" bindtap="onOpenPrivacy">查看{{privacyName}}</view>
      <button
        id="privacy-agree"
        class="primary-btn privacy-agree"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onAgreePrivacy"
        bindtap="onAgreePrivacy"
      >同意并继续</button>
      <view class="privacy-skip" bindtap="onRejectPrivacy">不同意</view>
    </view>
  </view>
</view>

@import "../../../pages/tools/tool-common.wxss";

.stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 12rpx;
}

.upload {
  width: 420rpx;
  height: 520rpx;
  margin: 0;
  padding: 0;
  line-height: normal;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-surface);
  border: 1rpx solid var(--color-panel-border);
  overflow: hidden;
}

.upload::after {
  border: none;
}

.upload-on {
  opacity: 0.86;
}

.plus {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  line-height: 112rpx;
  text-align: center;
  font-size: 72rpx;
  font-weight: 500;
  color: var(--color-on-brand);
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
}

.upload-tip {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--color-muted);
}

.photo {
  width: 100%;
  height: 100%;
}

.rechoose,
.meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.dock {
  margin-bottom: 24rpx;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 0 8rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.field-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.field-label.alone {
  margin-top: 24rpx;
}

.field-value {
  font-size: 26rpx;
  color: var(--color-muted);
}

.swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 18rpx;
}

.swatch {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 4rpx solid transparent;
}

.swatch.white {
  border-color: var(--color-line);
}

.swatch.on {
  box-shadow: 0 0 0 4rpx var(--color-brand);
}

.swatch.more {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #fb7185, #e11d48);
}

.primary-btn.busy {
  opacity: 0.6;
}

.out-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 300px;
  height: 400px;
}

.primary-btn.ghost {
  color: var(--color-brand);
  background: var(--color-chip);
  box-shadow: none;
}

.privacy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.45);
}

.privacy-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--color-surface);
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-ink);
}

.privacy-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-ink);
}

.privacy-link {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-brand);
}

.privacy-agree {
  width: 100%;
  margin-top: 28rpx;
}

.privacy-agree::after {
  border: none;
}

.privacy-skip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-muted);
}

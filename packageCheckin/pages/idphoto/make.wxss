@import "../../../pages/tools/tool-common.wxss";

.make-scroll {
  padding: 12rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 4rpx 12rpx;
}

.head-main {
  min-width: 0;
}

.head-name {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #1e293b;
}

.head-change {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.share-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: #fff;
  color: #334155;
  font-size: 26rpx;
  line-height: 1;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.06);
}

.share-btn::after {
  border: none;
}

.share-ico {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #3b82f6;
  border-radius: 4rpx;
  position: relative;
}

.share-ico::after {
  content: '';
  position: absolute;
  right: -6rpx;
  top: -8rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #3b82f6;
  border-right: 3rpx solid #3b82f6;
}

.facts {
  display: flex;
  flex-wrap: wrap;
}

.fact,
.color-line,
.format-line {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 56rpx;
  font-size: 26rpx;
}

.fact {
  width: 50%;
}

.color-line,
.format-line {
  width: 100%;
  margin-top: 6rpx;
}

.fact-k {
  color: #64748b;
}

.fact-v {
  color: #0f172a;
  font-weight: 600;
}

.swatches {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

.swatch {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 4rpx solid transparent;
}

.swatch.white {
  border-color: #e2e8f0;
}

.swatch.on {
  box-shadow: 0 0 0 4rpx #3b82f6;
}

.swatch.more {
  width: auto;
  min-width: 64rpx;
  padding: 0 12rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  background: #94a3b8;
}

.step-card,
.guide,
.tune {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.steps {
  position: relative;
  display: flex;
  justify-content: space-between;
}

.step-track {
  position: absolute;
  left: 16%;
  right: 16%;
  top: 22rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #bfdbfe, #3b82f6 48%, #bfdbfe);
}

.step {
  position: relative;
  z-index: 1;
  width: 33%;
  text-align: center;
}

.step-no {
  display: inline-block;
  padding: 0 10rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #334155;
  background: #fff;
}

.step.mid .step-no {
  color: #0f172a;
}

.step-name {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #f97316;
}

.step-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.demo {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 18rpx;
  margin-top: 28rpx;
  min-height: 280rpx;
}

.demo-grid {
  width: 210rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.demo-cell {
  width: 100rpx;
  height: 128rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #dbeafe, #f8fafc);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
}

.demo-focus {
  width: 132rpx;
  height: 220rpx;
  border-radius: 12rpx;
  background: linear-gradient(180deg, #60a5fa, #dbeafe);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  overflow: hidden;
}

.demo-tag {
  margin: 8rpx 0 12rpx;
  font-size: 20rpx;
  color: #1e3a8a;
}

.demo-portrait {
  width: 210rpx;
  height: 280rpx;
  border-radius: 12rpx;
  background: linear-gradient(180deg, #f8fafc, #e2e8f0);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
}

.person {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.person-head {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #94a3b8;
}

.person-body {
  width: 44rpx;
  height: 48rpx;
  margin-top: -4rpx;
  border-radius: 16rpx 16rpx 0 0;
  background: #64748b;
}

.person.focus .person-head,
.person.large .person-head {
  width: 48rpx;
  height: 48rpx;
  background: #cbd5e1;
}

.person.focus .person-body {
  width: 72rpx;
  height: 70rpx;
  background: #1d4ed8;
}

.person.large .person-body.suit {
  width: 120rpx;
  height: 150rpx;
  background: #d6d3d1;
}

.preview {
  margin-top: 28rpx;
  height: 460rpx;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-meta {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #64748b;
}

.tune-label {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
}

.tune-label + .segment,
.segment + .tune-label {
  margin-top: 16rpx;
}

.bar {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.bar-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.bar-btn.line {
  color: #3b82f6;
  background: #fff;
  border: 2rpx solid #93c5fd;
}

.bar-btn.fill {
  color: #fff;
  background: #3b82f6;
}

.bar-btn.busy {
  opacity: 0.6;
}

.bar-on {
  opacity: 0.82;
}

.guide-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.guide-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #334155;
}

.guide-ok {
  color: #22c55e;
  font-weight: 800;
}

.out-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 300px;
  height: 400px;
}

.privacy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.45);
}

.privacy-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--color-surface);
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-ink);
}

.privacy-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-ink);
}

.privacy-link {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-brand);
}

.privacy-agree {
  width: 100%;
  margin-top: 28rpx;
}

.privacy-agree::after {
  border: none;
}

.privacy-skip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-muted);
}

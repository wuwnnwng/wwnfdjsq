<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll {{reading ? 'is-hidden' : ''}}" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-id">
        <view class="tool-icon-wrap tool-icon-exam">
          <text class="tool-icon">📘</text>
        </view>
        <view class="conv-hero-copy">
          <view class="conv-kicker">行测 · 申论 · 技巧卡片</view>
          <view class="conv-title">公考题型技巧</view>
        </view>
      </view>
      <view class="conv-eq">{{kicker}}</view>
    </view>

    <view class="panel">
      <view class="seg-row">
        <view class="seg-item {{tab === 'xingce' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="xingce">行测</view>
        <view class="seg-item {{tab === 'shenlun' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="shenlun">申论</view>
      </view>
      <view class="type-list">
        <view class="type-row" wx:for="{{types}}" wx:key="id" bindtap="onOpenType" data-id="{{item.id}}">
          <view class="type-copy">
            <view class="type-name">{{item.name}}</view>
            <view class="type-hint">{{item.hint}} · {{item.count}} 张卡片</view>
          </view>
          <view class="type-go">看卡片</view>
        </view>
      </view>
      <view class="tool-note">按题型整理的答题方法小卡片，便于考前过一遍。是通用技巧，不能代替真题。下次进来会记住你看到哪张。</view>
    </view>
  </scroll-view>

  <view class="reader" wx:if="{{reading}}">
    <view class="reader-top">
      <view class="reader-back" bindtap="onCloseReader">‹ 题型</view>
      <view class="reader-head">
        <view class="reader-name">{{typeName}}</view>
        <view class="reader-hint">{{typeHint}} · {{cardIndex + 1}} / {{cardTotal}}</view>
      </view>
    </view>
    <swiper class="reader-swiper" current="{{cardIndex}}" bindchange="onSwiperChange">
      <swiper-item wx:for="{{cards}}" wx:key="no">
        <scroll-view scroll-y class="card-scroll" enhanced show-scrollbar="{{false}}">
          <view class="tip-card">
            <view class="tip-meta">
              <text class="tip-no">{{item.no}}</text>
              <text class="tip-tag">{{item.tag}}</text>
            </view>
            <view class="tip-title">{{item.title}}</view>
            <view class="tip-body">{{item.body}}</view>
          </view>
        </scroll-view>
      </swiper-item>
    </swiper>
    <view class="reader-nav">
      <view class="nav-btn {{cardIndex === 0 ? 'is-off' : ''}}" bindtap="onPrev">上一张</view>
      <view class="nav-btn {{cardIndex === cardTotal - 1 ? 'is-off' : ''}}" bindtap="onNext">下一张</view>
    </view>
  </view>
</view>

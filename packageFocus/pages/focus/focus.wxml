<page-container
  show="{{retainBack}}"
  overlay="{{false}}"
  duration="{{0}}"
  z-index="1"
  custom-style="height:0;width:0;overflow:hidden;opacity:0;background:transparent;"
  bindbeforeleave="onRetainBack"
/>
<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-id">
        <view class="tool-icon-wrap tool-icon-focus">
          <text class="tool-icon">🎯</text>
        </view>
        <view class="conv-hero-copy">
          <view class="conv-kicker">娱乐 · 趣味自测</view>
          <view class="conv-title">综合脑力自测</view>
        </view>
      </view>
      <block wx:if="{{stage === 'home'}}">
        <view class="conv-eq">{{dimHint}}</view>
        <view class="conv-result">{{dimName}}</view>
      </block>
      <block wx:elif="{{stage === 'levels'}}">
        <view class="conv-eq">{{dimName}} · {{subName}}</view>
        <view class="conv-result">选难度</view>
      </block>
      <block wx:elif="{{stage === 'play'}}">
        <view class="conv-eq">{{levelName}} · 第 {{no}} / {{total}} 题</view>
        <view class="conv-result">{{liveScore}} 分</view>
        <view class="conv-result-unit">{{subName}}</view>
        <view class="conv-result-unit" wx:if="{{phase === 'flash'}}">还剩 {{flashLeft}} 秒</view>
      </block>
      <block wx:else>
        <view class="conv-eq">{{result.levelName}} · {{result.subName}}</view>
        <view class="conv-result">{{result.gradeName}}</view>
        <view class="conv-result-unit">{{result.score}} 分</view>
      </block>
    </view>

    <ad-banner theme="{{theme}}" />

    <view class="panel" wx:if="{{stage === 'home'}}">
      <view class="seg-row cols-3">
        <view
          class="seg-item {{dimId === item.id ? 'active' : ''}}"
          wx:for="{{dims}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onSwitchDim"
        >{{item.name}}</view>
      </view>
      <view
        class="cat-card tone-{{item.tone}}"
        wx:for="{{subs}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onOpenSub"
      >
        <view class="cat-no">{{item.no}}</view>
        <view class="cat-copy">
          <view class="cat-name">{{item.name}}</view>
          <view class="cat-hint">{{item.hint}}</view>
        </view>
        <view class="cat-go">进入</view>
      </view>
    </view>

    <view class="panel" wx:elif="{{stage === 'levels'}}">
      <view class="back-link" bindtap="onBack">‹ 返回</view>
      <view class="level-list">
        <view
          class="level-card is-{{item.id}}"
          wx:for="{{levels}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onStartLevel"
        >
          <view class="level-top">
            <text class="level-name">{{item.name}}</text>
            <text class="level-rounds">{{item.rounds}} 题</text>
          </view>
          <view class="level-bars">
            <view class="level-bar {{bar.on ? 'on' : ''}}" wx:for="{{item.bars}}" wx:for-item="bar" wx:key="n"></view>
          </view>
          <view class="level-hint">{{item.hint}}</view>
        </view>
      </view>
    </view>

    <view class="panel" wx:elif="{{stage === 'play'}}">
      <view class="back-link" bindtap="onBack">‹ 返回</view>
      <view class="q-prompt">{{prompt}}</view>
      <view class="q-hint" wx:if="{{hint}}">{{hint}}</view>

      <view class="arena {{ballStill ? 'is-still' : ''}}" wx:if="{{showArena}}" style="{{arenaStyle}}">
        <view
          class="ball {{item.marked ? 'is-mark' : ''}} {{item.status}}"
          wx:for="{{balls}}"
          wx:key="id"
          style="left: {{item.x}}%; top: {{item.y}}%; background: {{item.color}}; color: {{item.ink}};"
          data-id="{{item.id}}"
          bindtap="onTapBall"
        >
          <text wx:if="{{item.label}}">{{item.label}}</text>
        </view>
      </view>

      <view class="board" wx:if="{{board.kind}}">
        <text class="board-digits {{board.compact ? 'is-compact' : ''}}" wx:if="{{board.kind === 'digits'}}">{{board.text}}</text>
        <view class="symbol-row" wx:elif="{{board.kind === 'symbols'}}">
          <view class="symbol-item" wx:for="{{board.symbols}}" wx:key="n">{{item.text}}</view>
        </view>
        <view class="mini-grid n{{board.gridSize}}" wx:elif="{{board.kind === 'grid'}}">
          <view class="mini-cell {{cell.on ? 'on' : ''}}" wx:for="{{board.cells}}" wx:for-item="cell" wx:key="n"></view>
        </view>
        <view class="path-board" wx:elif="{{board.kind === 'path'}}">
          <view class="path-moves">{{board.text}}</view>
          <view class="mini-grid n{{board.gridSize}}">
            <view class="mini-cell {{cell.start ? 'start' : ''}}" wx:for="{{board.cells}}" wx:for-item="cell" wx:key="n"></view>
          </view>
        </view>
        <view class="pair" wx:elif="{{board.kind === 'pair'}}">
          <view class="pair-col">
            <view class="pair-num">{{board.left}}</view>
            <view class="pair-tag">左</view>
          </view>
          <view class="pair-col">
            <view class="pair-num">{{board.right}}</view>
            <view class="pair-tag">右</view>
          </view>
        </view>
        <view class="swatch" wx:elif="{{board.kind === 'swatch'}}" style="background: {{board.swatch}};"></view>
        <text class="board-glyph" wx:elif="{{board.kind === 'glyph'}}">{{board.glyph}}</text>
        <view class="stroop" wx:elif="{{board.kind === 'stroop'}}">
          <text class="stroop-word">{{board.note}}</text>
          <text class="board-glyph">{{board.glyph}}</text>
        </view>
      </view>

      <view class="tap-wrap" wx:if="{{tapItems.length}}">
        <view
          class="tap-item {{item.status}}"
          wx:for="{{tapItems}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onTapItem"
        >{{item.text}}</view>
      </view>

      <view
        class="quiz-opt {{item.status}}"
        wx:for="{{options}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onPick"
      >
        <view class="quiz-opt-main">
          <text class="quiz-opt-key">{{item.key}}</text>
          <text class="quiz-opt-text" wx:if="{{item.text}}">{{item.text}}</text>
          <view class="mini-grid sm n{{item.gridSize}}" wx:if="{{item.grid}}">
            <view class="mini-cell {{cell.on ? 'on' : ''}}" wx:for="{{item.cells}}" wx:for-item="cell" wx:key="n"></view>
          </view>
        </view>
      </view>
      <view class="mark-line" wx:if="{{markText}}">{{markText}}</view>
    </view>

    <view class="panel result-panel" wx:else>
      <view class="info-card featured">
        <view class="info-card-label">{{result.dimName}} · {{result.subName}}</view>
        <view class="info-card-value">{{result.gradeName}}</view>
        <view class="info-card-sub">{{result.levelName}} · {{result.score}} 分 · {{result.gradeLine}}</view>
      </view>
      <view class="tool-note">{{result.comment}}{{result.tip}}</view>
      <view class="result-title">小建议</view>
      <view class="tool-note" wx:for="{{result.tips}}" wx:key="*this">{{item}}</view>
      <button class="primary-btn" bindtap="onRetry">再来一局</button>
      <view class="swap-btn" bindtap="onBack">返回上一级</view>
    </view>

    <view class="tool-note focus-disclaimer">{{disclaimer}}</view>
  </scroll-view>
</view>

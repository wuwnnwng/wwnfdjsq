@import "../../../pages/tools/tool-common.wxss";
@import "../../../pages/tools/calc-kit.wxss";

.conv-hero {
  background:
    linear-gradient(160deg, var(--bg-glow-1) 0%, var(--color-hero-fade) 58%),
    var(--color-surface);
}

.tool-icon-focus {
  background: linear-gradient(135deg, #ccfbf1, #2dd4bf);
}

.back-link {
  margin-bottom: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-accent);
}

.type-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.type-row:last-child {
  border-bottom: none;
}

.type-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.type-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--color-muted);
}

.type-go {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-accent);
}

.info-card:active,
.type-row:active,
.cat-card:active,
.level-card:active {
  opacity: 0.86;
}

.cat-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 26rpx 22rpx;
  border-radius: 20rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-left: 10rpx solid var(--color-brand);
  box-shadow: 0 12rpx 28rpx var(--color-shadow);
}

.cat-card.tone-accent {
  border-left-color: var(--color-accent);
}

.cat-no {
  flex-shrink: 0;
  width: 72rpx;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--color-brand);
}

.cat-card.tone-accent .cat-no {
  color: var(--color-accent);
}

.cat-copy {
  flex: 1;
  min-width: 0;
}

.cat-name {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
  color: var(--color-ink);
}

.cat-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--color-muted);
}

.cat-go {
  flex-shrink: 0;
  min-width: 96rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  text-align: center;
  line-height: 56rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-on-brand);
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
}

.level-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.level-card {
  padding: 24rpx 22rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--color-line);
  background: var(--color-soft);
}

.level-card.is-classic {
  background:
    linear-gradient(160deg, var(--bg-glow-1) 0%, var(--color-soft) 70%),
    var(--color-soft);
}

.level-card.is-advanced {
  border-color: var(--color-brand-soft);
  background:
    linear-gradient(160deg, var(--bg-glow-1) 0%, var(--color-card) 62%),
    var(--color-card);
  box-shadow: 0 10rpx 24rpx var(--color-shadow);
}

.level-card.is-challenge {
  border-color: transparent;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  box-shadow: 0 14rpx 28rpx var(--color-shadow);
}

.level-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.level-name {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-brand);
}

.level-card.is-advanced .level-name {
  font-size: 36rpx;
}

.level-card.is-challenge .level-name {
  font-size: 40rpx;
}

.level-card.is-challenge .level-name,
.level-card.is-challenge .level-rounds,
.level-card.is-challenge .level-hint {
  color: var(--color-on-brand);
}

.level-rounds {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-muted);
}

.level-bars {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
}

.level-bar {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--color-line);
}

.level-bar.on {
  background: var(--color-brand-soft);
}

.level-card.is-advanced .level-bar.on {
  background: var(--color-brand);
}

.level-card.is-challenge .level-bar {
  background: rgba(255, 255, 255, 0.28);
}

.level-card.is-challenge .level-bar.on {
  background: var(--color-on-brand);
}

.level-hint {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--color-muted);
}

.q-prompt {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--color-ink);
}

.q-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.board {
  margin-top: 20rpx;
  min-height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 16rpx;
  border-radius: 20rpx;
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.board-digits,
.board-glyph {
  font-weight: 800;
  color: var(--color-brand);
  line-height: 1.2;
}

.board-digits {
  font-size: 56rpx;
  letter-spacing: 8rpx;
}

.board-digits.is-compact {
  font-size: 40rpx;
  letter-spacing: 4rpx;
}

.board-glyph {
  font-size: 96rpx;
}

.symbol-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.symbol-item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-brand);
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
}

.mini-grid {
  width: 210rpx;
  height: 210rpx;
  display: grid;
  gap: 8rpx;
}

.mini-grid.n3 {
  grid-template-columns: repeat(3, 1fr);
}

.mini-grid.n4 {
  width: 280rpx;
  height: 280rpx;
  grid-template-columns: repeat(4, 1fr);
}

.mini-grid.sm.n3 {
  width: 132rpx;
  height: 132rpx;
  gap: 6rpx;
}

.mini-grid.sm.n4 {
  width: 168rpx;
  height: 168rpx;
  gap: 6rpx;
}

.mini-cell {
  border-radius: 8rpx;
  background: var(--color-chip);
  border: 1rpx solid var(--color-line);
}

.mini-cell.on,
.mini-cell.start {
  background: var(--color-brand);
  border-color: transparent;
}

.mini-cell.start {
  background: var(--color-accent);
}

.path-board {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.path-moves {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: var(--color-brand);
}

.pair {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.pair-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.pair-num {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--color-brand);
  line-height: 1;
}

.pair-tag {
  font-size: 22rpx;
  color: var(--color-muted);
}

.swatch {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  box-shadow: 0 10rpx 24rpx var(--color-shadow);
}

.stroop {
  position: relative;
  width: 240rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stroop-word {
  position: absolute;
  font-size: 140rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--color-muted);
  opacity: 0.28;
}

.stroop .board-glyph {
  position: relative;
  font-size: 96rpx;
}

.arena {
  position: relative;
  height: 460rpx;
  margin-top: 12rpx;
}

.ball {
  position: absolute;
  width: 96rpx;
  height: 96rpx;
  margin-left: -48rpx;
  margin-top: -48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 20rpx var(--color-shadow);
  transition: left var(--ball-move, 400ms) ease-in-out, top var(--ball-move, 400ms) ease-in-out;
}

.arena.is-still .ball {
  transition: none;
}

.ball.is-mark {
  box-shadow: 0 0 0 8rpx var(--color-card), 0 0 0 16rpx var(--color-brand);
}

.ball.ok {
  box-shadow: 0 0 0 8rpx #34d399;
}

.ball.bad {
  box-shadow: 0 0 0 8rpx #f87171;
}

.tap-wrap {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.tap-item {
  min-width: 96rpx;
  height: 96rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-ink);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.tap-item.ok {
  border-color: #34d399;
  background: rgba(52, 211, 153, 0.12);
}

.tap-item.bad {
  border-color: #f87171;
  background: rgba(248, 113, 113, 0.12);
}

.quiz-opt {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
}

.quiz-opt.ok {
  border-color: #34d399;
  background: rgba(52, 211, 153, 0.12);
}

.quiz-opt.bad {
  border-color: #f87171;
  background: rgba(248, 113, 113, 0.12);
}

.quiz-opt-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.quiz-opt-key {
  flex-shrink: 0;
  width: 40rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-accent);
  line-height: 1.55;
}

.quiz-opt-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.55;
  font-weight: 600;
  color: var(--color-ink);
}

.mark-line {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.result-title {
  margin-top: 28rpx;
}

.focus-disclaimer {
  margin: 8rpx 8rpx 24rpx;
}

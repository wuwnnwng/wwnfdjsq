<view class="page page-shell theme-{{theme}}">
  <view class="panel conv-hero footprint-hero">
    <view class="conv-hero-id">
      <view class="tool-icon-wrap tool-icon-footprint">
        <text class="tool-icon">🗺️</text>
      </view>
      <view class="conv-hero-copy">
        <view class="conv-kicker">点亮 · 省份 · 足迹</view>
        <view class="conv-title">足迹地图</view>
      </view>
    </view>
    <view class="conv-eq">已点亮 {{litCount}} / {{totalCount}} 省</view>
  </view>

  <view class="panel map-panel">
    <ec-canvas id="footprintMap" canvas-id="footprintChina" class="map-canvas" ec="{{ec}}"></ec-canvas>
  </view>

  <scroll-view scroll-y class="tool-scroll chip-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel chip-panel">
      <view class="chip-head">
        <view class="chip-title">点亮省份</view>
        <view class="chip-clear {{litCount ? '' : 'is-off'}}" bindtap="onClearAll">全部熄灭</view>
      </view>
      <view class="chip-grid">
        <view
          class="prov-chip {{item.lit ? 'is-lit' : ''}}"
          wx:for="{{chips}}"
          wx:key="name"
          style="{{item.lit ? 'background:' + item.color + ';' : ''}}"
          bindtap="onToggleChip"
          data-name="{{item.name}}"
        >{{item.name}}</view>
      </view>
      <view class="tool-note">点灰色省名即可点亮，地图上对应区块会变成这个省自己的颜色。再点一次会熄灭。记录保存在这台手机上。</view>
    </view>
  </scroll-view>
</view>

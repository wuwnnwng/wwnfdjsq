<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll has-save-bar" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-id">
        <view class="tool-icon-wrap tool-icon-footprint">
          <text class="tool-icon">🗺️</text>
        </view>
        <view class="conv-hero-copy">
          <view class="conv-kicker">点亮省份 · 导出卡片</view>
          <view class="conv-title">足迹</view>
        </view>
      </view>
      <view class="foot-title-row">
        <text class="foot-title-label">卡片标题</text>
        <input
          class="foot-title-input"
          value="{{title}}"
          maxlength="{{titleMaxLen}}"
          placeholder="我的足迹"
          placeholder-class="foot-title-placeholder"
          bindinput="onTitleInput"
        />
      </view>
    </view>

    <view class="panel foot-map-panel">
      <view class="section-title">中国地图</view>
      <view class="foot-map-wrap" catchtouchmove="preventMove">
        <canvas type="2d" id="chinaMap" class="foot-map" bindtouchstart="onMapTouch"></canvas>
      </view>
      <view class="tool-note">点地图或下方名称点亮省份，再点一次取消。未点亮只显示轮廓。</view>
    </view>

    <view class="panel foot-list-panel">
      <view class="section-title">省份名称</view>
      <view class="foot-chip-grid">
        <view
          class="foot-chip {{item.selected ? 'is-on' : ''}} {{item.focused ? 'is-focus' : ''}}"
          wx:for="{{provinces}}"
          wx:key="id"
          bindtap="onTapProvince"
          data-id="{{item.id}}"
          style="{{item.chipStyle}}"
        >
          <view class="foot-chip-dot" wx:if="{{item.selected}}" style="background: {{item.color}};"></view>
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="save-bar-spacer"></view>
  </scroll-view>

  <view class="save-card-bar">
    <view class="primary-btn save-card-btn" bindtap="onSaveCard">{{savingCard ? '正在保存…' : '导出足迹卡片'}}</view>
  </view>
  <canvas type="2d" id="resultCard" class="result-card-canvas"></canvas>
</view>

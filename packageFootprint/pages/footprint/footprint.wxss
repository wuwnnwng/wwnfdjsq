@import "../../../pages/tools/tool-common.wxss";
@import "../../../pages/tools/calc-kit.wxss";

.conv-hero {
  background:
    linear-gradient(160deg, rgba(56, 189, 248, 0.16) 0%, var(--color-hero-fade) 58%),
    var(--color-surface);
}

.tool-icon-footprint {
  background: linear-gradient(135deg, #e0f2fe, #38bdf8);
}

.footprint-hero {
  flex-shrink: 0;
  margin-bottom: 16rpx;
}

.map-panel {
  flex-shrink: 0;
  height: 560rpx;
  padding: 8rpx 12rpx 16rpx;
  margin-bottom: 16rpx;
}

.map-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.chip-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.chip-panel {
  margin-bottom: 24rpx;
}

.chip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.chip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.chip-clear {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-accent);
}

.chip-clear.is-off {
  opacity: 0.4;
}

.chip-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
}

.prov-chip {
  position: relative;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #94a3b8;
  background: rgba(148, 163, 184, 0.18);
  overflow: hidden;
  white-space: nowrap;
  user-select: none;
}

.prov-chip.is-start {
  box-shadow: 0 0 0 3rpx #f59e0b;
}

.start-flag {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 24rpx;
  padding: 0 6rpx;
  height: 24rpx;
  line-height: 24rpx;
  font-size: 16rpx;
  font-weight: 800;
  color: #ffffff;
  background: #f59e0b;
  border-bottom-left-radius: 10rpx;
}

.theme-nexus .prov-chip {
  color: #8b9cb3;
  background: rgba(148, 163, 184, 0.14);
}

.prov-chip.is-lit {
  color: #ffffff;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.28);
}

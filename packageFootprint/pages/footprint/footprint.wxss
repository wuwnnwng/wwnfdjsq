.page-shell {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  padding-bottom: 0;
  overflow: hidden;
}

.tool-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.foot-board {
  margin: 16rpx 16rpx 0;
  padding: 0 0 16rpx;
  overflow: hidden;
  background: #111;
  border: 1rpx solid #2a2a2a;
  border-radius: 20rpx;
}

.foot-map-wrap {
  height: 780rpx;
  background: #111;
}

.foot-map {
  width: 100%;
  height: 100%;
}

.foot-chip-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
  padding: 8rpx 12rpx 4rpx;
}

.foot-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 56rpx;
  padding: 0 2rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #8a8a8a;
  background: #2a2a2a;
  border: 1rpx solid #2a2a2a;
  box-sizing: border-box;
}

.foot-chip.is-on {
  color: #fff;
}

.foot-chip.is-focus {
  box-shadow: 0 0 0 3rpx rgba(255, 255, 255, 0.28);
}

.save-card-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-footer);
  box-shadow: 0 -12rpx 28rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.save-card-bar .save-card-btn {
  width: 100%;
  margin: 0;
  min-height: 88rpx;
  height: 88rpx;
  box-sizing: border-box;
}

.tool-scroll.has-save-bar {
  padding-bottom: 0;
}

.save-bar-spacer {
  height: calc(148rpx + env(safe-area-inset-bottom));
}

.result-card-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 300px;
  height: 620px;
}

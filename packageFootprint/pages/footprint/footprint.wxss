@import "/pages/tools/tool-common.wxss";
@import "/pages/tools/calc-kit.wxss";

.conv-hero {
  background:
    linear-gradient(160deg, var(--bg-glow-1) 0%, var(--color-hero-fade) 58%),
    var(--color-surface);
}

.tool-icon-footprint {
  background: linear-gradient(135deg, #ccfbf1, #2dd4bf);
}

.foot-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 72rpx;
  margin-top: 20rpx;
  padding: 4rpx 0 8rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.foot-title-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-muted);
}

.foot-title-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.foot-title-placeholder {
  color: var(--color-muted);
}

.foot-stats {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
  margin-top: 24rpx;
}

.foot-stat-num {
  font-family: var(--font-display);
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
  color: var(--color-brand);
}

.foot-stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.foot-stat-actions {
  margin-left: auto;
  display: flex;
  gap: 12rpx;
}

.foot-mini-btn {
  min-width: 88rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 18rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-on-brand);
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
}

.foot-mini-btn.ghost {
  color: var(--color-brand);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.foot-map-panel,
.foot-list-panel {
  padding: 24rpx 22rpx 28rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.foot-map-wrap {
  margin-top: 16rpx;
  height: 560rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.foot-map {
  width: 100%;
  height: 100%;
}

.foot-chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.foot-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 120rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-ink);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
  box-sizing: border-box;
}

.foot-chip.is-focus {
  box-shadow: 0 0 0 4rpx var(--color-brand-soft);
}

.foot-chip-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.result-card-canvas {
  width: 300px;
  height: 600px;
}

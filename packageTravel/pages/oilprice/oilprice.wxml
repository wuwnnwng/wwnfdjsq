<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll has-save-bar" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-oilprice">
            <text class="tool-icon">⛽</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">汽油 · 柴油 · 各省挂牌</view>
            <view class="conv-title">今日油价</view>
          </view>
        </view>
        <view class="oil-refresh {{loading ? 'is-off' : ''}}" bindtap="onRefresh">刷新</view>
      </view>

      <picker mode="selector" range="{{provinceNames}}" value="{{provinceIndex}}" bindchange="onProvinceChange">
        <view class="oil-place">
          <text class="oil-place-name">{{provinceName}}</text>
          <text class="oil-place-caret">切换省份</text>
        </view>
      </picker>

      <view class="conv-eq">{{gradeLabel}}</view>
      <view class="conv-result">{{heroPriceText}}<text class="conv-result-suffix"> 元/升</text></view>
      <view class="conv-result-unit oil-change {{heroChangeDir}}">
        {{heroChangeText ? '较上次调价 ' + heroChangeText : (loading ? '正在获取今日油价…' : '—')}}
      </view>
      <view class="oil-meta" wx:if="{{date}}">数据日期 {{date}}</view>
      <view class="tool-note warn" wx:if="{{error}}">{{error}}</view>
    </view>

    <view class="panel" wx:if="{{cards.length}}">
      <view class="oil-grades">
        <view
          class="oil-grade {{item.key === gradeKey ? 'active' : ''}}"
          wx:for="{{cards}}"
          wx:key="key"
          bindtap="onSelectGrade"
          data-key="{{item.key}}"
        >
          <view class="oil-grade-label">{{item.short}}</view>
          <view class="oil-grade-price">{{item.priceText}}</view>
          <view class="oil-grade-change {{item.changeDir}}">{{item.changeText}}</view>
        </view>
      </view>
    </view>

    <view class="panel" wx:if="{{list.length}}">
      <view class="section-title">各省 {{gradeLabel}}</view>
      <view
        class="oil-row {{item.active ? 'active' : ''}}"
        wx:for="{{list}}"
        wx:key="id"
        bindtap="onSelectProvince"
        data-id="{{item.id}}"
      >
        <view class="oil-row-name">{{item.name}}</view>
        <view class="oil-row-price">{{item.priceText}}</view>
        <view class="oil-row-change {{item.changeDir}}">{{item.changeText}}</view>
      </view>
      <view class="tool-note">{{note}}</view>
    </view>
    <view class="panel" wx:elif="{{!loading}}">
      <view class="tool-note">{{note || '暂无油价数据。'}}</view>
    </view>
    <view class="save-bar-spacer"></view>
  </scroll-view>

  <view class="save-card-bar">
    <view class="primary-btn save-card-btn" bindtap="onGoFuel">用当前油价去算油耗</view>
  </view>
</view>

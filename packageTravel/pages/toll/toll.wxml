<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-toll">
            <text class="tool-icon">🛣️</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">里程 · 车型 · ETC</view>
            <view class="conv-title">高速过路费估算</view>
          </view>
        </view>
      </view>
      <block wx:if="{{result && result.valid}}">
        <view class="conv-eq">{{result.formulaText}}</view>
        <view class="conv-result">{{result.heroText}}</view>
        <view class="conv-result-unit">{{result.subText}}</view>
      </block>
      <view class="tool-note warn" wx:elif="{{result && !result.valid}}">{{result.message}}</view>
    </view>

    <view class="panel">
      <view class="field">
        <view class="field-label-wrap">
          <text class="field-label">参考省份</text>
          <view class="help-icon" catchtap="onShowProvinceTip" aria-role="button" aria-label="参考省份说明">!</view>
        </view>
        <picker mode="selector" range="{{provinceNames}}" value="{{provinceIndex}}" bindchange="onProvinceChange">
          <view class="field-control">
            <text class="picker-value">{{provinceName}}</text>
            <text class="field-unit">切换</text>
          </view>
        </picker>
      </view>

      <view class="field field-stack">
        <text class="field-label">车型</text>
        <view class="seg-row field-seg">
          <view
            wx:for="{{vehicles}}"
            wx:key="key"
            class="seg-item {{vehicleKey === item.key ? 'active' : ''}}"
            bindtap="onSwitchVehicle"
            data-key="{{item.key}}"
          >
            {{item.short}}
          </view>
        </view>
        <view class="tool-note vehicle-hint">{{vehicleHint}}</view>
      </view>

      <view class="field">
        <text class="field-label">高速里程</text>
        <view class="field-control">
          <input class="field-input" type="digit" value="{{distance}}" data-field="distance" bindinput="onInput" placeholder="例如 200" />
          <text class="field-unit">公里</text>
        </view>
      </view>
      <view class="field">
        <text class="field-label">每公里费率</text>
        <view class="field-control">
          <input class="field-input" type="digit" value="{{rate}}" data-field="rate" bindinput="onInput" placeholder="例如 0.45" />
          <text class="field-unit">元/公里</text>
        </view>
      </view>
      <view class="field">
        <text class="field-label">桥梁隧道等</text>
        <view class="field-control">
          <input class="field-input" type="digit" value="{{extra}}" data-field="extra" bindinput="onInput" placeholder="没有可空着" />
          <text class="field-unit">元</text>
        </view>
      </view>

      <view class="opt-row" hover-class="opt-row-hover" hover-stay-time="80" bindtap="onToggle" data-field="roundTrip">
        <view class="opt-copy">
          <view class="opt-title">往返</view>
          <view class="opt-sub">里程和附加费按来回两趟计</view>
        </view>
        <view class="opt-switch {{roundTrip ? 'on' : ''}}"><view class="opt-knob"></view></view>
      </view>
      <view class="opt-row" hover-class="opt-row-hover" hover-stay-time="80" bindtap="onToggle" data-field="etcOn">
        <view class="opt-copy">
          <view class="opt-title">ETC 优惠</view>
          <view class="opt-sub">按全国通行的 95 折估算</view>
        </view>
        <view class="opt-switch {{etcOn ? 'on' : ''}}"><view class="opt-knob"></view></view>
      </view>
      <view class="opt-row" hover-class="opt-row-hover" hover-stay-time="80" bindtap="onToggle" data-field="holidayFree">
        <view class="opt-copy">
          <view class="opt-title-row">
            <view class="opt-title">节假日免费</view>
            <view class="help-icon" catchtap="onShowHolidayTip" aria-role="button" aria-label="节假日免费说明">!</view>
          </view>
        </view>
        <view class="opt-switch {{holidayFree ? 'on' : ''}}"><view class="opt-knob"></view></view>
      </view>
    </view>

    <view class="panel" wx:if="{{result && result.valid}}">
      <view class="section-title-row" bindtap="onToggleDetail" hover-class="opt-row-hover" hover-stay-time="80">
        <view class="section-title">明细</view>
        <text class="detail-toggle">{{detailOpen ? '收起' : '展开'}}</text>
      </view>
      <block wx:if="{{detailOpen}}">
        <view class="result-row" wx:for="{{result.rows}}" wx:key="label">
          <view class="result-row-label">{{item.label}}</view>
          <view class="result-row-value">{{item.value}}</view>
        </view>
        <view class="tool-note">{{result.hint}}</view>
      </block>
    </view>

    <view class="panel">
      <view class="oil-jump" hover-class="oil-jump-hover" hover-stay-time="80" bindtap="onGoFuel">
        <view class="oil-jump-copy">
          <view class="oil-jump-title">汽车油耗电耗</view>
          <view class="oil-jump-sub">按行程反推百公里消耗，或估花费</view>
        </view>
        <view class="oil-jump-go">去计算</view>
      </view>
      <view class="oil-jump" hover-class="oil-jump-hover" hover-stay-time="80" bindtap="onGoOilPrice">
        <view class="oil-jump-copy">
          <view class="oil-jump-title">今日油价</view>
          <view class="oil-jump-sub">各省 92 / 95 / 98 / 柴油挂牌价</view>
        </view>
        <view class="oil-jump-go">去查看</view>
      </view>
    </view>
  </scroll-view>

  <view class="tip-mask" wx:if="{{showTip}}" catchtouchmove="preventMove" catchtap="onHideTip">
    <view class="tip-dialog" catchtap="preventMove">
      <view class="tip-title">{{tipTitle}}</view>
      <view class="tip-text">{{tipText}}</view>
      <view class="tip-confirm" catchtap="onHideTip">我知道了</view>
    </view>
  </view>
</view>

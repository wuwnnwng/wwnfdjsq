<view class="page page-shell theme-{{theme}} {{themeFading ? 'is-theme-fading' : ''}}">
  <view class="panel hero-panel">
    <view class="hero-head">
      <view class="brand-wrap">
        <view class="brand">小小便民工具箱</view>
        <view class="brand-kicker">日常 · 房产 · 计算 · 换算</view>
      </view>
      <view class="theme-switch" aria-label="切换皮肤">
        <view
          wx:for="{{themeList}}"
          wx:key="id"
          class="theme-dot {{item.id}} {{theme === item.id ? 'active' : ''}}"
          data-theme="{{item.id}}"
          bindtap="onThemeChange"
          aria-role="button"
          aria-label="{{item.name}}皮肤"
        ></view>
      </view>
    </view>

    <view class="tools-entry">
      <view class="tools-swiper-wrap">
        <block wx:for="{{toolsSwiperKeys}}" wx:for-item="swiperEpoch" wx:key="*this">
          <swiper
            class="tools-swiper"
            circular
            autoplay="{{toolsSwiperAutoplay}}"
            interval="4800"
            duration="420"
            easing-function="easeOutCubic"
            bindchange="onFeaturedSwiperChange"
          >
            <swiper-item wx:for="{{featuredToolPages}}" wx:for-item="page" wx:key="key">
              <view class="tools-page">
                <block wx:for="{{page.tools}}" wx:for-item="item" wx:key="id">
                  <view wx:if="{{item.isPad}}" class="tools-chip tools-chip-pad"></view>
                  <view
                    wx:else
                    class="tools-chip"
                    bindtap="onOpenFeaturedTool"
                    data-id="{{item.id}}"
                    data-page="{{item.page}}"
                    data-appid="{{item.miniProgramAppId}}"
                    aria-role="button"
                    aria-label="{{item.name}}"
                  >
                    <view class="tools-chip-icon tool-icon-{{item.iconType}}">
                      <text class="tools-chip-emoji">{{item.icon}}</text>
                    </view>
                    <text class="tools-chip-name">{{item.shortName}}</text>
                  </view>
                </block>
              </view>
            </swiper-item>
          </swiper>
        </block>
        <view class="tools-dots" aria-hidden="true">
          <view
            wx:for="{{featuredToolPages}}"
            wx:key="key"
            class="tools-dot {{index === toolsSwiperCurrent ? 'active' : ''}}"
            style="{{index === toolsSwiperCurrent ? 'background:' + toolsIndicator : ''}}"
          ></view>
        </view>
      </view>
    </view>
  </view>

  <view class="panel search-panel">
    <view class="tool-search">
      <text class="tool-search-mark">搜</text>
      <input
        class="tool-search-input"
        value="{{keyword}}"
        placeholder="搜索工具名称"
        placeholder-class="tool-search-placeholder"
        confirm-type="search"
        bindinput="onSearch"
      />
      <view class="tool-search-clear" wx:if="{{keyword}}" bindtap="onClearSearch" aria-role="button" aria-label="清空搜索">×</view>
    </view>
  </view>

  <scroll-view scroll-y class="hub-scroll" enhanced show-scrollbar="{{false}}">
    <block wx:if="{{groups.length}}">
      <view class="panel tool-group-panel" wx:for="{{groups}}" wx:for-item="group" wx:key="id">
        <view class="tool-group-title">{{group.name}}</view>
        <view class="tool-grid">
          <view
            class="tool-card"
            wx:for="{{group.tools}}"
            wx:key="id"
            bindtap="onOpenTool"
            data-id="{{item.id}}"
            data-page="{{item.page}}"
            data-appid="{{item.miniProgramAppId}}"
          >
            <view class="tool-icon-wrap tool-icon-{{item.iconType}}">
              <text class="tool-icon">{{item.icon}}</text>
              <view
                wx:if="{{item.page || item.miniProgramAppId}}"
                class="tool-fav {{item.favorited ? 'is-on' : ''}}"
                catchtap="onToggleFavorite"
                data-id="{{item.id}}"
                hover-class="none"
                hover-stop-propagation
                aria-role="button"
                aria-label="{{item.favorited ? '取消收藏' : '收藏'}}"
              >
                <text class="tool-fav-star">★</text>
              </view>
            </view>
            <view class="tool-card-name">{{item.name}}</view>
          </view>
        </view>
      </view>
    </block>
    <view class="panel tool-empty" wx:else>
      没有找到「{{keyword}}」相关工具
    </view>
  </scroll-view>

  <add-mini-tip />
</view>

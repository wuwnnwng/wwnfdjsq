<view class="page page-shell theme-{{theme}}">
  <template name="toolCard">
    <view
      class="tool-card"
      bindtap="onOpenTool"
      data-id="{{id}}"
      data-page="{{page}}"
      data-appid="{{miniProgramAppId}}"
    >
      <view class="tool-icon-wrap tool-icon-{{iconType}}">
        <text class="tool-icon">{{icon}}</text>
        <view
          class="tool-fav {{favorited ? 'is-on' : ''}}"
          catchtap="onToggleFavorite"
          data-id="{{id}}"
          hover-class="none"
          hover-stop-propagation
          aria-role="button"
          aria-label="{{favorited ? '取消收藏' : '收藏'}}"
        >
          <text class="tool-fav-star">★</text>
        </view>
      </view>
      <view class="tool-card-name">{{name}}</view>
    </view>
  </template>
  <scroll-view scroll-y class="hub-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel tool-board {{restGroups.length ? '' : 'is-last'}}">
      <view class="tool-search">
        <text class="tool-search-mark">搜</text>
        <input
          class="tool-search-input"
          value="{{keyword}}"
          placeholder="搜索工具名称"
          placeholder-class="tool-search-placeholder"
          confirm-type="search"
          bindinput="onSearch"
        />
        <view class="tool-search-clear" wx:if="{{keyword}}" bindtap="onClearSearch" aria-role="button" aria-label="清空搜索">×</view>
      </view>
      <view class="tool-group" wx:if="{{recommendTools.length}}">
        <view class="tool-group-title">推荐</view>
        <view class="tool-grid">
          <template
            wx:for="{{recommendTools}}"
            wx:key="id"
            is="toolCard"
            data="{{id: item.id, name: item.name, icon: item.icon, iconType: item.iconType, page: item.page, miniProgramAppId: item.miniProgramAppId, favorited: item.favorited}}"
          />
        </view>
      </view>
      <view class="tool-group" wx:for="{{leadGroups}}" wx:for-item="group" wx:key="id">
        <view class="tool-group-title">{{group.name}}</view>
        <view class="tool-grid">
          <template
            wx:for="{{group.tools}}"
            wx:key="id"
            is="toolCard"
            data="{{id: item.id, name: item.name, icon: item.icon, iconType: item.iconType, page: item.page, miniProgramAppId: item.miniProgramAppId, favorited: item.favorited}}"
          />
        </view>
      </view>
      <view class="tool-empty" wx:if="{{!recommendTools.length && !leadGroups.length && !restGroups.length}}">
        没有找到「{{keyword}}」相关工具
      </view>
    </view>

    <ad-banner wx:if="{{showSplitBanner}}" theme="{{theme}}" />

    <view class="panel tool-board is-last" wx:if="{{restGroups.length}}">
      <view class="tool-group" wx:for="{{restGroups}}" wx:for-item="group" wx:key="id">
        <view class="tool-group-title">{{group.name}}</view>
        <view class="tool-grid">
          <template
            wx:for="{{group.tools}}"
            wx:key="id"
            is="toolCard"
            data="{{id: item.id, name: item.name, icon: item.icon, iconType: item.iconType, page: item.page, miniProgramAppId: item.miniProgramAppId, favorited: item.favorited}}"
          />
        </view>
      </view>
    </view>
  </scroll-view>

  <add-mini-tip />
</view>

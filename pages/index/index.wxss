.hero-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  animation: rise-in 0.55s ease both;
}

.brand {
  flex-shrink: 0;
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-brand);
  line-height: 1.2;
}

.mode-segment {
  flex: 1;
  max-width: 360rpx;
  justify-content: flex-end;
}

.panel {
  animation: rise-in 0.6s ease both;
}

.panel:nth-of-type(2) {
  animation-delay: 0.05s;
}

.panel:nth-of-type(3) {
  animation-delay: 0.1s;
}

.panel:nth-of-type(4),
.panel:nth-of-type(5) {
  animation-delay: 0.15s;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.help-icon {
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid rgba(95, 114, 104, 0.55);
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 700;
  font-style: normal;
}

.tip-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(20, 35, 28, 0.45);
}

.tip-dialog {
  width: 100%;
  max-width: 620rpx;
  max-height: 80vh;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background: #f7f8f6;
  box-shadow: 0 24rpx 60rpx rgba(11, 61, 46, 0.2);
  overflow-y: auto;
}

.tip-title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-brand);
  text-align: center;
}

.tip-summary {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

.tip-block {
  margin-top: 24rpx;
}

.tip-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.tip-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--color-muted);
}

.tip-single {
  margin-top: 24rpx;
  text-align: center;
}

.tip-confirm {
  margin-top: 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
}

.type-segment {
  margin-top: 22rpx;
}

.segment {
  margin-top: 22rpx;
}

.inline-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-line);
}

.inline-row.first {
  margin-top: 20rpx;
  padding-top: 0;
  border-top: none;
}

.inline-label-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.inline-label {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
  white-space: nowrap;
}

.segment-row {
  flex: 1;
  margin-top: 0;
  flex-wrap: nowrap;
  justify-content: flex-end;
  gap: 8rpx;
  min-width: 0;
}

.segment-row .segment-item {
  flex: 1;
  min-width: 0;
  padding: 12rpx 8rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.sub-block {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-line);
}

.sub-block.first {
  margin-top: 20rpx;
  padding-top: 0;
  border-top: none;
}

.sub-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.picker-value {
  min-width: 240rpx;
  text-align: right;
  font-size: 30rpx;
  color: var(--color-ink);
}

.picker-value.placeholder {
  color: rgba(95, 114, 104, 0.55);
}

.page-shell {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  padding-bottom: 0;
  overflow: hidden;
}

.page-shell > .hero-panel {
  flex-shrink: 0;
}

.form-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.form-scroll-spacer {
  height: 12rpx;
}

.remaining-form-panel .derived-block {
  margin-top: 12rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--color-line);
}

.derived-block .derived-row,
.derived-panel .derived-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.derived-block .derived-row:last-of-type,
.derived-panel .derived-row:last-of-type {
  border-bottom: none;
}

.derived-label {
  font-size: 28rpx;
  color: var(--color-ink);
}

.derived-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-brand-soft);
}

.derived-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

.derived-hint.warn {
  color: var(--color-accent);
}

.field-control-segment {
  flex: 1;
  min-width: 0;
  justify-content: flex-end;
}

.compact-segment {
  width: 100%;
}

.compact-segment .segment-item {
  flex: 1;
  min-width: 0;
  padding: 12rpx 10rpx;
  font-size: 22rpx;
}

.field-stack {
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
  min-height: 0;
  padding-bottom: 24rpx;
}

.field-stack .field-label {
  width: auto;
}

.segment-wrap {
  width: 100%;
  flex-wrap: wrap;
  gap: 12rpx;
}

.segment-wrap .segment-item {
  flex: 1 1 calc(50% - 6rpx);
  min-width: 240rpx;
  padding: 14rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.35;
  white-space: normal;
}

.footer-block {
  flex-shrink: 0;
  margin-top: 0;
  margin-left: -28rpx;
  margin-right: -28rpx;
  margin-bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #f3f6f4;
  box-shadow: 0 -8rpx 24rpx rgba(20, 35, 28, 0.04);
}

.disclaimer {
  margin-top: 16rpx;
  margin-bottom: 0;
  padding: 0 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.6;
  background: transparent;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 0;
  padding: 0;
  line-height: 1.2;
  text-align: center;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

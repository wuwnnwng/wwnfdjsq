.hero {
  padding: 12rpx 8rpx 8rpx;
  animation: rise-in 0.55s ease both;
}

.brand {
  font-family: var(--font-display);
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--color-brand);
  line-height: 1.2;
}

.hero-line {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.panel {
  animation: rise-in 0.6s ease both;
}

.panel:nth-of-type(2) {
  animation-delay: 0.05s;
}

.panel:nth-of-type(3) {
  animation-delay: 0.1s;
}

.panel:nth-of-type(4),
.panel:nth-of-type(5) {
  animation-delay: 0.15s;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.help-icon {
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid rgba(95, 114, 104, 0.55);
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 700;
  font-style: normal;
}

.tip-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(20, 35, 28, 0.45);
}

.tip-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background: #f7f8f6;
  box-shadow: 0 24rpx 60rpx rgba(11, 61, 46, 0.2);
}

.tip-title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-brand);
  text-align: center;
}

.tip-block {
  margin-top: 24rpx;
}

.tip-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.tip-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--color-muted);
}

.tip-confirm {
  margin-top: 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
}

.type-segment {
  margin-top: 22rpx;
}

.segment {
  margin-top: 22rpx;
}

.disclaimer {
  margin-top: 28rpx;
  padding: 0 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.primary-btn {
  animation: pulse-soft 2.4s ease-in-out infinite;
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse-soft {
  0%,
  100% {
    transform: translateY(0);
    box-shadow: 0 16rpx 36rpx rgba(11, 61, 46, 0.22);
  }
  50% {
    transform: translateY(-2rpx);
    box-shadow: 0 20rpx 40rpx rgba(11, 61, 46, 0.28);
  }
}

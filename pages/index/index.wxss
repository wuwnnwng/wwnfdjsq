.hero-panel {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.hero-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.brand-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.brand {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-brand);
  line-height: 1.2;
  transition: color 0.32s ease;
}

.brand-kicker {
  font-size: 22rpx;
  color: var(--color-muted);
  letter-spacing: 1rpx;
}

.theme-switch {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
  max-width: 280rpx;
}

.theme-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 0 0 1rpx var(--color-line);
  transition: box-shadow 0.32s ease, background 0.32s ease;
}

.theme-dot.active {
  box-shadow: 0 0 0 3rpx var(--color-brand-soft);
}

.theme-dot.nexus {
  background: linear-gradient(135deg, #22d3ee, #a78bfa);
}

.theme-dot.forest {
  background: linear-gradient(135deg, #0b3d2e, #1f6b52);
}

.theme-dot.ocean {
  background: linear-gradient(135deg, #1a3f66, #3a73a6);
}

.theme-dot.amber {
  background: linear-gradient(135deg, #6e4a22, #a67c38);
}

.theme-dot.crimson {
  background: linear-gradient(135deg, #6b1e28, #b3384a);
}

.tools-entry {
  padding: 12rpx 0 4rpx;
}

.tools-swiper-wrap {
  position: relative;
  height: 168rpx;
}

.tools-swiper {
  height: 168rpx;
}

.tools-page {
  display: flex;
  align-items: flex-start;
  height: 136rpx;
}

.tools-chip {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 0;
}

.tools-chip:active {
  opacity: 0.82;
  transform: scale(0.96);
}

.tools-chip-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.12);
}

.tools-chip-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.tools-chip-name {
  max-width: 100%;
  padding: 0 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-ink);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tools-chip-pad {
  pointer-events: none;
}

.tools-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 2rpx;
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  pointer-events: none;
}

.tools-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-line);
}

.search-panel {
  flex-shrink: 0;
  margin-top: 0;
  margin-bottom: 16rpx;
  padding: 16rpx 22rpx;
}

.tool-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 80rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.tool-search-mark {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.tool-search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-size: 30rpx;
  color: var(--color-ink);
}

.tool-search-placeholder {
  color: var(--color-muted);
}

.tool-search-clear {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 32rpx;
  color: #fff;
  background: rgba(95, 114, 104, 0.45);
}

.page-shell {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.hub-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.tool-group-panel {
  margin-top: 0;
  margin-bottom: 16rpx;
  padding: 24rpx 20rpx 28rpx;
}

.tool-group-panel:last-child {
  margin-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.tool-group-title {
  margin: 0 8rpx 20rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-brand);
  letter-spacing: 1rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx 16rpx;
}

.tool-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 208rpx;
  padding: 26rpx 10rpx 22rpx;
  border-radius: 28rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  box-shadow: 0 10rpx 28rpx var(--color-shadow), 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.tool-card:active {
  transform: scale(0.97);
  opacity: 0.96;
}

.tool-icon-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.12);
}

.tool-fav {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  z-index: 2;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.16);
}

.tool-fav:active {
  transform: scale(0.92);
}

.tool-fav-star {
  font-size: 24rpx;
  line-height: 1;
  color: var(--color-muted);
  opacity: 0.72;
}

.tool-fav.is-on {
  border-color: rgba(245, 185, 66, 0.55);
  background: rgba(245, 185, 66, 0.16);
}

.tool-fav.is-on .tool-fav-star {
  color: #f5b942;
  opacity: 1;
}

.tool-icon {
  font-size: 44rpx;
  line-height: 1;
}

.tool-card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-ink);
  text-align: center;
  line-height: 1.35;
}

.tool-empty {
  margin-top: 0;
  padding: 48rpx 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-muted);
  line-height: 1.6;
}


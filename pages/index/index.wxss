.tool-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 72rpx;
  margin: -4rpx 4rpx 8rpx;
  padding: 0 4rpx 18rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.tool-search-mark {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.tool-search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-size: 30rpx;
  color: var(--color-ink);
}

.tool-search-placeholder {
  color: var(--color-muted);
}

.tool-search-clear {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 32rpx;
  color: #fff;
  background: rgba(95, 114, 104, 0.45);
}

page {
  height: 100%;
}

.page.page-shell {
  min-height: 0;
  height: 100%;
  padding: 32rpx 28rpx 0;
}

.page-shell {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  padding-bottom: 0;
  overflow: hidden;
}

.hub-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.tool-board {
  margin-top: 0;
  margin-bottom: 0;
  padding: 24rpx 20rpx 28rpx;
}

.tool-board.is-last {
  margin-bottom: 16rpx;
}

.tool-search + .tool-group,
.tool-group + .tool-group {
  margin-top: 28rpx;
}

.tool-group-title {
  margin: 0 8rpx 20rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-brand);
  letter-spacing: 1rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx 16rpx;
}

.tool-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 208rpx;
  padding: 26rpx 10rpx 22rpx;
  border-radius: 28rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  box-shadow: 0 10rpx 28rpx var(--color-shadow), 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.tool-card:active {
  transform: scale(0.97);
  opacity: 0.96;
}

.tool-icon-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.12);
}

.tool-icon {
  font-size: 44rpx;
  line-height: 1;
}

.tool-fav {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  z-index: 2;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.16);
}

.tool-fav-star {
  font-size: 22rpx;
  line-height: 1;
  color: var(--color-muted);
  opacity: 0.72;
}

.tool-fav.is-on {
  border-color: rgba(245, 185, 66, 0.55);
  background: rgba(245, 185, 66, 0.16);
}

.tool-fav.is-on .tool-fav-star {
  color: #f5b942;
  opacity: 1;
}

.tool-card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-ink);
  text-align: center;
  line-height: 1.35;
}

.tool-empty {
  margin-top: 0;
  padding: 48rpx 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-muted);
  line-height: 1.6;
}


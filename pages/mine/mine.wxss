page {
  height: 100%;
}

.page {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  min-height: 0;
  height: 100%;
  padding: 0;
  background:
    radial-gradient(120% 80% at 0% 0%, var(--bg-glow-1), transparent 55%),
    radial-gradient(90% 70% at 100% 10%, var(--bg-glow-2), transparent 50%),
    linear-gradient(180deg, var(--bg-grad-1) 0%, var(--bg-grad-2) 42%, var(--bg-grad-3) 100%);
}

.scroll {
  height: 100%;
  padding: 24rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.profile {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-panel-border);
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #fff;
  flex-shrink: 0;
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-brand);
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-ink);
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.chevron {
  color: var(--color-muted);
  font-size: 40rpx;
  line-height: 1;
}

.menu {
  margin-top: 24rpx;
  padding: 8rpx 8rpx;
  border-radius: 28rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
}

.row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 104rpx;
  padding: 0 20rpx;
  background: transparent;
}

.row.button {
  width: 100%;
  margin: 0;
  border: none;
  border-radius: 0;
  line-height: normal;
  text-align: left;
  font-size: 30rpx;
  background: transparent;
}

.row.button::after {
  border: none;
}

.mark {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.mark.skin { background: var(--color-brand); }
.mark.coin { background: #f59e0b; }
.mark.service { background: #60a5fa; }
.mark.bell { background: #38bdf8; }
.mark.users { background: var(--color-brand-soft); }
.mark.out { background: #fda4af; }

.row-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-ink);
}

.row-name.danger {
  color: #ef4444;
}

.row-extra {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-accent);
}

.ad-note {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-muted);
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.45);
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--color-dialog);
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-ink);
}

.avatar-pick {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 0;
  padding: 0;
  background: transparent;
  color: var(--color-ink);
  font-size: 28rpx;
  line-height: normal;
}

.avatar-pick::after {
  border: none;
}

.nick-input {
  margin-top: 24rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--color-soft);
  color: var(--color-ink);
  font-size: 30rpx;
}

.nick-placeholder {
  color: var(--color-muted);
}

.nick-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.theme-switch {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.theme-dot {
  width: 52rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-dot-core {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 0 0 1rpx var(--color-line);
}

.theme-dot.active .theme-dot-core {
  width: 40rpx;
  height: 40rpx;
  box-shadow: 0 0 0 4rpx var(--color-brand-soft);
}

.theme-dot-core.nexus { background: linear-gradient(135deg, #22d3ee, #a78bfa); }
.theme-dot-core.forest { background: linear-gradient(135deg, #0b3d2e, #1f6b52); }
.theme-dot-core.ocean { background: linear-gradient(135deg, #1a3f66, #3a73a6); }
.theme-dot-core.amber { background: linear-gradient(135deg, #6e4a22, #a67c38); }
.theme-dot-core.crimson { background: linear-gradient(135deg, #6b1e28, #b3384a); }

.save {
  margin-top: 28rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--color-brand);
  color: var(--color-on-brand);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

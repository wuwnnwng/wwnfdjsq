<view class="page">
  <view class="create" bindtap="onCreate">发布新通知</view>
  <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onEdit">
    <view class="card-head">
      <text class="card-title">{{item.title}}</text>
      <text class="card-flag {{item.published ? 'on' : ''}}">{{item.published ? '已发布' : '未发布'}}</text>
    </view>
    <view class="card-text">{{item.body}}</view>
  </view>
  <view class="empty" wx:if="{{!list.length}}">还没有通知，点上面发布</view>

  <view class="mask" wx:if="{{editing}}" bindtap="onClose" catchtouchmove="onHold">
    <view class="sheet" catchtap="onHold">
      <view class="sheet-title">{{id ? '修改通知' : '发布通知'}}</view>
      <input class="field" value="{{title}}" placeholder="标题" bindinput="onTitle" />
      <textarea class="area" value="{{body}}" placeholder="内容" maxlength="1000" bindinput="onBody" />
      <view class="switch-row">
        <text>对外显示</text>
        <switch checked="{{published}}" color="#3b82f6" bindchange="onPublished" />
      </view>
      <view class="save" bindtap="onSave">保存</view>
      <view class="remove" wx:if="{{id}}" bindtap="onRemove">删除</view>
    </view>
  </view>
</view>

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
  background: #f5f7fb;
}

.create {
  height: 88rpx;
  border-radius: 44rpx;
  background: #3b82f6;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
}

.card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.card-flag {
  font-size: 22rpx;
  color: #94a3b8;
}

.card-flag.on {
  color: #2563eb;
}

.card-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #64748b;
  white-space: pre-wrap;
}

.empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.45);
}

.sheet {
  width: 100%;
  max-height: 86vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.field,
.area {
  width: 100%;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f8fafc;
  font-size: 28rpx;
}

.area {
  height: 240rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #334155;
}

.save,
.remove {
  margin-top: 24rpx;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.save {
  background: #3b82f6;
  color: #fff;
}

.remove {
  background: #fee2e2;
  color: #ef4444;
}

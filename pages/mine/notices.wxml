<view class="page theme-{{theme}}">
  <view class="bar">
    <view class="pill read" bindtap="onReadAll">
      <text class="check">✓</text>
      <text>全部已读</text>
    </view>
    <view class="pill clear" wx:if="{{canManage}}" bindtap="onDelete">删除消息</view>
    <view class="pill clear" wx:else bindtap="onClear">清除消息</view>
  </view>

  <scroll-view wx:if="{{list.length}}" class="list" scroll-y show-scrollbar="{{false}}">
    <view class="card {{item.unread ? 'unread' : ''}}" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
      <view class="card-head">
        <view class="dot" wx:if="{{item.unread}}"></view>
        <view class="card-title">{{item.title}}</view>
      </view>
      <view class="card-time" wx:if="{{item.time}}">{{item.time}}</view>
      <view class="card-text">{{item.body}}</view>
    </view>
    <view class="manage" wx:if="{{canManage}}" bindtap="onManage">发布和修改通知</view>
  </scroll-view>

  <view wx:else class="empty">
    <view class="bell">
      <view class="bell-cap"></view>
      <view class="bell-body"></view>
      <view class="bell-lip"></view>
      <view class="bell-clapper"></view>
    </view>
    <view class="empty-title">暂无通知</view>
    <view class="empty-sub">新消息会显示在这里</view>
    <view class="manage" wx:if="{{canManage}}" bindtap="onManage">发布和修改通知</view>
  </view>
</view>

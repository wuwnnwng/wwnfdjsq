.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
  background: #f5f7fb;
}

.balance {
  padding: 48rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #eef2ff, #fff);
  text-align: center;
}

.balance-num {
  font-size: 80rpx;
  font-weight: 800;
  color: #1e293b;
  line-height: 1;
}

.balance-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #64748b;
}

.balance-until {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #2563eb;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
}

.card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.card-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #64748b;
}

.progress {
  margin-top: 24rpx;
}

.progress-track {
  height: 16rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #60a5fa, #3b82f6);
}

.progress-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

.redeem {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #3b82f6;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.redeem.off {
  background: #e2e8f0;
  color: #64748b;
}

.task {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.task-copy {
  flex: 1;
  min-width: 0;
}

.task-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.task-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #94a3b8;
}

.task-btn {
  flex-shrink: 0;
  min-width: 132rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 32rpx;
  background: #3b82f6;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.task-btn.done {
  background: #e2e8f0;
  color: #64748b;
}

.task-btn.share {
  margin: 0;
  line-height: 64rpx;
}

.task-btn.share::after {
  border: none;
}

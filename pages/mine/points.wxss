.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(120% 80% at 0% 0%, var(--bg-glow-1), transparent 55%),
    radial-gradient(90% 70% at 100% 10%, var(--bg-glow-2), transparent 50%),
    linear-gradient(180deg, var(--bg-grad-1) 0%, var(--bg-grad-2) 42%, var(--bg-grad-3) 100%);
}

.balance {
  padding: 48rpx 28rpx;
  border-radius: 28rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-panel-border);
  text-align: center;
}

.balance-num {
  font-size: 80rpx;
  font-weight: 800;
  color: var(--color-ink);
  line-height: 1;
}

.balance-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-muted);
}

.balance-until {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-brand);
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
}

.card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-ink);
}

.card-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-muted);
}

.progress {
  margin-top: 24rpx;
}

.progress-track {
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--color-soft);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--color-brand-soft), var(--color-brand));
}

.progress-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.redeem {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--color-brand);
  color: var(--color-on-brand);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.redeem.off {
  background: var(--color-soft);
  color: var(--color-muted);
}

.task {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.task-copy {
  flex: 1;
  min-width: 0;
}

.task-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.task-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--color-muted);
}

.task-btn {
  flex-shrink: 0;
  min-width: 132rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 32rpx;
  background: var(--color-brand);
  color: var(--color-on-brand);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.task-btn.done {
  background: var(--color-soft);
  color: var(--color-muted);
}

.task-btn.share {
  margin: 0;
  line-height: 64rpx;
}

.task-btn.share::after {
  border: none;
}

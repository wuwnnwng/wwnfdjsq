.page {
  min-height: 100vh;
  padding: 48rpx 28rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(120% 80% at 0% 0%, var(--bg-glow-1), transparent 55%),
    radial-gradient(90% 70% at 100% 10%, var(--bg-glow-2), transparent 50%),
    linear-gradient(180deg, var(--bg-grad-1) 0%, var(--bg-grad-2) 42%, var(--bg-grad-3) 100%);
}

.avatar-pick {
  display: block;
  width: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  line-height: normal;
  text-align: center;
  font-weight: 400;
}

.avatar-pick::after {
  border: none;
}

.preview {
  display: flex;
  justify-content: center;
}

.avatar-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.avatar-sub {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-muted);
}

.avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: var(--color-card);
}

.avatar-guest {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f6fa;
}

.avatar-watermark {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: rgba(26, 63, 102, 0.28);
}

.card {
  margin-top: 36rpx;
  padding: 8rpx 28rpx;
  border-radius: 28rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
}

.label {
  padding-top: 24rpx;
  font-size: 26rpx;
  color: var(--color-muted);
}

.nick-wrap {
  position: relative;
}

.nick-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  line-height: normal;
}

.nick-mask::after {
  border: none;
}

.nick-input {
  height: 88rpx;
  margin-top: 8rpx;
  font-size: 32rpx;
  color: var(--color-ink);
}

.nick-placeholder {
  color: var(--color-muted);
}

.hint {
  padding-bottom: 24rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.save {
  margin-top: 40rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--color-brand);
  color: var(--color-on-brand);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

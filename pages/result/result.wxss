.summary-hero {
  padding: 20rpx 8rpx 8rpx;
  animation: fade-up 0.5s ease both;
}

.summary-label {
  font-size: 24rpx;
  color: var(--color-muted);
  letter-spacing: 1rpx;
}

.summary-main {
  margin-top: 10rpx;
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
}

.summary-number {
  font-family: var(--font-display);
  font-size: 72rpx;
  font-weight: 700;
  color: var(--color-brand);
  line-height: 1;
}

.summary-unit {
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: var(--color-muted);
}

.summary-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 16rpx;
  animation: fade-up 0.55s ease both;
  animation-delay: 0.05s;
}

.metric {
  width: calc(50% - 8rpx);
}

.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-ink);
  word-break: break-all;
}

.metric-value.accent {
  color: var(--color-accent);
}

.metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.chart-panel {
  animation: fade-up 0.6s ease both;
  animation-delay: 0.1s;
}

.pie-canvas {
  display: block;
  width: 100%;
  height: 460rpx;
  margin-top: 12rpx;
}

.split-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line);
  font-size: 28rpx;
}

.split-row:last-child {
  border-bottom: none;
}

.split-value-wrap {
  max-width: 58%;
  text-align: right;
  line-height: 1.4;
}

.early-hint {
  margin-top: 16rpx;
}

.schedule-panel {
  animation: fade-up 0.65s ease both;
  animation-delay: 0.15s;
}

.schedule-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.toggle {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  font-size: 24rpx;
  color: var(--color-brand-soft);
  border: 1rpx solid rgba(31, 107, 82, 0.28);
  border-radius: 999rpx;
}

.table-head,
.table-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.table-head {
  margin-top: 22rpx;
  padding: 12rpx 0;
  font-size: 22rpx;
  color: var(--color-muted);
  border-bottom: 1rpx solid var(--color-line);
}

.table-body {
  max-height: 640rpx;
}

.table-row {
  padding: 16rpx 0;
  font-size: 22rpx;
  color: var(--color-ink);
  border-bottom: 1rpx solid rgba(20, 35, 28, 0.06);
}

.col {
  flex: 1;
  text-align: right;
  min-width: 0;
}

.col.month {
  flex: 0 0 72rpx;
  text-align: left;
  color: var(--color-muted);
}

.interest-text {
  color: var(--color-accent);
}

.interest-text.clickable {
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.tip-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: var(--color-mask);
}

.tip-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background: var(--color-dialog);
  box-shadow: 0 24rpx 60rpx var(--color-shadow-strong);
}

.tip-title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-brand);
  text-align: center;
}

.tip-block {
  margin-top: 24rpx;
}

.tip-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.tip-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--color-muted);
}

.tip-confirm {
  margin-top: 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
}

.empty {
  min-height: 100vh;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty .primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1.2;
  text-align: center;
}

.empty-text {
  margin-bottom: 40rpx;
  font-size: 30rpx;
  color: var(--color-muted);
}

@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

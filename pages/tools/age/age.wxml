<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-age">
            <text class="tool-icon">🎂</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">周岁 · 虚岁 · 天数</view>
            <view class="conv-title">年龄</view>
          </view>
        </view>
      </view>
      <block wx:if="{{result && result.valid}}">
        <view class="conv-stats">
          <view class="conv-stat">
            <view class="conv-eq">周岁</view>
            <view class="conv-result">{{result.yearText}}</view>
          </view>
          <view class="conv-stat">
            <view class="conv-eq">已活天数</view>
            <view class="conv-result">{{result.livedDaysText}}<text class="conv-result-suffix">天</text></view>
          </view>
        </view>
        <view class="conv-result-unit">{{result.detailText}}</view>
      </block>
      <view class="tool-note warn" wx:elif="{{result && !result.valid}}">{{result.message}}</view>
    </view>

    <view class="panel">
      <view class="seg-row">
        <view
          class="seg-item {{birthCalendar === 'solar' ? 'active' : ''}}"
          bindtap="onSwitchBirthCalendar"
          data-cal="solar"
        >
          公历
        </view>
        <view
          class="seg-item {{birthCalendar === 'lunar' ? 'active' : ''}}"
          bindtap="onSwitchBirthCalendar"
          data-cal="lunar"
        >
          农历
        </view>
      </view>
      <view class="field">
        <text class="field-label">出生日期</text>
        <view class="field-control">
          <picker
            wx:if="{{birthCalendar === 'solar'}}"
            mode="date"
            value="{{birthday}}"
            start="1900-01-01"
            end="{{today}}"
            bindchange="onBirthdayChange"
          >
            <view class="picker-value">{{birthdayDisplay}}</view>
          </picker>
          <view wx:else class="picker-value" bindtap="onOpenLunarPicker">{{lunarBirthdayText}}</view>
        </view>
      </view>
      <view class="tool-note" wx:if="{{birthCalendar === 'lunar' && result && result.valid}}">
        对应公历 {{result.birthdayText}}
      </view>
      <view class="field">
        <text class="field-label">计算到</text>
        <view class="field-control">
          <picker mode="date" value="{{asOf}}" start="{{birthday}}" end="2100-12-31" bindchange="onAsOfChange">
            <view class="picker-value">{{asOf}}</view>
          </picker>
        </view>
      </view>
    </view>

    <view class="panel" wx:if="{{result && result.valid}}">
      <view class="section-title">生日与年龄</view>
      <view class="result-row">
        <view class="result-row-label">公历生日</view>
        <view class="result-row-value">{{result.birthdayText}} · {{result.birthdayWeek}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">农历生日</view>
        <view class="result-row-value">{{result.birthdayLunar}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">生肖 / 星座</view>
        <view class="result-row-value">{{result.zodiac}} · {{result.constellation}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">周岁</view>
        <view class="result-row-value">{{result.detailText}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">虚岁</view>
        <view class="result-row-value">{{result.nominalText}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">已活天数</view>
        <view class="result-row-value">{{result.livedDaysText}} 天</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">人生第几天</view>
        <view class="result-row-value">第 {{result.lifeDayNumber}} 天</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">下次生日</view>
        <view class="result-row-value">{{result.nextBirthdayText}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">距下次生日</view>
        <view class="result-row-value">{{result.nextDaysText}}</view>
      </view>
      <view class="tool-note">
        周岁按公历满一周年计算。选择农历时，下次生日按农历生日换算。虚岁出生为 1 岁，每过一个春节加 1 岁。已活天数为出生日到计算日的间隔天数，出生日当天为 0 天。
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{showLivedPopup}}" class="lived-mask" catchtap="onCloseLivedPopup" catchtouchmove="preventMove">
    <view class="lived-confetti">
      <view
        wx:for="{{confettiPieces}}"
        wx:key="id"
        class="lived-piece lived-piece-{{item.kind}} lived-{{item.mode}}-{{item.fall}}"
        style="left: {{item.left}}%; top: {{item.top}}; animation-delay: {{item.delay}}s; animation-duration: {{item.duration}}s; background: {{item.color}}; width: {{item.size}}rpx; height: {{item.height}}rpx;"
      >
        <text wx:if="{{item.emoji}}" class="lived-emoji" style="font-size: {{item.size}}rpx;">{{item.emoji}}</text>
      </view>
    </view>
    <view class="lived-dialog" catchtap="onLivedDialogTap">
      <view class="lived-kicker">🎂</view>
      <view class="lived-title">已经活了</view>
      <view class="lived-days">{{result.livedDaysText}}</view>
      <view class="lived-unit">天</view>
      <view class="lived-sub" wx:if="{{result}}">周岁 {{result.yearText}} · 人生第 {{result.lifeDayNumberText}} 天</view>
      <view class="lived-confirm" catchtap="onCloseLivedPopup">知道了</view>
    </view>
  </view>

  <view wx:if="{{showLunarPicker}}" class="date-picker-mask" catchtap="onCancelLunarPicker" catchtouchmove="preventMove">
    <view class="date-picker-sheet" catchtap="onLunarPickerSheetTap">
      <view class="date-picker-head">
        <view class="date-picker-action" catchtap="onCancelLunarPicker">取消</view>
        <view class="date-picker-title">选择农历生日</view>
        <view class="date-picker-action confirm" catchtap="onConfirmLunarPicker">确定</view>
      </view>
      <picker-view
        class="date-picker-view"
        value="{{lunarPickerValue}}"
        immediate-change="{{true}}"
        bindchange="onLunarPickerChange"
        indicator-style="height: 72rpx;"
        indicator-class="date-picker-indicator"
      >
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{lunarYears}}" wx:key="*this">{{item}}年</view>
        </picker-view-column>
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{lunarMonths}}" wx:key="label">{{item.label}}</view>
        </picker-view-column>
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{lunarDays}}" wx:key="*this">{{item}}</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>
</view>

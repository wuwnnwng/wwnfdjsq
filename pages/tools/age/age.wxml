<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-age">
            <text class="tool-icon">🎂</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">周岁 · 虚岁 · 天数</view>
            <view class="conv-title">年龄</view>
          </view>
        </view>
      </view>
      <block wx:if="{{result && result.valid}}">
        <view class="conv-eq">周岁</view>
        <view class="conv-result">{{result.yearText}}</view>
        <view class="conv-result-unit">{{result.detailText}}</view>
      </block>
      <view class="tool-note warn" wx:elif="{{result && !result.valid}}">{{result.message}}</view>
    </view>

    <view class="panel">
      <view class="field">
        <text class="field-label">出生日期</text>
        <view class="field-control">
          <picker mode="date" value="{{birthday}}" start="1900-01-01" end="{{today}}" bindchange="onBirthdayChange">
            <view class="picker-value">{{birthday}}</view>
          </picker>
        </view>
      </view>
      <view class="field">
        <text class="field-label">计算到</text>
        <view class="field-control">
          <picker mode="date" value="{{asOf}}" start="{{birthday}}" end="2100-12-31" bindchange="onAsOfChange">
            <view class="picker-value">{{asOf}}</view>
          </picker>
        </view>
      </view>
    </view>

    <view class="panel" wx:if="{{result && result.valid}}">
      <view class="section-title">生日与年龄</view>
      <view class="result-row">
        <view class="result-row-label">公历生日</view>
        <view class="result-row-value">{{result.birthdayText}} · {{result.birthdayWeek}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">农历生日</view>
        <view class="result-row-value">{{result.birthdayLunar}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">生肖 / 星座</view>
        <view class="result-row-value">{{result.zodiac}} · {{result.constellation}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">周岁</view>
        <view class="result-row-value">{{result.detailText}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">虚岁</view>
        <view class="result-row-value">{{result.nominalText}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">已活天数</view>
        <view class="result-row-value">{{result.livedDaysText}} 天</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">人生第几天</view>
        <view class="result-row-value">第 {{result.lifeDayNumber}} 天</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">下次生日</view>
        <view class="result-row-value">{{result.nextBirthdayText}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">距下次生日</view>
        <view class="result-row-value">{{result.nextDaysText}}</view>
      </view>
      <view class="tool-note">周岁按公历生日计算；虚岁出生为 1 岁，每过一个春节加 1 岁。已活天数为出生日到计算日的间隔天数，出生日当天为 0 天。</view>
    </view>
  </scroll-view>
</view>

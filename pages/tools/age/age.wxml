<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll {{result && result.valid ? 'has-save-bar' : ''}}" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="age-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-age">
            <text class="tool-icon">🎂</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">周岁 · 星座 · 生日</view>
            <view class="conv-title">年龄</view>
          </view>
        </view>
        <view class="age-cal-seg">
          <view
            class="age-cal-item {{birthCalendar === 'solar' ? 'active' : ''}}"
            bindtap="onSwitchBirthCalendar"
            data-cal="solar"
          >
            公历
          </view>
          <view
            class="age-cal-item {{birthCalendar === 'lunar' ? 'active' : ''}}"
            bindtap="onSwitchBirthCalendar"
            data-cal="lunar"
          >
            农历
          </view>
        </view>
      </view>

      <view class="age-pick-row" bindtap="onOpenBirthPicker">
        <text class="age-pick-label">生日</text>
        <view class="age-pick-value">
          <text>{{birthCalendar === 'solar' ? birthdayDisplay : lunarBirthdayText}}</text>
          <text class="age-pick-caret">›</text>
        </view>
      </view>
      <view class="age-pick-hint" wx:if="{{birthCalendar === 'lunar' && result && result.valid}}">对应公历 {{result.birthdayText}}</view>
      <view class="age-pick-row" bindtap="onOpenAsOfPicker">
        <text class="age-pick-label">算到</text>
        <view class="age-pick-value">
          <text>{{asOfDisplay}}</text>
          <text class="age-pick-caret">›</text>
        </view>
      </view>

      <block wx:if="{{result && result.valid}}">
        <view class="age-hero-num">{{result.yearAge}}</view>
        <view class="age-hero-unit">周岁 · {{result.detailText}}</view>
        <view class="age-chips">
          <view class="age-chip">{{result.constellationSymbol}} {{result.constellation}}</view>
          <view class="age-chip">属{{result.zodiac}}</view>
        </view>
        <view class="age-next">{{result.nextHeroText}}</view>
      </block>
      <view class="tool-note warn" wx:elif="{{result && !result.valid}}">{{result.message}}</view>
    </view>

    <view class="panel" wx:if="{{result && result.valid}}">
      <view class="age-glance">
        <view class="age-glance-item">
          <view class="age-glance-label">虚岁</view>
          <view class="age-glance-value">{{result.nominalText}}</view>
        </view>
        <view class="age-glance-item">
          <view class="age-glance-label">已活</view>
          <view class="age-glance-value">{{result.livedDaysText}}<text class="age-glance-unit">天</text></view>
        </view>
        <view class="age-glance-item">
          <view class="age-glance-label">农历生日</view>
          <view class="age-glance-value age-glance-value-sm">{{result.birthdayLunar}}</view>
        </view>
        <view class="age-glance-item">
          <view class="age-glance-label">人生第</view>
          <view class="age-glance-value">{{result.lifeDayNumberText}}<text class="age-glance-unit">天</text></view>
        </view>
      </view>
      <view class="life-progress life-progress-panel">
        <view class="life-progress-head">
          <text class="life-progress-label">生命进度</text>
          <text class="life-progress-value">{{result.lifeProgressText}}</text>
        </view>
        <view class="life-bar">
          <view class="life-bar-fill" style="width: {{result.lifeProgressBar}}%;"></view>
        </view>
        <view class="tool-note">按人均寿命 {{result.averageLifeYears}} 岁做趣味对照，不代表个人寿命。</view>
      </view>
    </view>

    <view class="panel match-panel" wx:if="{{result && result.valid && result.loveMatches && result.loveMatches.length}}">
      <view class="match-head">
        <view class="section-title">适合谈恋爱</view>
        <view class="match-sub">按 {{result.constellation}} 常见配对，看对方生日落在哪几天</view>
      </view>
      <view class="match-card" wx:for="{{result.loveMatches}}" wx:key="name">
        <view class="match-card-top">
          <text class="match-symbol">{{item.symbol}}</text>
          <view class="match-card-copy">
            <view class="match-name">{{item.name}}</view>
            <view class="match-range">{{item.rangeText}}</view>
          </view>
        </view>
        <view class="match-hint">{{item.hint}}</view>
      </view>
    </view>

    <view class="panel match-panel" wx:if="{{result && result.valid && result.friendMatches && result.friendMatches.length}}">
      <view class="match-head">
        <view class="section-title">适合交心</view>
        <view class="match-sub">更适合深聊、托付心事的生日区间</view>
      </view>
      <view class="match-card friend" wx:for="{{result.friendMatches}}" wx:key="name">
        <view class="match-card-top">
          <text class="match-symbol">{{item.symbol}}</text>
          <view class="match-card-copy">
            <view class="match-name">{{item.name}}</view>
            <view class="match-range">{{item.rangeText}}</view>
          </view>
        </view>
        <view class="match-hint">{{item.hint}}</view>
      </view>
      <view class="tool-note">星座配对只是流行说法，交朋友和恋爱请以相处为准。</view>
    </view>

    <view class="save-bar-spacer" wx:if="{{result && result.valid}}"></view>
  </scroll-view>

  <view class="save-card-bar" wx:if="{{result && result.valid}}">
    <view class="primary-btn save-card-btn" bindtap="onSaveCard">{{savingCard ? '正在保存…' : '生成卡片保存到相册'}}</view>
  </view>

  <view wx:if="{{showLivedPopup}}" class="confetti-mask" catchtap="onCloseLivedPopup" catchtouchmove="preventMove">
    <view class="confetti-layer">
      <view
        wx:for="{{confettiPieces}}"
        wx:key="id"
        class="confetti-piece confetti-piece-{{item.kind}} confetti-{{item.mode}}-{{item.fall}}"
        style="left: {{item.left}}%; top: {{item.top}}; animation-delay: {{item.delay}}s; animation-duration: {{item.duration}}s; background: {{item.color}}; width: {{item.size}}rpx; height: {{item.height}}rpx;"
      >
        <text wx:if="{{item.emoji}}" class="confetti-emoji" style="font-size: {{item.size}}rpx;">{{item.emoji}}</text>
      </view>
    </view>
    <view class="lived-dialog" catchtap="onLivedDialogTap">
      <view class="lived-kicker">🎂</view>
      <view class="lived-title">已经活了</view>
      <view class="lived-days">{{result.livedDaysText}}</view>
      <view class="lived-unit">天</view>
      <view class="lived-sub" wx:if="{{result}}">周岁 {{result.yearText}} · 人生第 {{result.lifeDayNumberText}} 天</view>
      <view class="life-progress" wx:if="{{result}}">
        <view class="life-progress-head">
          <text class="life-progress-label">生命进度</text>
          <text class="life-progress-value">{{result.lifeProgressText}}</text>
        </view>
        <view class="life-bar">
          <view class="life-bar-fill" style="width: {{result.lifeProgressBar}}%;"></view>
        </view>
        <view class="life-progress-hint">{{result.lifeProgressHint}}</view>
      </view>
      <view class="lived-confirm" catchtap="onCloseLivedPopup">知道了</view>
    </view>
  </view>

  <view wx:if="{{showSolarPicker}}" class="date-picker-mask" catchtap="onCancelSolarPicker" catchtouchmove="preventMove">
    <view class="date-picker-sheet" catchtap="onSolarPickerSheetTap">
      <view class="date-picker-head">
        <view class="date-picker-action" catchtap="onCancelSolarPicker">取消</view>
        <view class="date-picker-title">{{solarPickerTitle}}</view>
        <view class="date-picker-action confirm" catchtap="onConfirmSolarPicker">确定</view>
      </view>
      <picker-view
        class="date-picker-view"
        value="{{solarPickerValue}}"
        immediate-change="{{true}}"
        bindchange="onSolarPickerChange"
        indicator-style="height: 72rpx;"
        indicator-class="date-picker-indicator"
      >
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{solarYears}}" wx:key="*this">{{item}}年</view>
        </picker-view-column>
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{solarMonths}}" wx:key="*this">{{item}}月</view>
        </picker-view-column>
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{solarDays}}" wx:key="*this">{{item}}日</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>

  <view wx:if="{{showLunarPicker}}" class="date-picker-mask" catchtap="onCancelLunarPicker" catchtouchmove="preventMove">
    <view class="date-picker-sheet" catchtap="onLunarPickerSheetTap">
      <view class="date-picker-head">
        <view class="date-picker-action" catchtap="onCancelLunarPicker">取消</view>
        <view class="date-picker-title">选择农历生日</view>
        <view class="date-picker-action confirm" catchtap="onConfirmLunarPicker">确定</view>
      </view>
      <picker-view
        class="date-picker-view"
        value="{{lunarPickerValue}}"
        immediate-change="{{true}}"
        bindchange="onLunarPickerChange"
        indicator-style="height: 72rpx;"
        indicator-class="date-picker-indicator"
      >
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{lunarYears}}" wx:key="*this">{{item}}年</view>
        </picker-view-column>
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{lunarMonths}}" wx:key="label">{{item.label}}</view>
        </picker-view-column>
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{lunarDays}}" wx:key="*this">{{item}}</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>
  <canvas type="2d" id="resultCard" class="result-card-canvas"></canvas>
</view>

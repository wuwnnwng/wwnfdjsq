@import "../tool-common.wxss";
@import "../calc-kit.wxss";
@import "../../confetti.wxss";

.conv-hero {
  background:
    linear-gradient(160deg, var(--bg-glow-1) 0%, rgba(255, 255, 255, 0.55) 58%),
    var(--color-surface);
}

.tool-icon-age {
  background: linear-gradient(135deg, #fce7f3, #f472b6);
}

.age-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.age-cal-seg {
  flex-shrink: 0;
  display: flex;
  padding: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid var(--color-line);
}

.age-cal-item {
  min-width: 72rpx;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 16rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-muted);
}

.age-cal-item.active {
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
}

.age-pick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 72rpx;
  margin-top: 8rpx;
  padding: 4rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.age-pick-label {
  font-size: 24rpx;
  color: var(--color-muted);
}

.age-pick-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.age-pick-caret {
  color: var(--color-muted);
  font-weight: 400;
}

.age-pick-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.age-hero-num {
  margin-top: 28rpx;
  font-family: var(--font-display);
  font-size: 96rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -4rpx;
  color: var(--color-brand);
}

.age-hero-unit {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.age-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.age-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #9d174d;
  background: rgba(244, 114, 182, 0.16);
}

.age-next {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.age-glance {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.age-glance-item {
  padding: 20rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid var(--color-line);
}

.age-glance-label {
  font-size: 22rpx;
  color: var(--color-muted);
}

.age-glance-value {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-brand);
  line-height: 1.2;
  word-break: break-all;
}

.age-glance-value-sm {
  font-size: 26rpx;
}

.age-glance-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.life-progress-panel {
  margin-top: 8rpx;
  padding: 18rpx 0 0;
  border-top: none;
}

.match-panel {
  padding-bottom: 12rpx;
}

.match-head {
  margin-bottom: 8rpx;
}

.match-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--color-muted);
}

.match-card {
  margin-top: 16rpx;
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  background:
    linear-gradient(160deg, rgba(244, 114, 182, 0.12) 0%, rgba(255, 255, 255, 0.55) 70%),
    rgba(255, 255, 255, 0.5);
  border: 1rpx solid var(--color-line);
}

.match-card.friend {
  background:
    linear-gradient(160deg, rgba(99, 102, 241, 0.12) 0%, rgba(255, 255, 255, 0.55) 70%),
    rgba(255, 255, 255, 0.5);
}

.match-card-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.match-symbol {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 36rpx;
  background: rgba(255, 255, 255, 0.8);
}

.match-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-brand);
}

.match-range {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.match-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--color-muted);
}

.date-picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
  background: var(--color-mask);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.date-picker-sheet {
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  background: var(--color-dialog);
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.date-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 28rpx 4rpx;
}

.date-picker-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.date-picker-action {
  min-width: 88rpx;
  padding: 16rpx 8rpx;
  font-size: 28rpx;
  color: var(--color-muted);
}

.date-picker-action.confirm {
  color: var(--color-brand);
  font-weight: 700;
  text-align: right;
}

.date-picker-view {
  width: 100%;
  height: 440rpx;
}

.date-picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  font-size: 32rpx;
  color: var(--color-ink);
}

.lived-dialog {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 620rpx;
  padding: 48rpx 36rpx 32rpx;
  border-radius: 32rpx;
  text-align: center;
  background:
    linear-gradient(180deg, var(--bg-glow-1) 0%, var(--color-dialog) 46%),
    var(--color-dialog);
  box-shadow: 0 24rpx 60rpx var(--color-shadow-strong);
  animation: lived-dialog-in 0.28s ease-out;
}

@keyframes lived-dialog-in {
  0% {
    transform: scale(0.86);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.lived-kicker {
  font-size: 48rpx;
  line-height: 1;
}

.lived-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.lived-days {
  margin-top: 16rpx;
  font-family: var(--font-display);
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -2rpx;
  color: var(--color-brand);
}

.lived-unit {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-brand-soft);
}

.lived-sub {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.life-progress {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-line);
  text-align: left;
}

.life-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.life-progress-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.life-progress-value {
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-brand-soft);
}

.life-bar {
  margin-top: 14rpx;
  height: 18rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: var(--bg-glow-1);
}

.life-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--color-brand-soft) 0%, var(--color-brand) 100%);
  transform-origin: left center;
}

.lived-dialog .life-bar-fill {
  animation: life-bar-in 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes life-bar-in {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

.life-progress-hint {
  margin-top: 12rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: var(--color-muted);
}

.life-progress-panel .life-progress-value {
  color: var(--color-brand);
}

.life-progress-panel .life-progress {
  margin-top: 0;
}

.lived-confirm {
  margin-top: 36rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  box-shadow: 0 10rpx 24rpx var(--color-shadow);
}

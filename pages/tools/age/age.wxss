@import "../tool-common.wxss";
@import "../calc-kit.wxss";
@import "../../confetti.wxss";

.conv-hero {
  background:
    linear-gradient(160deg, rgba(244, 114, 182, 0.14) 0%, rgba(255, 255, 255, 0.55) 58%),
    var(--color-surface);
}

.tool-icon-age {
  background: linear-gradient(135deg, #fce7f3, #f472b6);
}

.conv-stats {
  display: flex;
  align-items: flex-start;
  gap: 0;
}

.conv-stat {
  flex: 1;
  min-width: 0;
}

.conv-stat + .conv-stat {
  margin-left: 24rpx;
  padding-left: 24rpx;
  border-left: 1rpx solid var(--color-line);
}

.conv-stats .conv-result {
  font-size: 40rpx;
}

.conv-result-suffix {
  margin-left: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.conv-stat .conv-eq {
  margin-top: 28rpx;
}

.date-picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
  background: var(--color-mask);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.date-picker-sheet {
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  background: var(--color-dialog);
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.date-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 28rpx 4rpx;
}

.date-picker-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.date-picker-action {
  min-width: 88rpx;
  padding: 16rpx 8rpx;
  font-size: 28rpx;
  color: var(--color-muted);
}

.date-picker-action.confirm {
  color: var(--color-brand);
  font-weight: 700;
  text-align: right;
}

.date-picker-view {
  width: 100%;
  height: 440rpx;
}

.date-picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  font-size: 32rpx;
  color: var(--color-ink);
}

.lived-dialog {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 620rpx;
  padding: 48rpx 36rpx 32rpx;
  border-radius: 32rpx;
  text-align: center;
  background:
    linear-gradient(180deg, rgba(252, 231, 243, 0.92) 0%, var(--color-dialog) 46%),
    var(--color-dialog);
  box-shadow: 0 24rpx 60rpx var(--color-shadow-strong);
  animation: lived-dialog-in 0.28s ease-out;
}

@keyframes lived-dialog-in {
  0% {
    transform: scale(0.86);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.lived-kicker {
  font-size: 48rpx;
  line-height: 1;
}

.lived-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.lived-days {
  margin-top: 16rpx;
  font-family: var(--font-display);
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -2rpx;
  color: var(--color-brand);
}

.lived-unit {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-brand-soft);
}

.lived-sub {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.life-progress {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(244, 114, 182, 0.28);
  text-align: left;
}

.life-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.life-progress-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.life-progress-value {
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 800;
  color: #db2777;
}

.life-bar {
  margin-top: 14rpx;
  height: 18rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(244, 114, 182, 0.18);
}

.life-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #f9a8d4 0%, #f472b6 48%, #db2777 100%);
  transform-origin: left center;
}

.lived-dialog .life-bar-fill {
  animation: life-bar-in 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes life-bar-in {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

.life-progress-hint {
  margin-top: 12rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: var(--color-muted);
}

.life-progress-panel {
  margin-top: 8rpx;
  padding: 18rpx 0 8rpx;
  border-top: 1rpx solid var(--color-line);
}

.life-progress-panel .life-progress-value {
  color: var(--color-brand);
}

.lived-confirm {
  margin-top: 36rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #f472b6 0%, #db2777 100%);
}

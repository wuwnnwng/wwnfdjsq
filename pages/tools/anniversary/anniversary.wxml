<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-anniversary">
            <text class="tool-icon">🎉</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">倒数 · 周年 · 撒花</view>
            <view class="conv-title">纪念日倒计时</view>
          </view>
        </view>
      </view>
      <block wx:if="{{hero}}">
        <view class="hero-tap" bindtap="onOpenCelebrate" data-id="{{hero.id}}">
          <view class="conv-eq">{{hero.icon}} {{hero.name}} · {{hero.heroTitle}}</view>
          <view class="conv-result">{{hero.heroValue}}<text class="conv-result-suffix">{{hero.heroUnit}}</text></view>
          <view class="conv-result-unit">{{hero.heroSub}}</view>
        </view>
      </block>
      <view class="tool-note" wx:else>记下恋爱、结婚、生日这些日子，到了那天会弹框撒花。</view>
    </view>

    <view class="panel">
      <view class="section-title">我的纪念日</view>
      <view wx:if="{{!items.length}}" class="empty-hint">还没有纪念日，先添加一个吧</view>
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="memo-card {{item.isToday ? 'is-today' : ''}} {{item.isPast ? 'is-past' : ''}}"
        bindtap="onOpenCelebrate"
        data-id="{{item.id}}"
      >
        <view class="memo-icon">{{item.icon}}</view>
        <view class="memo-body">
          <view class="memo-name">{{item.name}}</view>
          <view class="memo-meta">{{item.dateText}} · {{item.lunarText}}{{item.yearly ? ' · 每年' : ''}}</view>
        </view>
        <view class="memo-count">
          <view class="memo-days">{{item.statusText}}</view>
          <view class="memo-years">{{item.yearsText}}</view>
          <view class="memo-edit" catchtap="onEditItem" data-id="{{item.id}}">编辑</view>
        </view>
      </view>
      <view class="tool-note" wx:if="{{items.length}}">点卡片会弹框撒花，点编辑可修改或删除。</view>
      <view class="primary-btn add-btn" bindtap="onOpenEditor">添加纪念日</view>
    </view>
  </scroll-view>

  <view wx:if="{{showEditor}}" class="editor-mask" catchtap="onHideEditor" catchtouchmove="preventMove">
    <view class="editor-sheet" catchtap="onEditorSheetTap">
      <view class="editor-head">
        <view class="editor-action" catchtap="onHideEditor">取消</view>
        <view class="editor-title">{{editingId ? '编辑纪念日' : '添加纪念日'}}</view>
        <view class="editor-action confirm" catchtap="onSaveEditor">保存</view>
      </view>
      <view class="type-row">
        <view
          wx:for="{{types}}"
          wx:key="id"
          class="type-chip {{draftType === item.id ? 'active' : ''}}"
          catchtap="onSelectType"
          data-id="{{item.id}}"
        >
          {{item.icon}} {{item.name}}
        </view>
      </view>
      <view class="field">
        <text class="field-label">名称</text>
        <view class="field-control">
          <input
            class="field-input"
            value="{{draftName}}"
            maxlength="{{nameMaxLen}}"
            placeholder="例如 结婚纪念日"
            bindinput="onNameInput"
          />
        </view>
      </view>
      <view class="field">
        <text class="field-label">日期</text>
        <view class="field-control">
          <view class="picker-value" catchtap="onOpenDatePicker">{{draftDateDisplay}}</view>
        </view>
      </view>
      <view class="field">
        <text class="field-label">重复</text>
        <view class="field-control">
          <view class="mini-seg">
            <view class="mini-seg-item {{draftYearly ? 'active' : ''}}" catchtap="onYearlyChange" data-yearly="1">每年</view>
            <view class="mini-seg-item {{draftYearly ? '' : 'active'}}" catchtap="onYearlyChange" data-yearly="0">仅一次</view>
          </view>
        </view>
      </view>
      <view class="editor-delete" wx:if="{{editingId}}" catchtap="onDeleteCurrent">删除这个纪念日</view>
    </view>
  </view>

  <date-picker
    show="{{showDatePicker}}"
    title="选择日期"
    value="{{draftDate}}"
    start="1900-01-01"
    end="2100-12-31"
    bindconfirm="onDatePickerConfirm"
    bindcancel="onHideDatePicker"
  />

  <view wx:if="{{showCelebrate}}" class="confetti-mask" catchtap="onCloseCelebrate" catchtouchmove="preventMove">
    <view class="confetti-layer">
      <view
        wx:for="{{confettiPieces}}"
        wx:key="id"
        class="confetti-piece confetti-piece-{{item.kind}} confetti-{{item.mode}}-{{item.fall}}"
        style="left: {{item.left}}%; top: {{item.top}}; animation-delay: {{item.delay}}s; animation-duration: {{item.duration}}s; background: {{item.color}}; width: {{item.size}}rpx; height: {{item.height}}rpx;"
      >
        <text wx:if="{{item.emoji}}" class="confetti-emoji" style="font-size: {{item.size}}rpx;">{{item.emoji}}</text>
      </view>
    </view>
    <view class="lived-dialog" catchtap="onCelebrateDialogTap">
      <view class="lived-kicker">{{celebrate.icon}}</view>
      <view class="lived-title">{{celebrate.popupTitle}}</view>
      <view class="lived-days">{{celebrate.heroValue}}</view>
      <view class="lived-unit">{{celebrate.heroUnit}}</view>
      <view class="lived-sub">{{celebrate.name}}</view>
      <view class="lived-sub lived-sub-soft">{{celebrate.popupSub}}</view>
      <view class="lived-confirm" catchtap="onCloseCelebrate">知道了</view>
    </view>
  </view>
</view>

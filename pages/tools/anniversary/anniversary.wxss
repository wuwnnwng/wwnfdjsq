@import "../tool-common.wxss";
@import "../calc-kit.wxss";
@import "../../confetti.wxss";

.conv-hero {
  background:
    linear-gradient(160deg, rgba(244, 114, 182, 0.16) 0%, rgba(255, 255, 255, 0.55) 58%),
    var(--color-surface);
}

.tool-icon-anniversary {
  background: linear-gradient(135deg, #fce7f3, #e879f9);
}

.conv-result-suffix {
  margin-left: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.hero-tap:active {
  opacity: 0.86;
}

.empty-hint {
  padding: 24rpx 0 8rpx;
  font-size: 26rpx;
  color: var(--color-muted);
  text-align: center;
}

.memo-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.memo-card:last-of-type {
  border-bottom: none;
}

.memo-card:active {
  opacity: 0.82;
}

.memo-icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: linear-gradient(135deg, #fce7f3, #f9a8d4);
}

.memo-card.is-today .memo-icon {
  background: linear-gradient(135deg, #fde68a, #fb7185);
}

.memo-body {
  flex: 1;
  min-width: 0;
}

.memo-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memo-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memo-count {
  flex-shrink: 0;
  text-align: right;
}

.memo-days {
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-brand);
}

.memo-card.is-today .memo-days {
  color: #e11d48;
}

.memo-card.is-past .memo-days {
  color: var(--color-muted);
}

.memo-years {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-muted);
}

.add-btn {
  margin-top: 24rpx;
}

.memo-edit {
  margin-top: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.editor-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1100;
  background: var(--color-mask);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.editor-sheet {
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  background: var(--color-dialog);
  padding: 12rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 12rpx;
}

.editor-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.editor-action {
  min-width: 88rpx;
  padding: 16rpx 8rpx;
  font-size: 28rpx;
  color: var(--color-muted);
}

.editor-action.confirm {
  color: var(--color-brand);
  font-weight: 700;
  text-align: right;
}

.type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 8rpx 0 16rpx;
}

.type-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-ink);
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid var(--color-line);
}

.type-chip.active {
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  border-color: transparent;
}

.mini-seg {
  display: flex;
  gap: 8rpx;
}

.mini-seg-item {
  min-width: 88rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-muted);
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid var(--color-line);
}

.mini-seg-item.active {
  color: #fff;
  background: var(--color-brand);
  border-color: transparent;
}

.editor-delete {
  margin-top: 12rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #e11d48;
}

.lived-dialog {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 620rpx;
  padding: 48rpx 36rpx 32rpx;
  border-radius: 32rpx;
  text-align: center;
  background:
    linear-gradient(180deg, rgba(244, 114, 182, 0.18) 0%, var(--color-dialog) 46%),
    var(--color-dialog);
  box-shadow: 0 24rpx 60rpx var(--color-shadow-strong);
  animation: lived-dialog-in 0.28s ease-out;
}

@keyframes lived-dialog-in {
  0% {
    transform: scale(0.86);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.lived-kicker {
  font-size: 56rpx;
  line-height: 1;
}

.lived-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.lived-days {
  margin-top: 16rpx;
  font-family: var(--font-display);
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -2rpx;
  color: var(--color-brand);
}

.lived-unit {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-brand-soft);
}

.lived-sub {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.lived-sub-soft {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-muted);
}

.lived-confirm {
  margin-top: 36rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  box-shadow: 0 10rpx 24rpx var(--color-shadow);
}

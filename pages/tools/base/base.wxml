<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-id">
        <view class="tool-icon-wrap tool-icon-base">
          <text class="tool-icon">🔢</text>
        </view>
        <view class="conv-hero-copy">
          <view class="conv-kicker">进制</view>
          <view class="conv-title">2 / 8 / 10 / 16 互转</view>
        </view>
      </view>
      <view class="conv-eq">当前按{{baseLabels[baseIndex]}}输入</view>
      <view class="conv-result">{{inputValue || '—'}}</view>
      <view class="conv-result-unit">{{baseLabels[baseIndex]}}</view>
    </view>

    <view class="panel conv-board">
      <view class="conv-card">
        <view class="conv-card-label">输入进制</view>
        <view class="base-segs">
          <view
            class="base-seg {{index === baseIndex ? 'active' : ''}}"
            wx:for="{{baseOptions}}"
            wx:key="key"
            bindtap="onSelectBase"
            data-index="{{index}}"
          >
            {{item.short}}
          </view>
        </view>
        <input
          class="conv-input"
          value="{{inputValue}}"
          placeholder="输入整数"
          bindinput="onInputChange"
        />
        <view class="tool-note warn" wx:if="{{errorText}}">{{errorText}}</view>
      </view>
    </view>

    <view class="base-grid">
      <view class="base-tile" bindtap="onCopyResult" data-value="{{binary}}">
        <view class="base-tile-tag">BIN</view>
        <view class="base-tile-name">二进制</view>
        <view class="base-tile-value">{{binary || '—'}}</view>
      </view>
      <view class="base-tile" bindtap="onCopyResult" data-value="{{octal}}">
        <view class="base-tile-tag">OCT</view>
        <view class="base-tile-name">八进制</view>
        <view class="base-tile-value">{{octal || '—'}}</view>
      </view>
      <view class="base-tile" bindtap="onCopyResult" data-value="{{decimalText}}">
        <view class="base-tile-tag">DEC</view>
        <view class="base-tile-name">十进制</view>
        <view class="base-tile-value">{{decimalText || '—'}}</view>
      </view>
      <view class="base-tile" bindtap="onCopyResult" data-value="{{hex}}">
        <view class="base-tile-tag">HEX</view>
        <view class="base-tile-name">十六进制</view>
        <view class="base-tile-value">{{hex || '—'}}</view>
      </view>
    </view>
    <view class="base-hint">点按结果可复制</view>
  </scroll-view>
</view>

@import "../tool-common.wxss";

.conv-hero {
  margin-top: 0;
  padding: 32rpx 28rpx 36rpx;
  background:
    linear-gradient(160deg, rgba(167, 139, 250, 0.22) 0%, var(--color-hero-fade) 58%),
    var(--color-surface);
}

.conv-hero-id {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tool-icon-wrap {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.tool-icon {
  font-size: 42rpx;
  line-height: 1;
}

.tool-icon-base {
  background: linear-gradient(135deg, #ede9fe, #a78bfa);
}

.conv-kicker {
  font-size: 22rpx;
  color: var(--color-muted);
  letter-spacing: 2rpx;
}

.conv-title {
  margin-top: 4rpx;
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-brand);
  line-height: 1.25;
}

.conv-eq {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

.conv-result {
  margin-top: 8rpx;
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: var(--color-brand);
  line-height: 1.15;
  word-break: break-all;
}

.conv-result-unit {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.conv-board {
  padding: 20rpx 16rpx 16rpx;
}

.conv-card {
  padding: 8rpx 8rpx 4rpx;
}

.conv-card-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-muted);
  letter-spacing: 2rpx;
}

.conv-input {
  margin-top: 16rpx;
  width: 100%;
  min-height: 88rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-ink);
  line-height: 1.2;
}

.base-segs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 16rpx;
}

.base-seg {
  min-height: 72rpx;
  padding: 12rpx 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--color-muted);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.base-seg.active {
  color: var(--color-on-brand);
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  border-color: transparent;
}

.base-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}

.base-tile {
  min-height: 220rpx;
  padding: 24rpx 22rpx 20rpx;
  border-radius: var(--radius);
  background: var(--color-surface);
  border: 1rpx solid var(--color-card-border);
}

.base-tile:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.base-tile-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-brand);
  background: var(--bg-glow-1);
}

.base-tile-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.base-tile-value {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-brand);
  word-break: break-all;
  line-height: 1.35;
}

.base-hint {
  margin: 16rpx 8rpx 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-muted);
}

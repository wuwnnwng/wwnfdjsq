<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-bmi">
            <text class="tool-icon">🧍</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">身高 · 体重 · 标准</view>
            <view class="conv-title">BMI体重</view>
          </view>
        </view>
      </view>
      <block wx:if="{{result && result.valid}}">
        <view class="conv-eq">身体质量指数 BMI</view>
        <view class="conv-result">{{result.bmiText}}</view>
        <view class="conv-result-unit level-{{result.levelId}}">{{result.levelName}}</view>
        <view class="bmi-track">
          <view class="bmi-seg under"></view>
          <view class="bmi-seg normal"></view>
          <view class="bmi-seg over"></view>
          <view class="bmi-seg obese"></view>
        </view>
        <view class="bmi-marker-wrap">
          <view class="bmi-marker" style="left: {{result.markerPercent}}%;"></view>
        </view>
        <view class="bmi-legend">
          <text>过低</text>
          <text>正常</text>
          <text>超重</text>
          <text>肥胖</text>
        </view>
      </block>
      <view class="tool-note warn" wx:elif="{{result && !result.valid}}">{{result.message}}</view>
    </view>

    <view class="panel">
      <view class="field">
        <text class="field-label">身高</text>
        <view class="field-control">
          <input class="field-input" type="digit" value="{{height}}" data-field="height" bindinput="onInput" placeholder="例如 170" />
          <text class="field-unit">厘米</text>
        </view>
      </view>
      <view class="field">
        <text class="field-label">体重</text>
        <view class="field-control">
          <input class="field-input" type="digit" value="{{weight}}" data-field="weight" bindinput="onInput" placeholder="例如 65" />
          <text class="field-unit">公斤</text>
        </view>
      </view>
    </view>

    <view class="panel" wx:if="{{result && result.valid}}">
      <view class="section-title">体重参考</view>
      <view class="result-row">
        <view class="result-row-label">健康体重范围</view>
        <view class="result-row-value">{{result.rangeText}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">当前体重</view>
        <view class="result-row-value">{{result.weightText}} 公斤</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">建议</view>
        <view class="result-row-value">{{result.hint}}</view>
      </view>
      <view class="tool-note">成人标准依据卫生行业标准 WS/T 428：BMI &lt; 18.5 过低，18.5–23.9 正常，24.0–27.9 超重，≥ 28 肥胖。结果仅供参考，不能替代医疗意见。</view>
    </view>
  </scroll-view>
</view>

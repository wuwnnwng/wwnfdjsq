@import "../tool-common.wxss";
@import "../calc-kit.wxss";

.conv-hero {
  background:
    linear-gradient(160deg, rgba(52, 211, 153, 0.16) 0%, var(--color-hero-fade) 58%),
    var(--color-surface);
}

.tool-icon-bmi {
  background: linear-gradient(135deg, #d1fae5, #34d399);
}

.level-under {
  color: #2563eb;
}

.level-normal {
  color: #059669;
}

.level-over {
  color: #d97706;
}

.level-obese {
  color: #dc2626;
}

.bmi-range {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.bmi-scale {
  position: relative;
  margin-top: 24rpx;
}

.bmi-scale .bmi-track {
  margin-top: 0;
  height: 28rpx;
}

.bmi-scale-ticks {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 28rpx;
  pointer-events: none;
}

.bmi-scale-tick {
  position: absolute;
  top: 0;
  height: 28rpx;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bmi-scale-label {
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
  color: #ffffff;
  text-shadow: 0 1rpx 3rpx rgba(15, 23, 42, 0.45);
}

.bmi-scale .bmi-marker-wrap {
  height: 20rpx;
  margin-top: 6rpx;
}

.conv-hero {
  margin-top: 0;
  padding: 32rpx 28rpx 36rpx;
  background:
    linear-gradient(160deg, rgba(31, 107, 82, 0.12) 0%, rgba(255, 255, 255, 0.55) 58%),
    var(--color-surface);
}

.conv-hero-top {
  display: flex;
  align-items: flex-start;
}

.conv-hero-id {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tool-icon-wrap {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.tool-icon {
  font-size: 42rpx;
  line-height: 1;
}

.conv-kicker {
  font-size: 22rpx;
  color: var(--color-muted);
  letter-spacing: 2rpx;
}

.conv-title {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-brand);
  line-height: 1.25;
}

.conv-eq {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.conv-result {
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: var(--color-brand);
  line-height: 1.25;
  word-break: break-all;
}

.conv-result.compact {
  font-size: 36rpx;
}

.conv-result-unit {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.seg-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.seg-row.cols-3 {
  grid-template-columns: 1fr 1fr 1fr;
}

.seg-item {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-muted);
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid var(--color-line);
}

.seg-item.active {
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  border-color: transparent;
}

.copy-link {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-brand);
}

.bmi-track {
  margin-top: 24rpx;
  height: 16rpx;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
}

.bmi-seg {
  height: 100%;
}

.bmi-seg.under {
  flex: 18.5;
  background: #60a5fa;
}

.bmi-seg.normal {
  flex: 5.5;
  background: #34d399;
}

.bmi-seg.over {
  flex: 4;
  background: #fbbf24;
}

.bmi-seg.obese {
  flex: 8;
  background: #f87171;
}

.bmi-marker-wrap {
  position: relative;
  height: 28rpx;
  margin-top: 8rpx;
}

.bmi-marker {
  position: absolute;
  top: 0;
  width: 4rpx;
  height: 28rpx;
  margin-left: -2rpx;
  border-radius: 4rpx;
  background: var(--color-brand);
}

.bmi-legend {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: var(--color-muted);
}

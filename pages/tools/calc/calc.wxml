<view class="page page-shell theme-{{theme}} calc-page">
  <view class="calc-display panel">
    <view class="calc-mode">{{angleLabel}}</view>
    <view class="calc-expression" wx:if="{{expression && expression !== displayValue}}">{{expression}}</view>
    <view class="calc-value">{{displayValue}}</view>
    <view class="calc-error" wx:if="{{errorText}}">{{errorText}}</view>
  </view>

  <scroll-view scroll-y class="calc-scroll" enhanced show-scrollbar="{{false}}">
    <view class="calc-keyboard panel">
      <view
        class="calc-key tone-{{item.tone || 'default'}}"
        wx:for="{{keys}}"
        wx:key="label"
        bindtap="onKeyTap"
        data-type="{{item.type}}"
        data-value="{{item.value}}"
        data-action="{{item.action}}"
      >{{item.action === 'toggleAngle' ? angleLabel : item.label}}</view>
    </view>
  </scroll-view>
</view>

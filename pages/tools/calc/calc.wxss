@import "../tool-common.wxss";

.calc-page {
  display: flex;
  flex-direction: column;
}

.calc-display {
  margin-top: 0;
  flex-shrink: 0;
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.calc-expression {
  font-size: 24rpx;
  color: var(--color-muted);
  text-align: right;
  word-break: break-all;
}

.calc-value {
  margin-top: 12rpx;
  font-size: 52rpx;
  font-weight: 700;
  text-align: right;
  color: var(--color-ink);
  word-break: break-all;
}

.calc-error {
  margin-top: 12rpx;
  font-size: 22rpx;
  text-align: right;
  color: var(--color-accent);
}

.calc-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.calc-keyboard {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.calc-key {
  min-height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-weight: 600;
  color: var(--color-ink);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
  box-sizing: border-box;
}

.calc-key-main {
  font-size: 28rpx;
  line-height: 1.2;
}

.calc-key-sub {
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 1;
  color: var(--color-muted);
  font-weight: 500;
}

.calc-key.tone-fn {
  color: var(--color-brand);
  background: var(--color-soft);
}

.calc-key.tone-fn .calc-key-main {
  font-size: 24rpx;
}

.calc-key.tone-soft {
  color: var(--color-muted);
}

.calc-key.tone-switch {
  color: var(--color-on-brand);
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  border-color: transparent;
}

.calc-key.tone-switch .calc-key-sub {
  color: rgba(255, 255, 255, 0.82);
}

.calc-key.tone-mode {
  color: var(--color-on-brand);
  background: linear-gradient(135deg, var(--color-brand-soft) 0%, var(--color-brand) 100%);
  border-color: transparent;
}

.calc-key.tone-accent {
  color: #fff;
  background: linear-gradient(135deg, var(--color-accent) 0%, #e07a42 100%);
  border-color: transparent;
}

.calc-key.tone-ghost {
  visibility: hidden;
  pointer-events: none;
  border: none;
  background: transparent;
}

.calc-key.has-sub .calc-key-main {
  font-size: 30rpx;
}

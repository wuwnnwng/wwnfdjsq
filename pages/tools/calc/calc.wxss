@import "../tool-common.wxss";

.calc-page {
  justify-content: space-between;
}

.calc-display {
  margin-top: 0;
  min-height: 180rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.calc-expression {
  font-size: 24rpx;
  color: var(--color-muted);
  text-align: right;
  word-break: break-all;
}

.calc-value {
  margin-top: 12rpx;
  font-size: 56rpx;
  font-weight: 700;
  text-align: right;
  color: var(--color-ink);
  word-break: break-all;
}

.calc-error {
  margin-top: 12rpx;
  font-size: 22rpx;
  text-align: right;
  color: var(--color-accent);
}

.calc-keyboard {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.calc-key {
  width: calc(25% - 9rpx);
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-ink);
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid var(--color-line);
  box-sizing: border-box;
}

.calc-key.wide {
  width: calc(50% - 6rpx);
}

.calc-key.accent {
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  border-color: transparent;
}

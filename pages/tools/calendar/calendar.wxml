<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="calendar-scroll" enhanced show-scrollbar="{{false}}">
    <!-- 日历 -->
    <view wx:if="{{activeTab === 'calendar'}}">
      <view class="panel calendar-panel">
        <view class="calendar-head">
          <view class="month-nav" catchtap="onPrevMonth" hover-class="month-nav-hover">‹</view>
          <view class="month-title-wrap" catchtap="onOpenDatePicker">
            <view class="month-title">{{viewYear}}年{{viewMonth}}月</view>
            <view class="month-sub" wx:if="{{selectedInfo}}">{{selectedDay}}日 · {{selectedInfo.weekdayText}} · {{selectedInfo.weekText}}</view>
          </view>
          <view class="month-nav" catchtap="onNextMonth" hover-class="month-nav-hover">›</view>
        </view>
        <view class="calendar-toolbar">
          <view class="today-link" bindtap="onBackToday">回到今天</view>
          <view
            class="auspicious-link {{auspiciousEvent ? 'active' : ''}}"
            bindtap="onToggleAuspiciousPicker"
            aria-role="button"
            aria-label="选择吉日"
          >
            {{auspiciousEventName || '选择吉日'}}
            <text class="auspicious-arrow">{{showAuspiciousPicker ? '▲' : '▼'}}</text>
          </view>
        </view>

        <scroll-view
          wx:if="{{showAuspiciousPicker}}"
          scroll-x
          enhanced
          enable-flex
          show-scrollbar="{{false}}"
          class="auspicious-scroll"
        >
          <view class="auspicious-tags">
            <view
              class="auspicious-tag {{auspiciousEvent === item.id ? 'active' : ''}}"
              wx:for="{{auspiciousEvents}}"
              wx:key="id"
              bindtap="onSelectAuspiciousEvent"
              data-id="{{item.id}}"
            >
              {{item.name}}
            </view>
          </view>
        </scroll-view>
        <view class="tool-note auspicious-note" wx:if="{{auspiciousEventName}}">
          本月适合「{{auspiciousEventName}}」的日期已用绿色标注，仅供参考。
        </view>

        <view
          class="calendar-swipe"
          bindtouchstart="onCalendarTouchStart"
          bindtouchend="onCalendarTouchEnd"
          bindtouchcancel="onCalendarTouchEnd"
        >
          <view class="week-row">
            <view class="week-cell" wx:for="{{weekHeaders}}" wx:key="*this">{{item}}</view>
          </view>

          <view class="day-grid">
            <view
              class="day-cell {{item.inMonth ? '' : 'other-month'}} {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.isAuspicious ? 'auspicious' : ''}}"
              wx:for="{{monthCells}}"
              wx:key="key"
              bindtap="onSelectDay"
              data-year="{{item.year}}"
              data-month="{{item.month}}"
              data-day="{{item.day}}"
              data-inmonth="{{item.inMonth}}"
            >
              <view class="day-mark rest" wx:if="{{item.isRestDay}}">休</view>
              <view class="day-mark work" wx:if="{{item.isWorkDay}}">班</view>
              <view class="day-num">{{item.day}}</view>
              <view class="day-tag {{item.festivalShort ? 'festival' : ''}}">{{item.daySub}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="panel detail-panel" wx:if="{{selectedInfo}}">
        <view class="detail-lunar">{{selectedInfo.lunarText}}</view>
        <view class="detail-meta">{{selectedInfo.ganZhiText}} · {{selectedInfo.ganZhiDay}}</view>
        <view class="detail-term" wx:if="{{selectedInfo.festival}}">节日：{{selectedInfo.festival}}</view>
        <view class="detail-term">节气：{{selectedInfo.solarTerm}}</view>
        <view class="detail-term" wx:if="{{selectedInfo.constellation}}">星座：{{selectedInfo.constellation}}</view>

        <view class="yi-ji-block">
          <view class="yi-ji-row">
            <view class="yi-ji-label yi">宜</view>
            <view class="yi-ji-text">
              <text class="yi-ji-item" wx:for="{{selectedInfo.yiList}}" wx:key="*this">{{item}}</text>
            </view>
          </view>
          <view class="yi-ji-row">
            <view class="yi-ji-label ji">忌</view>
            <view class="yi-ji-text">
              <text class="yi-ji-item ji" wx:for="{{selectedInfo.jiList}}" wx:key="*this">{{item}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 黄历 -->
    <view wx:if="{{activeTab === 'almanac'}}">
      <view class="panel huangli-panel" wx:if="{{huangliDetail}}">
        <view class="huangli-head">
          <view class="month-nav" catchtap="onHuangliPrevDay" hover-class="month-nav-hover" aria-role="button" aria-label="前一天">‹</view>
          <view class="huangli-head-main" catchtap="onOpenDatePicker" aria-role="button" aria-label="选择日期">
            <view class="huangli-date-title">
              {{huangliDetail.solarText}}
              <text class="huangli-today-badge" wx:if="{{huangliDetail.isToday}}">今</text>
            </view>
            <view class="huangli-date-sub">{{huangliDetail.weekdayText}} · {{huangliDetail.lunarText}}</view>
          </view>
          <view class="month-nav" catchtap="onHuangliNextDay" hover-class="month-nav-hover" aria-role="button" aria-label="后一天">›</view>
        </view>
        <view class="huangli-toolbar">
          <view class="today-link" bindtap="onBackToday">{{huangliDetail.isToday ? '已是今天' : '回到今天'}}</view>
          <view class="help-icon" catchtap="onShowHuangliTip" aria-role="button" aria-label="黄历释义">!</view>
        </view>
        <view class="huangli-ganzhi">
          {{huangliDetail.ganZhiYear}}年 {{huangliDetail.ganZhiMonth}}月 {{huangliDetail.ganZhiDay}}日 · {{huangliDetail.zodiac}}年
        </view>
        <view class="huangli-term" wx:if="{{huangliDetail.solarTerm}}">节气 {{huangliDetail.solarTerm}}</view>

        <view class="yi-ji-block huangli-yiji">
          <view class="yi-ji-row">
            <view class="yi-ji-label yi">宜</view>
            <view class="yi-ji-text">
              <text class="yi-ji-item" wx:for="{{huangliDetail.yiList}}" wx:key="*this">{{item}}</text>
            </view>
          </view>
          <view class="yi-ji-row">
            <view class="yi-ji-label ji">忌</view>
            <view class="yi-ji-text">
              <text class="yi-ji-item ji" wx:for="{{huangliDetail.jiList}}" wx:key="*this">{{item}}</text>
            </view>
          </view>
        </view>

        <view class="hl-glance">
          <view class="hl-glance-card">
            <view class="hl-glance-label">建除十二神</view>
            <view class="hl-glance-value">{{huangliDetail.jianChu}}日</view>
            <view class="hl-glance-sub">{{huangliDetail.jianChuDesc}}</view>
          </view>
          <view class="hl-glance-card">
            <view class="hl-glance-label">值神</view>
            <view class="hl-glance-value">{{huangliDetail.tianShen}}</view>
            <view class="hl-glance-sub {{huangliDetail.tianShenLucky ? 'good' : 'bad'}}">
              {{huangliDetail.tianShenType}} · {{huangliDetail.tianShenLuckText}}
            </view>
          </view>
          <view class="hl-glance-card">
            <view class="hl-glance-label">五行</view>
            <view class="hl-glance-value">{{huangliDetail.wuXing}}</view>
            <view class="hl-glance-sub">纳音 {{huangliDetail.nayin}}</view>
          </view>
          <view class="hl-glance-card">
            <view class="hl-glance-label">冲煞</view>
            <view class="hl-glance-value">冲{{huangliDetail.chongAnimal}}</view>
            <view class="hl-glance-sub">{{huangliDetail.chong}} · {{huangliDetail.shaText}}</view>
          </view>
          <view class="hl-glance-card">
            <view class="hl-glance-label">今日胎神</view>
            <view class="hl-glance-value hl-glance-value-sm">{{huangliDetail.taiShen}}</view>
            <view class="hl-glance-sub">动土安床宜避此方</view>
          </view>
          <view class="hl-glance-card">
            <view class="hl-glance-label">二十八星宿</view>
            <view class="hl-glance-value">{{huangliDetail.xiuFull}}</view>
            <view class="hl-glance-sub {{huangliDetail.xiuLucky ? 'good' : 'bad'}}">{{huangliDetail.xiuLuckText}}宿</view>
          </view>
        </view>

        <view class="jianchu-grid">
          <view
            class="jianchu-item {{item.active ? 'active' : ''}}"
            wx:for="{{huangliDetail.jianChuList}}"
            wx:key="name"
          >
            <view class="jianchu-name">{{item.name}}</view>
          </view>
        </view>

        <view class="hl-block">
          <view class="hl-block-label">彭祖百忌</view>
          <view class="hl-block-line" wx:for="{{huangliDetail.pengzuLines}}" wx:key="*this">{{item}}</view>
        </view>

        <view class="huangli-section">
          <view class="huangli-section-head" bindtap="onToggleHuangliSection" data-key="hourLuck">
            <view class="huangli-section-title">时辰吉凶</view>
            <text class="festival-section-arrow">{{huangliSectionOpen.hourLuck ? '收起详情' : '查看详情'}}</text>
          </view>
          <view class="hour-now-bar" wx:if="{{huangliDetail.currentHour}}">
            <view class="hour-now-main">
              当前 {{huangliDetail.currentHour.label}} {{huangliDetail.currentHour.range}}
            </view>
            <view class="hour-now-luck {{huangliDetail.currentHour.lucky ? 'good' : 'bad'}}">
              {{huangliDetail.currentHour.luckText}} · {{huangliDetail.currentHour.deity}}
            </view>
          </view>
          <view class="hour-chips">
            <view
              class="hour-chip {{item.lucky ? 'lucky' : 'unlucky'}} {{item.isNow ? 'now' : ''}}"
              wx:for="{{huangliDetail.hourLuckList}}"
              wx:key="zhi"
            >
              {{item.zhi}}{{item.luckText}}
            </view>
          </view>
          <view class="hour-grid" wx:if="{{huangliSectionOpen.hourLuck}}">
            <view
              class="hour-item {{item.lucky ? 'lucky' : 'unlucky'}} {{item.isNow ? 'now' : ''}}"
              wx:for="{{huangliDetail.hourLuckList}}"
              wx:key="zhi"
            >
              <view class="hour-top">
                <view class="hour-label">{{item.label}}</view>
                <view class="hour-luck">{{item.luckText}}</view>
              </view>
              <view class="hour-range">{{item.range}}</view>
              <view class="hour-deity">{{item.deity}}</view>
              <view class="hour-now-tag" wx:if="{{item.isNow}}">当前</view>
            </view>
          </view>
        </view>

        <view class="huangli-section">
          <view class="huangli-section-title">吉神宜趋</view>
          <view class="hl-tags" wx:if="{{huangliDetail.jiShenList.length}}">
            <view class="hl-tag good" wx:for="{{huangliDetail.jiShenList}}" wx:key="*this">{{item}}</view>
          </view>
          <view class="hl-empty" wx:else>今日无特别吉神</view>
        </view>

        <view class="huangli-section">
          <view class="huangli-section-title">凶神宜忌</view>
          <view class="hl-tags" wx:if="{{huangliDetail.xiongShaList.length}}">
            <view class="hl-tag bad" wx:for="{{huangliDetail.xiongShaList}}" wx:key="*this">{{item}}</view>
          </view>
          <view class="hl-empty" wx:else>今日无特别凶神</view>
        </view>

        <view class="hl-footnote">宜忌依《协纪辨方书》铺注，星宿按日支配星期，仅供生活查阅，不作专业择日依据。</view>
      </view>
    </view>

    <!-- 节日 -->
    <view wx:if="{{activeTab === 'festival'}}">
      <view class="tool-note" wx:if="{{festivalLoading}}">正在加载官方放假安排…</view>
      <view class="tool-note warn" wx:if="{{festivalError}}">{{festivalError}}</view>
      <view class="panel festival-panel">
        <view class="festival-section-head" bindtap="onToggleFestivalSection" data-key="legal">
          <view class="festival-section-title">法定假日</view>
          <text class="festival-section-arrow">{{festivalSectionOpen.legal ? '▲' : '▼'}}</text>
        </view>
        <block wx:if="{{festivalSectionOpen.legal}}">
          <view class="festival-source-note">数据来源：国务院放假安排（含调休）</view>
          <view class="festival-item" wx:for="{{festivalGroups.legal}}" wx:key="name">
            <view class="festival-item-main">
              <view class="festival-name">{{item.name}}</view>
              <view class="festival-desc">{{item.desc}}</view>
              <view class="festival-note" wx:if="{{item.note}}">{{item.note}}</view>
            </view>
            <view class="festival-countdown {{item.countdownTone}}">{{item.countdownText}}</view>
          </view>
        </block>
      </view>

      <view class="panel festival-panel">
        <view class="festival-section-head" bindtap="onToggleFestivalSection" data-key="terms">
          <view class="festival-section-title">二十四节气</view>
          <text class="festival-section-arrow">{{festivalSectionOpen.terms ? '▲' : '▼'}}</text>
        </view>
        <block wx:if="{{festivalSectionOpen.terms}}">
          <view class="festival-item" wx:for="{{festivalGroups.terms}}" wx:key="name">
            <view class="festival-item-main">
              <view class="festival-name">{{item.name}}</view>
              <view class="festival-desc">{{item.desc}}</view>
            </view>
            <view class="festival-countdown {{item.countdownTone}}">{{item.countdownText}}</view>
          </view>
        </block>
      </view>

      <view class="panel festival-panel">
        <view class="festival-section-head" bindtap="onToggleFestivalSection" data-key="popular">
          <view class="festival-section-title">热门节日</view>
          <text class="festival-section-arrow">{{festivalSectionOpen.popular ? '▲' : '▼'}}</text>
        </view>
        <block wx:if="{{festivalSectionOpen.popular}}">
          <view class="festival-item" wx:for="{{festivalGroups.popular}}" wx:key="name">
            <view class="festival-item-main">
              <view class="festival-name">{{item.name}}</view>
              <view class="festival-desc">{{item.desc}}</view>
              <view class="festival-note" wx:if="{{item.note}}">{{item.note}}</view>
            </view>
            <view class="festival-countdown {{item.countdownTone}}">{{item.countdownText}}</view>
          </view>
        </block>
      </view>
    </view>

    <view class="calendar-bottom-space"></view>
  </scroll-view>

  <view wx:if="{{showDatePicker}}" class="date-picker-mask" catchtap="onCancelDatePicker" catchtouchmove="preventMove">
    <view class="date-picker-sheet" catchtap="onDatePickerSheetTap">
      <view class="date-picker-head">
        <view class="date-picker-action" catchtap="onCancelDatePicker">取消</view>
        <view class="date-picker-title">选择日期</view>
        <view class="date-picker-action confirm" catchtap="onConfirmDatePicker">确定</view>
      </view>
      <view class="date-picker-cal-wrap">
        <view class="date-picker-cal-seg">
          <view
            class="date-picker-cal-item {{pickerCalendar === 'solar' ? 'active' : ''}}"
            catchtap="onSwitchPickerCalendar"
            data-cal="solar"
          >
            公历
          </view>
          <view
            class="date-picker-cal-item {{pickerCalendar === 'lunar' ? 'active' : ''}}"
            catchtap="onSwitchPickerCalendar"
            data-cal="lunar"
          >
            农历
          </view>
        </view>
      </view>
      <view class="date-picker-hint" wx:if="{{pickerHint}}">{{pickerHint}}</view>
      <picker-view
        wx:if="{{pickerCalendar === 'solar'}}"
        class="date-picker-view"
        value="{{datePickerValue}}"
        immediate-change="{{true}}"
        bindchange="onDatePickerChange"
        indicator-style="height: 72rpx;"
        indicator-class="date-picker-indicator"
      >
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{pickerYears}}" wx:key="*this">{{item}}年</view>
        </picker-view-column>
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{pickerMonths}}" wx:key="*this">{{item}}月</view>
        </picker-view-column>
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{pickerDays}}" wx:key="*this">{{item}}日</view>
        </picker-view-column>
      </picker-view>
      <picker-view
        wx:else
        class="date-picker-view"
        value="{{lunarPickerValue}}"
        immediate-change="{{true}}"
        bindchange="onLunarPickerChange"
        indicator-style="height: 72rpx;"
        indicator-class="date-picker-indicator"
      >
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{pickerYears}}" wx:key="*this">{{item}}年</view>
        </picker-view-column>
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{lunarMonths}}" wx:key="label">{{item.label}}</view>
        </picker-view-column>
        <picker-view-column>
          <view class="date-picker-item" wx:for="{{lunarDays}}" wx:key="*this">{{item}}</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>

  <view class="tip-mask" wx:if="{{showHuangliTip}}" catchtouchmove="preventMove" bindtap="onHideHuangliTip">
    <view class="tip-dialog" catchtap="preventMove">
      <view class="tip-title">黄历怎么看</view>
      <view class="tip-text tip-single">
        宜忌按《协纪辨方书》神煞铺注；二十八宿按日支与星期轮值。冲煞看生肖与方位，胎神供动土安床回避，时辰看黄道十二神。内容仅供生活参考。
      </view>
      <view class="tip-confirm" bindtap="onHideHuangliTip">我知道了</view>
    </view>
  </view>

  <view class="calendar-tabs">
    <view
      class="calendar-tab {{activeTab === 'calendar' ? 'active' : ''}}"
      bindtap="onTabChange"
      data-tab="calendar"
    >
      日历
    </view>
    <view
      class="calendar-tab {{activeTab === 'almanac' ? 'active' : ''}}"
      bindtap="onTabChange"
      data-tab="almanac"
    >
      黄历
    </view>
    <view
      class="calendar-tab {{activeTab === 'festival' ? 'active' : ''}}"
      bindtap="onTabChange"
      data-tab="festival"
    >
      节日
    </view>
  </view>
</view>

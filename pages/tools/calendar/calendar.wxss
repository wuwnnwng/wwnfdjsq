@import "../tool-common.wxss";

.calendar-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.calendar-bottom-space {
  height: 24rpx;
}

.calendar-panel {
  margin-top: 0;
}

.calendar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month-nav {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--color-brand-soft);
}

.month-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.today-link {
  margin-top: 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-brand-soft);
}

.week-row,
.day-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.week-row {
  margin-top: 24rpx;
}

.week-cell {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-muted);
}

.day-grid {
  margin-top: 12rpx;
}

.day-cell {
  min-height: 108rpx;
  padding: 8rpx 4rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.45);
  border: 1rpx solid transparent;
  box-sizing: border-box;
}

.day-cell.other-month {
  opacity: 0.35;
}

.day-cell.today .day-num {
  color: var(--color-accent);
}

.day-cell.selected {
  background: rgba(31, 107, 82, 0.14);
  border-color: var(--color-brand-soft);
}

.day-cell.auspicious {
  background: rgba(31, 107, 82, 0.18);
  border-color: rgba(31, 107, 82, 0.35);
}

.day-num {
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.day-lunar {
  margin-top: 4rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--color-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.day-tag {
  margin-top: 4rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--color-accent);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.auspicious-panel {
  margin-top: 20rpx;
}

.auspicious-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title-inline {
  margin-bottom: 0;
}

.auspicious-current {
  font-size: 26rpx;
  color: var(--color-brand-soft);
}

.auspicious-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
}

.auspicious-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.auspicious-tag {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-ink);
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--color-line);
}

.auspicious-tag.active {
  color: #fff;
  background: var(--color-brand-soft);
  border-color: var(--color-brand-soft);
}

.detail-panel,
.huangli-panel,
.festival-panel {
  margin-top: 20rpx;
}

.detail-solar {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.detail-lunar {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--color-brand);
}

.detail-meta,
.detail-term,
.huangli-lunar,
.huangli-meta,
.huangli-term {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.yi-ji-block {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-line);
}

.yi-ji-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 16rpx;
}

.yi-ji-row:first-child {
  margin-top: 0;
}

.yi-ji-label {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}

.yi-ji-label.yi {
  background: var(--color-brand-soft);
}

.yi-ji-label.ji {
  background: var(--color-accent);
}

.yi-ji-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-ink);
}

.huangli-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.huangli-date {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.huangli-yiji {
  margin-top: 28rpx;
}

.huangli-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-line);
}

.huangli-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.huangli-section-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-muted);
}

.jianchu-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12rpx;
  margin-top: 20rpx;
}

.jianchu-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid var(--color-line);
}

.jianchu-item.active {
  background: rgba(31, 107, 82, 0.16);
  border-color: var(--color-brand-soft);
}

.jianchu-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.jianchu-item.active .jianchu-name {
  color: var(--color-brand);
}

.hour-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.hour-item {
  position: relative;
  padding: 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--color-line);
  background: rgba(255, 255, 255, 0.55);
}

.hour-item.lucky {
  border-color: rgba(31, 107, 82, 0.25);
}

.hour-item.unlucky {
  border-color: rgba(196, 92, 38, 0.2);
}

.hour-item.now {
  box-shadow: 0 0 0 2rpx var(--color-brand-soft);
}

.hour-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.hour-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.hour-luck {
  font-size: 24rpx;
  font-weight: 700;
}

.hour-item.lucky .hour-luck {
  color: var(--color-brand-soft);
}

.hour-item.unlucky .hour-luck {
  color: var(--color-accent);
}

.hour-range,
.hour-deity {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.hour-now-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: #fff;
  background: var(--color-brand-soft);
}

.huangli-card {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.55);
}

.huangli-card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-brand);
}

.huangli-card-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--color-muted);
}

.festival-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.festival-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-brand);
  margin-bottom: 0;
}

.festival-section-arrow {
  font-size: 20rpx;
  color: var(--color-brand-soft);
}

.festival-source-note {
  margin-top: 12rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.festival-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.festival-item:last-child {
  border-bottom: none;
}

.festival-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.festival-desc,
.festival-note {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

.calendar-tabs {
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  border-top: 1rpx solid var(--color-line);
  background: var(--color-footer);
  padding-bottom: env(safe-area-inset-bottom);
}

.calendar-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0 20rpx;
  font-size: 28rpx;
  color: var(--color-muted);
}

.calendar-tab.active {
  color: var(--color-brand);
  font-weight: 700;
  position: relative;
}

.calendar-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 48rpx;
  height: 6rpx;
  margin-left: -24rpx;
  border-radius: 999rpx;
  background: var(--color-brand-soft);
}

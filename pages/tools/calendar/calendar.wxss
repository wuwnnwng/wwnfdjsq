@import "../tool-common.wxss";

.calendar-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.calendar-bottom-space {
  height: 24rpx;
}

.calendar-panel {
  margin-top: 0;
}

.calendar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.month-nav {
  position: relative;
  z-index: 10;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 48rpx;
  color: var(--color-brand);
}

.month-nav-hover {
  opacity: 0.55;
}

.month-title-wrap {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 8rpx 12rpx;
}

.month-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-ink);
  text-align: center;
  line-height: 1.3;
}

.month-sub {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-muted);
  text-align: center;
  line-height: 1.35;
}

.month-title-wrap:active {
  opacity: 0.75;
}

.date-picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
  background: var(--color-mask);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.date-picker-sheet {
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  background: var(--color-dialog);
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.date-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 28rpx 4rpx;
}

.date-picker-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.date-picker-action {
  min-width: 88rpx;
  padding: 16rpx 8rpx;
  font-size: 28rpx;
  color: var(--color-muted);
}

.date-picker-action.confirm {
  color: var(--color-brand);
  font-weight: 700;
  text-align: right;
}

.date-picker-cal-wrap {
  display: flex;
  justify-content: center;
  margin: 8rpx 28rpx 4rpx;
}

.date-picker-cal-seg {
  display: flex;
  padding: 4rpx;
  border-radius: 999rpx;
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.date-picker-cal-item {
  min-width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-muted);
}

.date-picker-cal-item.active {
  color: var(--color-on-brand);
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
}

.date-picker-hint {
  margin: 8rpx 28rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.4;
}

.date-picker-view {
  width: 100%;
  height: 440rpx;
}

.date-picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  font-size: 32rpx;
  color: var(--color-ink);
}

.calendar-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.today-link,
.auspicious-link {
  font-size: 24rpx;
  color: var(--color-brand-soft);
  line-height: 1.4;
}

.auspicious-link {
  flex-shrink: 0;
  max-width: 58%;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auspicious-link.active {
  font-weight: 600;
}

.auspicious-arrow {
  margin-left: 6rpx;
  font-size: 20rpx;
}

.auspicious-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.auspicious-tags {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 0 8rpx;
}

.auspicious-tag {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-ink);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.auspicious-tag.active {
  color: var(--color-on-brand);
  background: var(--color-brand-soft);
  border-color: var(--color-brand-soft);
}

.auspicious-note {
  margin-top: 8rpx;
}

.week-row,
.day-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.calendar-swipe {
  margin-top: 24rpx;
}

.week-cell {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-muted);
}

.day-grid {
  margin-top: 12rpx;
}

.day-cell {
  position: relative;
  min-height: 80rpx;
  padding: 10rpx 4rpx;
  border-radius: 16rpx;
  background: var(--color-soft);
  border: 1rpx solid transparent;
  box-sizing: border-box;
}

.day-mark {
  position: absolute;
  top: 2rpx;
  right: 4rpx;
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1.2;
}

.day-mark.rest {
  color: var(--color-accent);
}

.day-mark.work {
  color: var(--color-muted);
}

.day-cell.other-month {
  opacity: 0.35;
}

.day-cell.today .day-num {
  color: var(--color-accent);
}

.day-cell.selected {
  background: rgba(31, 107, 82, 0.14);
  border-color: var(--color-brand-soft);
}

.day-cell.auspicious {
  background: rgba(31, 107, 82, 0.18);
  border-color: rgba(31, 107, 82, 0.35);
}

.day-num {
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.day-tag {
  margin-top: 4rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--color-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.day-tag.festival {
  color: var(--color-accent);
}

.detail-panel,
.huangli-panel,
.festival-panel {
  margin-top: 20rpx;
}

.detail-lunar,
.detail-meta,
.detail-term {
  font-weight: 700;
  color: var(--color-ink);
}

.detail-lunar {
  font-size: 30rpx;
  line-height: 1.5;
}

.detail-meta,
.detail-term {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.huangli-lunar,
.huangli-meta,
.huangli-term,
.huangli-ganzhi {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.detail-panel .yi-ji-item {
  font-weight: 700;
}

.yi-ji-block {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-line);
}

.yi-ji-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 16rpx;
}

.yi-ji-row:first-child {
  margin-top: 0;
}

.yi-ji-label {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}

.yi-ji-label.yi {
  background: var(--color-brand-soft);
}

.yi-ji-label.ji {
  background: var(--color-accent);
}

.yi-ji-text {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx 20rpx;
  min-width: 0;
}

.yi-ji-item {
  font-size: 26rpx;
  line-height: 1.4;
  color: var(--color-ink);
}

.yi-ji-item.ji {
  color: var(--color-ink);
}

.huangli-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.huangli-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.help-icon {
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid rgba(95, 114, 104, 0.55);
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 700;
}

.tip-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1300;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: var(--color-mask);
}

.tip-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background: var(--color-dialog);
  box-shadow: 0 24rpx 60rpx var(--color-shadow-strong);
}

.tip-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-brand);
  text-align: center;
}

.tip-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--color-muted);
}

.tip-single {
  margin-top: 24rpx;
  text-align: center;
}

.tip-confirm {
  margin-top: 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-on-brand);
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
}

.huangli-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.huangli-head-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 12rpx;
}

.huangli-head-main:active {
  opacity: 0.75;
}

.huangli-date-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-ink);
  line-height: 1.3;
}

.huangli-today-badge {
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--color-on-brand);
  background: var(--color-brand-soft);
}

.huangli-date-sub {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-muted);
  text-align: center;
  line-height: 1.35;
}

.huangli-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.huangli-ganzhi {
  margin-top: 16rpx;
  text-align: center;
}

.huangli-term {
  text-align: center;
}

.huangli-yiji {
  margin-top: 28rpx;
}

.hl-glance {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}

.hl-glance-card {
  min-height: 148rpx;
  padding: 20rpx 18rpx;
  border-radius: 16rpx;
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
  box-sizing: border-box;
}

.hl-glance-label {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-muted);
  letter-spacing: 0.04em;
}

.hl-glance-value {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-ink);
  line-height: 1.35;
}

.hl-glance-value-sm {
  font-size: 26rpx;
}

.hl-glance-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: var(--color-muted);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.hl-glance-sub.good,
.hour-now-luck.good {
  color: var(--color-brand-soft);
  font-weight: 700;
}

.hl-glance-sub.bad,
.hour-now-luck.bad {
  color: var(--color-accent);
  font-weight: 700;
}

.hl-block {
  margin-top: 24rpx;
  padding: 20rpx 18rpx;
  border-radius: 16rpx;
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.hl-block-label {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-muted);
}

.hl-block-line {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-ink);
  line-height: 1.5;
}

.hour-now-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.hour-now-main {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.hour-now-luck {
  flex-shrink: 0;
  font-size: 22rpx;
}

.hour-chips {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10rpx;
  margin-top: 16rpx;
}

.hour-chip {
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-ink);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.hour-chip.lucky {
  color: var(--color-brand-soft);
  border-color: rgba(31, 107, 82, 0.25);
}

.hour-chip.unlucky {
  color: var(--color-accent);
  border-color: rgba(196, 92, 38, 0.2);
}

.hour-chip.now {
  box-shadow: 0 0 0 2rpx var(--color-brand-soft);
}

.hl-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.hl-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.hl-tag.good {
  color: var(--color-brand-soft);
  background: var(--color-soft);
  border: 1rpx solid rgba(31, 107, 82, 0.22);
}

.hl-tag.bad {
  color: var(--color-accent);
  background: var(--color-soft);
  border: 1rpx solid rgba(196, 92, 38, 0.18);
}

.hl-empty {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.hl-footnote {
  margin-top: 28rpx;
  font-size: 20rpx;
  line-height: 1.55;
  color: var(--color-muted);
}

.huangli-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-line);
}

.huangli-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.huangli-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-brand);
  margin-bottom: 0;
}

.huangli-section-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-muted);
}

.jianchu-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12rpx;
  margin-top: 20rpx;
}

.jianchu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-height: 88rpx;
  padding: 8rpx 0;
  border-radius: 14rpx;
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.jianchu-item.active {
  background: rgba(31, 107, 82, 0.16);
  border-color: var(--color-brand-soft);
}

.jianchu-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.jianchu-luck {
  font-size: 20rpx;
  color: var(--color-muted);
}

.jianchu-item.lucky .jianchu-luck {
  color: #1f6b52;
}

.jianchu-item.unlucky .jianchu-luck {
  color: #b42318;
}

.jianchu-item.active .jianchu-name {
  color: var(--color-brand);
}

.hour-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.hour-item {
  position: relative;
  padding: 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--color-line);
  background: var(--color-soft);
}

.hour-item.lucky {
  border-color: rgba(31, 107, 82, 0.25);
}

.hour-item.unlucky {
  border-color: rgba(196, 92, 38, 0.2);
}

.hour-item.now {
  box-shadow: 0 0 0 2rpx var(--color-brand-soft);
  padding-bottom: 48rpx;
}

.hour-now-tag {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: var(--color-on-brand);
  background: var(--color-brand-soft);
}

.hour-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.hour-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.hour-luck {
  font-size: 24rpx;
  font-weight: 700;
}

.hour-item.lucky .hour-luck {
  color: var(--color-brand-soft);
}

.hour-item.unlucky .hour-luck {
  color: var(--color-accent);
}

.hour-range,
.hour-deity {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.festival-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.festival-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-brand);
  margin-bottom: 0;
}

.festival-section-arrow {
  font-size: 20rpx;
  color: var(--color-brand-soft);
}

.festival-source-note {
  margin-top: 12rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.festival-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.festival-item-main {
  flex: 1;
  min-width: 0;
}

.festival-countdown {
  flex-shrink: 0;
  min-width: 96rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-brand-soft);
  text-align: center;
  line-height: 1.4;
}

.festival-countdown.past {
  color: var(--color-muted);
  font-weight: 500;
}

.festival-countdown.now {
  color: var(--color-accent);
}

.festival-item:last-child {
  border-bottom: none;
}

.festival-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.festival-desc,
.festival-note {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

.calendar-tabs {
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  border-top: 1rpx solid var(--color-line);
  background: var(--color-footer);
  padding-bottom: env(safe-area-inset-bottom);
}

.calendar-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0 20rpx;
  font-size: 28rpx;
  color: var(--color-muted);
}

.calendar-tab.active {
  color: var(--color-brand);
  font-weight: 700;
  position: relative;
}

.calendar-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 48rpx;
  height: 6rpx;
  margin-left: -24rpx;
  border-radius: 999rpx;
  background: var(--color-brand-soft);
}

@import "../tool-common.wxss";
@import "../calc-kit.wxss";

.conv-hero {
  background:
    linear-gradient(160deg, rgba(251, 146, 60, 0.16) 0%, var(--color-hero-fade) 58%),
    var(--color-surface);
}

.tool-icon-chance {
  background: linear-gradient(135deg, #ffedd5, #fb923c);
}

.stage {
  margin: 20rpx 0 8rpx;
  min-height: 460rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.cup-well {
  position: relative;
  width: 440rpx;
  height: 440rpx;
  overflow: visible;
  transition: width 0.42s cubic-bezier(0.22, 0.9, 0.32, 1);
}

.stage.is-open .cup-well {
  width: 640rpx;
}

.cup-well.is-shake {
  animation: cup-shake 1.12s ease-in-out;
}

.cup-bowl {
  position: absolute;
  z-index: 1;
  left: 50%;
  top: 50%;
  width: 340rpx;
  height: 340rpx;
  margin: -170rpx 0 0 -170rpx;
  box-sizing: border-box;
  border-radius: 50%;
  overflow: hidden;
  border: 40rpx solid #4a1c14;
  background:
    radial-gradient(circle at 50% 42%, #1d6b3a 0%, #14532d 52%, #052e16 100%);
  box-shadow:
    inset 0 10rpx 18rpx rgba(0, 0, 0, 0.28),
    0 16rpx 28rpx rgba(0, 0, 0, 0.22);
  transition: transform 0.42s cubic-bezier(0.22, 0.9, 0.32, 1);
}

.cup-bowl.is-open {
  transform: translateX(-152rpx);
}

.dice-pad {
  width: 100%;
  height: 100%;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  align-content: center;
  gap: 10rpx;
  padding: 4rpx;
  box-sizing: border-box;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.stage.is-open .dice-pad {
  opacity: 1;
}

.die {
  width: 68rpx;
  height: 68rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  gap: 4rpx;
  background: linear-gradient(160deg, #fff7ed, #fed7aa);
  box-shadow:
    inset 0 -6rpx 0 rgba(194, 65, 12, 0.12),
    0 8rpx 16rpx rgba(0, 0, 0, 0.18);
}

.dice-pad.count-1 .die {
  width: 118rpx;
  height: 118rpx;
  padding: 14rpx;
  border-radius: 22rpx;
  gap: 8rpx;
}

.dice-pad.count-2 .die {
  width: 92rpx;
  height: 92rpx;
  padding: 12rpx;
  border-radius: 18rpx;
}

.dice-pad.count-3 .die {
  width: 72rpx;
  height: 72rpx;
  padding: 8rpx;
  border-radius: 16rpx;
}

.pip {
  width: 12rpx;
  height: 12rpx;
  margin: auto;
  border-radius: 50%;
  background: transparent;
}

.dice-pad.count-1 .pip {
  width: 18rpx;
  height: 18rpx;
}

.dice-pad.count-2 .pip {
  width: 16rpx;
  height: 16rpx;
}

.pip.on {
  background: #7c2d12;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.25);
}

.cup-lid {
  position: absolute;
  z-index: 4;
  left: 50%;
  top: 50%;
  width: 368rpx;
  height: 368rpx;
  margin: -184rpx 0 0 -184rpx;
  transition: transform 0.42s cubic-bezier(0.22, 0.9, 0.32, 1);
}

.cup-lid.is-open {
  transform: translate(168rpx, -8rpx) rotate(10deg);
}

.cup-lid-face {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  background:
    radial-gradient(circle at 34% 28%, #8b3a2a 0%, #4a1c14 48%, #230c09 100%);
  box-shadow:
    inset 0 14rpx 18rpx rgba(255, 255, 255, 0.12),
    inset 0 -16rpx 20rpx rgba(0, 0, 0, 0.35),
    0 18rpx 30rpx rgba(0, 0, 0, 0.32);
}

.cup-lid-ring {
  position: absolute;
  inset: 22rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(201, 162, 39, 0.55);
}

.cup-lid-knob {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 72rpx;
  height: 72rpx;
  margin: -36rpx 0 0 -36rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #e4c35a, #8a5a12);
  box-shadow:
    inset 0 8rpx 0 rgba(255, 255, 255, 0.35),
    0 8rpx 12rpx rgba(0, 0, 0, 0.28);
}

@keyframes cup-shake {
  0%,
  100% {
    transform: rotate(0deg) translateX(0);
  }
  18% {
    transform: rotate(-16deg) translateX(-18rpx) translateY(-8rpx);
  }
  40% {
    transform: rotate(14deg) translateX(16rpx) translateY(-4rpx);
  }
  62% {
    transform: rotate(-10deg) translateX(-12rpx) translateY(-10rpx);
  }
  82% {
    transform: rotate(8deg) translateX(8rpx);
  }
}

.token-scene {
  width: 248rpx;
  height: 248rpx;
  perspective: 900rpx;
}

.token {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
}

.token.heads {
  transform: rotateY(0deg);
}

.token.tails {
  transform: rotateY(180deg);
}

.token.is-flip.will-heads {
  animation: token-to-heads 0.76s ease-in-out both;
}

.token.is-flip.will-tails {
  animation: token-to-tails 0.76s ease-in-out both;
}

.token-side {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  overflow: hidden;
}

.token-tails {
  transform: rotateY(180deg);
}

.token-rim {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.token-heads .token-rim {
  background: repeating-conic-gradient(
    #ea580c 0deg 10deg,
    #fdba74 10deg 16deg,
    #9a3412 16deg 22deg,
    #fb923c 22deg 28deg
  );
}

.token-tails .token-rim {
  background: repeating-conic-gradient(
    #0e7490 0deg 10deg,
    #67e8f9 10deg 16deg,
    #155e75 16deg 22deg,
    #22d3ee 22deg 28deg
  );
}

.token-plate {
  position: absolute;
  inset: 22rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.token-heads .token-plate {
  background:
    radial-gradient(circle at 32% 28%, #fff7ed, #fb923c 58%, #c2410c 100%);
  box-shadow:
    inset 0 0 0 8rpx rgba(154, 52, 18, 0.35),
    inset 0 -10rpx 16rpx rgba(124, 45, 18, 0.28);
}

.token-tails .token-plate {
  background:
    radial-gradient(circle at 32% 28%, #ecfeff, #22d3ee 58%, #0e7490 100%);
  box-shadow:
    inset 0 0 0 8rpx rgba(14, 116, 144, 0.38),
    inset 0 -10rpx 16rpx rgba(21, 94, 117, 0.28);
}

.token-ring {
  position: absolute;
  inset: 16rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.42);
}

.token-mark {
  position: relative;
  z-index: 1;
  font-size: 92rpx;
  font-weight: 800;
  line-height: 1;
  color: rgba(255, 255, 255, 0.96);
  text-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.28);
}

@keyframes token-to-heads {
  0% {
    transform: rotateY(0deg) scale(1);
  }
  42% {
    transform: rotateY(720deg) scale(1.08);
  }
  100% {
    transform: rotateY(1440deg) scale(1);
  }
}

@keyframes token-to-tails {
  0% {
    transform: rotateY(0deg) scale(1);
  }
  42% {
    transform: rotateY(720deg) scale(1.08);
  }
  100% {
    transform: rotateY(1620deg) scale(1);
  }
}

.count-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.count-label {
  font-size: 26rpx;
  color: var(--color-muted);
}

.count-stepper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.count-step {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-ink);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.count-step.is-off {
  opacity: 0.38;
}

.count-input {
  width: 88rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
}

.action-row {
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}

.action-row .primary-btn,
.lid-btn {
  margin-top: 0;
  width: 100%;
  box-sizing: border-box;
}

.lid-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  min-height: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-brand);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.lid-btn::after,
.primary-btn::after {
  border: none;
}

.primary-btn[disabled],
.lid-btn[disabled] {
  opacity: 0.55;
}

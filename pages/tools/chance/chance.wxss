@import "../tool-common.wxss";
@import "../calc-kit.wxss";

.conv-hero {
  background:
    linear-gradient(160deg, rgba(251, 146, 60, 0.16) 0%, var(--color-hero-fade) 58%),
    var(--color-surface);
}

.tool-icon-chance {
  background: linear-gradient(135deg, #ffedd5, #fb923c);
}

.stage {
  margin: 20rpx 0 8rpx;
  min-height: 460rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.cup-well {
  position: relative;
  width: 440rpx;
  height: 440rpx;
}

.cup-well.is-shake {
  animation: cup-shake 1.12s ease-in-out;
}

.cup-bowl {
  position: absolute;
  z-index: 1;
  left: 50%;
  top: 50%;
  width: 340rpx;
  height: 340rpx;
  margin: -170rpx 0 0 -170rpx;
  box-sizing: border-box;
  border-radius: 50%;
  overflow: hidden;
  border: 40rpx solid #4a1c14;
  background:
    radial-gradient(circle at 50% 42%, #1d6b3a 0%, #14532d 52%, #052e16 100%);
  box-shadow:
    inset 0 10rpx 18rpx rgba(0, 0, 0, 0.28),
    0 16rpx 28rpx rgba(0, 0, 0, 0.22);
}

.dice-pad {
  width: 100%;
  height: 100%;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  align-content: center;
  gap: 10rpx;
  padding: 4rpx;
  box-sizing: border-box;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.stage.is-open .dice-pad {
  opacity: 1;
}

.die {
  width: 68rpx;
  height: 68rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  gap: 4rpx;
  background: linear-gradient(160deg, #fff7ed, #fed7aa);
  box-shadow:
    inset 0 -6rpx 0 rgba(194, 65, 12, 0.12),
    0 8rpx 16rpx rgba(0, 0, 0, 0.18);
}

.dice-pad.count-1 .die {
  width: 118rpx;
  height: 118rpx;
  padding: 14rpx;
  border-radius: 22rpx;
  gap: 8rpx;
}

.dice-pad.count-2 .die {
  width: 92rpx;
  height: 92rpx;
  padding: 12rpx;
  border-radius: 18rpx;
}

.dice-pad.count-3 .die {
  width: 72rpx;
  height: 72rpx;
  padding: 8rpx;
  border-radius: 16rpx;
}

.pip {
  width: 12rpx;
  height: 12rpx;
  margin: auto;
  border-radius: 50%;
  background: transparent;
}

.dice-pad.count-1 .pip {
  width: 18rpx;
  height: 18rpx;
}

.dice-pad.count-2 .pip {
  width: 16rpx;
  height: 16rpx;
}

.pip.on {
  background: #7c2d12;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.25);
}

.cup-lid {
  position: absolute;
  z-index: 4;
  left: 50%;
  top: 50%;
  width: 368rpx;
  height: 368rpx;
  margin: -184rpx 0 0 -184rpx;
  transition: transform 0.42s cubic-bezier(0.22, 0.9, 0.32, 1);
}

.cup-lid.is-open {
  transform: translate(210rpx, -36rpx) rotate(26deg);
}

.cup-lid-face {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  background:
    radial-gradient(circle at 34% 28%, #8b3a2a 0%, #4a1c14 48%, #230c09 100%);
  box-shadow:
    inset 0 14rpx 18rpx rgba(255, 255, 255, 0.12),
    inset 0 -16rpx 20rpx rgba(0, 0, 0, 0.35),
    0 18rpx 30rpx rgba(0, 0, 0, 0.32);
}

.cup-lid-ring {
  position: absolute;
  inset: 22rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(201, 162, 39, 0.55);
}

.cup-lid-knob {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 72rpx;
  height: 72rpx;
  margin: -36rpx 0 0 -36rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #e4c35a, #8a5a12);
  box-shadow:
    inset 0 8rpx 0 rgba(255, 255, 255, 0.35),
    0 8rpx 12rpx rgba(0, 0, 0, 0.28);
}

@keyframes cup-shake {
  0%,
  100% {
    transform: rotate(0deg) translateX(0);
  }
  18% {
    transform: rotate(-16deg) translateX(-18rpx) translateY(-8rpx);
  }
  40% {
    transform: rotate(14deg) translateX(16rpx) translateY(-4rpx);
  }
  62% {
    transform: rotate(-10deg) translateX(-12rpx) translateY(-10rpx);
  }
  82% {
    transform: rotate(8deg) translateX(8rpx);
  }
}

.coin-scene {
  width: 248rpx;
  height: 248rpx;
  perspective: 900rpx;
}

.yuan {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
}

.yuan.heads {
  transform: rotateY(0deg);
}

.yuan.tails {
  transform: rotateY(180deg);
}

.yuan.is-flip.will-heads {
  animation: yuan-to-heads 0.76s ease-in-out both;
}

.yuan.is-flip.will-tails {
  animation: yuan-to-tails 0.76s ease-in-out both;
}

.yuan-side {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  overflow: hidden;
}

.yuan-reverse {
  transform: rotateY(180deg);
}

.yuan-reed {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: repeating-conic-gradient(
    #9aa3ad 0deg 5deg,
    #e8eef2 5deg 7deg,
    #7b848c 7deg 9deg,
    #c5ccd3 9deg 14deg
  );
}

.yuan-plate {
  position: absolute;
  inset: 12rpx;
  border-radius: 50%;
  overflow: hidden;
  background:
    radial-gradient(circle at 32% 28%, #f4f7f9, #c5ccd4 54%, #8e969e 100%);
  box-shadow:
    inset 0 0 0 6rpx rgba(148, 157, 167, 0.55),
    inset 0 -10rpx 16rpx rgba(71, 85, 105, 0.28);
}

.yuan-ring {
  position: absolute;
  inset: 10rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(71, 85, 105, 0.28);
}

.yuan-flower {
  position: absolute;
  left: 50%;
  top: 46rpx;
  width: 108rpx;
  height: 108rpx;
  margin-left: -54rpx;
}

.yuan-petal {
  position: absolute;
  left: 50%;
  top: 0;
  width: 22rpx;
  height: 50rpx;
  margin-left: -11rpx;
  border-radius: 50% 50% 42% 42%;
  background: linear-gradient(180deg, #eef2f5, #9aa3ad);
  box-shadow: inset 0 0 0 2rpx rgba(71, 85, 105, 0.22);
  transform-origin: 50% 92%;
}

.yuan-center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  margin: -14rpx 0 0 -14rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #d9dee3, #6b7280);
}

.yuan-denom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 28rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
  color: #334155;
}

.yuan-num {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.yuan-unit {
  font-size: 26rpx;
  font-weight: 700;
}

.yuan-emblem {
  position: absolute;
  left: 50%;
  top: 36rpx;
  width: 108rpx;
  height: 108rpx;
  margin-left: -54rpx;
}

.yuan-emblem-gear {
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  border: 8rpx dotted rgba(71, 85, 105, 0.55);
}

.yuan-emblem-gate {
  position: absolute;
  left: 50%;
  top: 54rpx;
  width: 54rpx;
  height: 28rpx;
  margin-left: -27rpx;
  border-radius: 4rpx 4rpx 2rpx 2rpx;
  background: linear-gradient(180deg, #94a3b8, #64748b);
  box-shadow: inset 8rpx 0 0 rgba(51, 65, 85, 0.25), inset -8rpx 0 0 rgba(51, 65, 85, 0.25);
}

.yuan-star {
  position: absolute;
  color: #475569;
  line-height: 1;
}

.yuan-star-main {
  left: 50%;
  top: 18rpx;
  margin-left: -12rpx;
  font-size: 24rpx;
}

.yuan-star-a,
.yuan-star-b,
.yuan-star-c,
.yuan-star-d {
  font-size: 12rpx;
}

.yuan-star-a {
  left: 22rpx;
  top: 28rpx;
}

.yuan-star-b {
  left: 18rpx;
  top: 44rpx;
}

.yuan-star-c {
  right: 22rpx;
  top: 28rpx;
}

.yuan-star-d {
  right: 18rpx;
  top: 44rpx;
}

.yuan-caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 46rpx;
  text-align: center;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #334155;
}

.yuan-year {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 22rpx;
  text-align: center;
  font-size: 16rpx;
  font-weight: 700;
  color: #475569;
}

@keyframes yuan-to-heads {
  0% {
    transform: rotateY(0deg) scale(1);
  }
  42% {
    transform: rotateY(720deg) scale(1.08);
  }
  100% {
    transform: rotateY(1440deg) scale(1);
  }
}

@keyframes yuan-to-tails {
  0% {
    transform: rotateY(0deg) scale(1);
  }
  42% {
    transform: rotateY(720deg) scale(1.08);
  }
  100% {
    transform: rotateY(1620deg) scale(1);
  }
}

.count-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.count-label {
  font-size: 26rpx;
  color: var(--color-muted);
}

.count-stepper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.count-step {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-ink);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.count-step.is-off {
  opacity: 0.38;
}

.count-input {
  width: 88rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
}

.action-row {
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}

.action-row .primary-btn,
.lid-btn {
  margin-top: 0;
  width: 100%;
  box-sizing: border-box;
}

.lid-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  min-height: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-brand);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.lid-btn::after,
.primary-btn::after {
  border: none;
}

.primary-btn[disabled],
.lid-btn[disabled] {
  opacity: 0.55;
}

@import "../tool-common.wxss";
@import "../calc-kit.wxss";

.conv-hero {
  background:
    linear-gradient(160deg, rgba(251, 146, 60, 0.16) 0%, var(--color-hero-fade) 58%),
    var(--color-surface);
}

.tool-icon-chance {
  background: linear-gradient(135deg, #ffedd5, #fb923c);
}

.stage {
  margin: 28rpx 0 8rpx;
  min-height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dice-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.die {
  width: 148rpx;
  height: 148rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  gap: 10rpx;
  background: linear-gradient(160deg, #fff7ed, #fed7aa);
  box-shadow:
    inset 0 -8rpx 0 rgba(194, 65, 12, 0.12),
    0 12rpx 24rpx rgba(0, 0, 0, 0.18);
}

.pip {
  width: 22rpx;
  height: 22rpx;
  margin: auto;
  border-radius: 50%;
  background: transparent;
}

.pip.on {
  background: #7c2d12;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.25);
}

.coin {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.22);
}

.coin.heads {
  background: radial-gradient(circle at 32% 28%, #fde68a, #f59e0b 54%, #b45309);
}

.coin.tails {
  background: radial-gradient(circle at 32% 28%, #e2e8f0, #94a3b8 54%, #475569);
}

.coin-face {
  font-size: 72rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.18);
}

.stage.is-shake .die {
  animation: die-shake 0.7s ease-in-out;
}

.stage.is-flip .coin {
  animation: coin-flip 0.72s ease-in-out;
}

@keyframes die-shake {
  0%,
  100% {
    transform: rotate(0deg) translateY(0);
  }
  20% {
    transform: rotate(-14deg) translateY(-8rpx);
  }
  45% {
    transform: rotate(12deg) translateY(-4rpx);
  }
  70% {
    transform: rotate(-8deg) translateY(-10rpx);
  }
}

@keyframes coin-flip {
  0% {
    transform: rotateY(0deg);
  }
  50% {
    transform: rotateY(540deg) scale(1.06);
  }
  100% {
    transform: rotateY(1080deg);
  }
}

.count-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.count-label {
  font-size: 26rpx;
  color: var(--color-muted);
}

.count-pills {
  display: flex;
  gap: 12rpx;
}

.count-pill {
  min-width: 88rpx;
  height: 56rpx;
  padding: 0 18rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-muted);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.count-pill.active {
  color: var(--color-on-brand);
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  border-color: transparent;
}

.history-panel {
  margin-bottom: 24rpx;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.history-clear {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-accent);
}

.history-clear.is-off {
  opacity: 0.4;
}

.history-empty {
  padding: 12rpx 0 4rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--color-muted);
}

.history-row {
  display: grid;
  grid-template-columns: 140rpx 1fr auto;
  gap: 12rpx;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.history-row:last-child {
  border-bottom: none;
}

.history-kind {
  font-size: 24rpx;
  color: var(--color-muted);
}

.history-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.history-time {
  font-size: 22rpx;
  color: var(--color-muted);
}

.primary-btn[disabled] {
  opacity: 0.55;
}

<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-compound">
            <text class="tool-icon">📈</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">本金 · 利率 · 时间</view>
            <view class="conv-title">复利计算器</view>
          </view>
        </view>
      </view>
      <block wx:if="{{result && result.valid}}">
        <view class="conv-eq">{{result.formulaText}}</view>
        <view class="conv-result">{{result.heroText}}</view>
        <view class="conv-result-unit">利息 {{result.interestText}} 元 · 累计投入 {{result.contributedText}} 元</view>
      </block>
      <view class="tool-note warn" wx:elif="{{result && !result.valid}}">{{result.message}}</view>
    </view>

    <view class="panel">
      <view class="field">
        <text class="field-label">本金</text>
        <view class="field-control">
          <input class="field-input" type="digit" value="{{principal}}" data-field="principal" bindinput="onInput" placeholder="例如 100000" />
          <text class="field-unit">元</text>
        </view>
      </view>
      <view class="field">
        <text class="field-label">年利率</text>
        <view class="field-control">
          <input class="field-input" type="digit" value="{{rate}}" data-field="rate" bindinput="onInput" placeholder="例如 4" />
          <text class="field-unit">%</text>
        </view>
      </view>
      <view class="field">
        <text class="field-label">投资年限</text>
        <view class="field-control">
          <input class="field-input" type="digit" value="{{years}}" data-field="years" bindinput="onInput" placeholder="例如 10" />
          <text class="field-unit">年</text>
        </view>
      </view>
      <view class="field">
        <text class="field-label">每月追加</text>
        <view class="field-control">
          <input class="field-input" type="digit" value="{{monthly}}" data-field="monthly" bindinput="onInput" placeholder="没有可填 0" />
          <text class="field-unit">元</text>
        </view>
      </view>
      <view class="field field-stack">
        <text class="field-label">复利频率</text>
        <view class="seg-row cols-4 field-seg">
          <view
            wx:for="{{frequencies}}"
            wx:key="key"
            class="seg-item {{frequencyKey === item.key ? 'active' : ''}}"
            bindtap="onSelectFrequency"
            data-key="{{item.key}}"
          >
            {{item.name}}
          </view>
        </view>
      </view>
      <view class="tool-note">到期本息按所选频率复利滚存。每月追加会折算到每个计息期再加入本金。</view>
    </view>

    <view class="panel" wx:if="{{result && result.valid}}">
      <view class="section-title">收益明细</view>
      <view class="result-row">
        <view class="result-row-label">期初本金</view>
        <view class="result-row-value">{{result.principalText}} 元</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">追加投入</view>
        <view class="result-row-value">{{result.monthlyTotalText}} 元</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">累计投入</view>
        <view class="result-row-value">{{result.contributedText}} 元</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">利息收入</view>
        <view class="result-row-value">{{result.interestText}} 元</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">到期本息</view>
        <view class="result-row-value">{{result.heroText}} 元</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">相对投入</view>
        <view class="result-row-value">{{result.multipleText}} · 收益 {{result.growthText}}</view>
      </view>
    </view>

    <view class="panel" wx:if="{{result && result.valid && result.yearsRows.length}}">
      <view class="section-title">逐年余额</view>
      <view class="result-row" wx:for="{{result.yearsRows}}" wx:key="year">
        <view class="result-row-label">{{item.yearText}}</view>
        <view class="result-row-value">{{item.balanceText}} 元</view>
      </view>
    </view>
  </scroll-view>
</view>

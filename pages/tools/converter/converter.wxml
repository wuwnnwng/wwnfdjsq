<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-{{iconType}}">
            <text class="tool-icon">{{icon}}</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">{{kicker}}</view>
            <view class="conv-title">{{title}}</view>
          </view>
        </view>
        <view class="conv-refresh" wx:if="{{type === 'currency'}}" bindtap="onRefreshRates">刷新</view>
      </view>

      <view class="conv-eq" wx:if="{{formulaText}}">{{formulaText}}</view>
      <view class="conv-result">{{resultValue || '—'}}</view>
      <view class="conv-result-unit">{{toName || '选择单位'}}</view>

      <view class="conv-meta" wx:if="{{type === 'currency'}}">
        <text wx:if="{{publishedAt}}">汇率日期 {{publishedAt}}</text>
        <text wx:if="{{publishedAt && unitCount}}"> · </text>
        <text wx:if="{{unitCount}}">{{unitCount}} 种货币</text>
      </view>
      <view class="tool-note" wx:if="{{type === 'currency' && rateLoading}}">正在获取最新汇率…</view>
      <view class="tool-note warn" wx:if="{{type === 'currency' && rateError}}">{{rateError}}</view>
    </view>

    <view class="panel conv-board">
      <view class="unit-tabs" wx:if="{{type !== 'currency'}}">
        <view
          wx:for="{{unitTabs}}"
          wx:key="id"
          class="unit-tab {{type === item.id ? 'active' : ''}}"
          bindtap="onSwitchUnitType"
          data-type="{{item.id}}"
        >
          {{item.name}}
        </view>
      </view>
      <view class="conv-card">
        <view class="conv-card-label">从</view>
        <view
          wx:if="{{type === 'currency'}}"
          class="conv-unit-btn"
          bindtap="onOpenCurrencyPicker"
          data-target="from"
        >
          <view class="conv-unit-text">{{fromName}}</view>
          <text class="conv-unit-caret">▾</text>
        </view>
        <picker
          wx:else
          class="conv-unit-picker"
          mode="selector"
          range="{{unitLabels}}"
          value="{{fromIndex}}"
          bindchange="onFromUnitChange"
        >
          <view class="conv-unit-btn">
            <view class="conv-unit-text">{{fromName}}</view>
            <text class="conv-unit-caret">▾</text>
          </view>
        </picker>
        <input
          class="conv-input"
          type="digit"
          value="{{inputValue}}"
          placeholder="输入数值"
          bindinput="onInputChange"
        />
      </view>

      <view class="conv-swap" bindtap="onSwapUnits" aria-role="button" aria-label="交换单位">⇅</view>

      <view class="conv-card conv-card-to">
        <view class="conv-card-label">到</view>
        <view
          wx:if="{{type === 'currency'}}"
          class="conv-unit-btn"
          bindtap="onOpenCurrencyPicker"
          data-target="to"
        >
          <view class="conv-unit-text">{{toName}}</view>
          <text class="conv-unit-caret">▾</text>
        </view>
        <picker
          wx:else
          class="conv-unit-picker"
          mode="selector"
          range="{{unitLabels}}"
          value="{{toIndex}}"
          bindchange="onToUnitChange"
        >
          <view class="conv-unit-btn">
            <view class="conv-unit-text">{{toName}}</view>
            <text class="conv-unit-caret">▾</text>
          </view>
        </picker>
        <view class="conv-output">{{resultValue || '—'}}</view>
      </view>
    </view>

    <scroll-view
      wx:if="{{type !== 'currency' && units.length}}"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
      class="conv-chip-scroll"
    >
      <view class="conv-chips">
        <view
          class="conv-chip {{index === toIndex ? 'active' : ''}}"
          wx:for="{{units}}"
          wx:key="key"
          bindtap="onSelectToUnit"
          data-index="{{index}}"
        >
          {{item.name}}
        </view>
      </view>
    </scroll-view>

    <view class="panel conv-list-panel" wx:if="{{type !== 'currency' || showAll}}">
      <view class="conv-list-head">
        <view class="section-title">全部单位</view>
        <view class="conv-list-action" wx:if="{{type === 'currency'}}" bindtap="onToggleAll">收起</view>
      </view>
      <view class="conv-list">
        <view
          class="conv-row {{item.active ? 'active' : ''}}"
          wx:for="{{allResults}}"
          wx:key="key"
          bindtap="onSelectToUnit"
          data-index="{{item.index}}"
        >
          <view class="conv-row-label">
            <view class="conv-row-name">{{item.name}}</view>
          </view>
          <view class="conv-row-value">{{item.value}}</view>
        </view>
      </view>
    </view>

    <view class="panel conv-list-panel" wx:if="{{type === 'currency' && !showAll}}">
      <view class="conv-more" bindtap="onToggleAll">查看全部货币汇率</view>
    </view>
  </scroll-view>

  <view
    class="currency-picker-mask {{pickerKeyboardOpen ? 'keyboard-open' : ''}}"
    wx:if="{{showCurrencyPicker}}"
    catchtouchmove="preventMove"
    bindtap="onCloseCurrencyPicker"
    style="{{pickerKeyboardOffset ? 'padding-bottom:' + pickerKeyboardOffset + 'px;' : ''}}"
  >
    <view
      class="currency-picker-sheet"
      catchtap="preventMove"
      style="{{pickerSheetMaxHeight ? 'max-height:' + pickerSheetMaxHeight + 'px;' : ''}}"
    >
      <view class="currency-picker-title">选择{{currencyPickerTarget === 'from' ? '源' : '目标'}}货币</view>
      <input
        class="currency-picker-search"
        value="{{currencyPickerSearch}}"
        placeholder="搜索代码或中文名，如 USD、日元"
        adjust-position="{{false}}"
        hold-keyboard="{{true}}"
        confirm-type="search"
        bindinput="onCurrencyPickerSearch"
        bindkeyboardheightchange="onPickerKeyboardHeight"
        focus="{{showCurrencyPicker}}"
      />
      <scroll-view
        scroll-y
        class="currency-picker-list"
        enhanced
        show-scrollbar="{{false}}"
        style="{{pickerListHeight ? 'height:' + pickerListHeight + 'px;max-height:' + pickerListHeight + 'px;' : ''}}"
      >
        <view
          class="currency-picker-item {{item.key === currencyPickerActiveKey ? 'active' : ''}}"
          wx:for="{{currencyPickerUnits}}"
          wx:key="key"
          bindtap="onPickCurrency"
          data-key="{{item.key}}"
        >
          {{item.label}}
        </view>
        <view class="currency-picker-empty" wx:if="{{!currencyPickerUnits.length}}">未找到匹配货币</view>
      </scroll-view>
      <view class="currency-picker-close" bindtap="onCloseCurrencyPicker">取消</view>
    </view>
  </view>
</view>

@import "../tool-common.wxss";

.conv-hero {
  margin-top: 0;
  padding: 32rpx 28rpx 36rpx;
  background:
    linear-gradient(160deg, rgba(31, 107, 82, 0.16) 0%, rgba(255, 255, 255, 0.55) 58%),
    var(--color-surface);
}

.conv-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.conv-hero-id {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.tool-icon-wrap {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.tool-icon {
  font-size: 42rpx;
  line-height: 1;
}

.tool-icon-currency {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
}

.tool-icon-length {
  background: linear-gradient(135deg, #dbeafe, #93c5fd);
}

.tool-icon-area {
  background: linear-gradient(135deg, #dcfce7, #86efac);
}

.tool-icon-volume {
  background: linear-gradient(135deg, #e0f2fe, #7dd3fc);
}

.tool-icon-weight {
  background: linear-gradient(135deg, #f3e8ff, #c4b5fd);
}

.tool-icon-temperature {
  background: linear-gradient(135deg, #fee2e2, #fca5a5);
}

.tool-icon-speed {
  background: linear-gradient(135deg, #ffedd5, #fdba74);
}

.tool-icon-pressure {
  background: linear-gradient(135deg, #e2e8f0, #94a3b8);
}

.tool-icon-power {
  background: linear-gradient(135deg, #fef9c3, #facc15);
}

.tool-icon-base {
  background: linear-gradient(135deg, #ede9fe, #a78bfa);
}

.conv-hero-copy {
  min-width: 0;
}

.conv-kicker {
  font-size: 22rpx;
  color: var(--color-muted);
  letter-spacing: 2rpx;
}

.conv-title {
  margin-top: 4rpx;
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-brand);
  line-height: 1.25;
}

.conv-refresh {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-brand-soft);
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid var(--color-line);
}

.conv-eq {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

.conv-result {
  margin-top: 8rpx;
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: var(--color-brand);
  line-height: 1.15;
  word-break: break-all;
}

.conv-result-unit {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.conv-meta {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

.conv-board {
  padding: 8rpx 8rpx 16rpx;
}

.conv-card {
  padding: 24rpx 20rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--color-line);
}

.conv-card-to {
  background: var(--bg-glow-1);
  border-color: rgba(255, 255, 255, 0.55);
}

.conv-card-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-muted);
  letter-spacing: 2rpx;
}

.conv-unit-picker {
  display: block;
  width: 100%;
  margin-top: 14rpx;
}

.conv-unit-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  min-height: 88rpx;
  margin-top: 14rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--color-line);
  box-sizing: border-box;
}

.conv-unit-picker .conv-unit-btn {
  margin-top: 0;
}

.conv-unit-text {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
  line-height: 1.45;
  white-space: normal;
  word-break: break-word;
}

.conv-unit-caret {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-brand-soft);
}

.conv-input,
.conv-output {
  margin-top: 12rpx;
  width: 100%;
  min-height: 88rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-ink);
  line-height: 1.2;
}

.conv-output {
  word-break: break-all;
}

.conv-swap {
  width: 72rpx;
  height: 72rpx;
  margin: -18rpx auto;
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 32rpx;
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  box-shadow: 0 10rpx 22rpx var(--color-shadow);
}

.conv-swap:active {
  transform: scale(0.94);
}

.conv-chip-scroll {
  margin-top: 8rpx;
  white-space: nowrap;
}

.conv-chips {
  display: inline-flex;
  gap: 12rpx;
  padding: 8rpx 4rpx 4rpx;
}

.conv-chip {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-ink);
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
}

.conv-chip.active {
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  border-color: transparent;
}

.conv-list-panel {
  padding-top: 24rpx;
}

.conv-list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.conv-list-action,
.conv-more {
  font-size: 24rpx;
  color: var(--color-brand-soft);
  text-align: center;
}

.conv-more {
  padding: 12rpx 0 4rpx;
}

.conv-list {
  margin-top: 8rpx;
}

.conv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 12rpx;
  margin: 0 -12rpx;
  border-bottom: 1rpx solid var(--color-line);
  border-radius: 16rpx;
}

.conv-row:last-child {
  border-bottom: none;
}

.conv-row.active {
  background: var(--bg-glow-1);
}

.conv-row-label {
  min-width: 0;
  flex: 1;
}

.conv-row-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.conv-row-symbol {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-muted);
}

.conv-row-value {
  flex-shrink: 0;
  max-width: 56%;
  text-align: right;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-brand);
  word-break: break-all;
}

.currency-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.currency-picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: var(--color-mask);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.currency-picker-sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 78vh;
  min-height: 0;
  overflow: hidden;
  border-radius: 24rpx 24rpx 0 0;
  background: var(--color-dialog);
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.currency-picker-mask.keyboard-open .currency-picker-sheet {
  padding-bottom: 16rpx;
}

.currency-picker-list {
  flex: 1;
  min-height: 180rpx;
  margin-top: 16rpx;
  max-height: 52vh;
}

.currency-picker-title {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-brand);
  text-align: center;
}

.currency-picker-search {
  flex-shrink: 0;
  margin-top: 20rpx;
  height: 96rpx;
  min-height: 96rpx;
  padding: 0 28rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--color-line);
  font-size: 32rpx;
  color: var(--color-ink);
}

.currency-picker-item {
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid var(--color-line);
  font-size: 28rpx;
  color: var(--color-ink);
}

.currency-picker-item.active {
  color: var(--color-brand);
  font-weight: 700;
}

.currency-picker-item:last-child {
  border-bottom: none;
}

.currency-picker-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-muted);
}

.currency-picker-close {
  flex-shrink: 0;
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-brand-soft);
}

@import "../tool-common.wxss";

.conv-hero {
  margin-top: 0;
  padding: 32rpx 28rpx 36rpx;
  background:
    linear-gradient(160deg, rgba(99, 102, 241, 0.16) 0%, rgba(255, 255, 255, 0.55) 58%),
    var(--color-surface);
}

.conv-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.conv-hero-id {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tool-icon-wrap {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.tool-icon {
  font-size: 42rpx;
  line-height: 1;
}

.tool-icon-datetime {
  background: linear-gradient(135deg, #e0e7ff, #818cf8);
}

.conv-kicker {
  font-size: 22rpx;
  color: var(--color-muted);
  letter-spacing: 2rpx;
}

.conv-title {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-brand);
  line-height: 1.25;
}

.conv-eq {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.conv-result {
  margin-top: 8rpx;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: var(--color-brand);
  line-height: 1.15;
  word-break: break-all;
}

.conv-result-unit {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.seg-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.seg-row.cols-3 {
  grid-template-columns: 1fr 1fr 1fr;
}

.seg-item {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-muted);
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid var(--color-line);
}

.seg-item.active {
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  border-color: transparent;
}

.conv-board {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-top: 12rpx;
}

.conv-card {
  flex: 1;
  min-width: 0;
  padding: 20rpx 18rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--color-line);
}

.conv-card-label {
  font-size: 22rpx;
  color: var(--color-muted);
}

.conv-unit-btn {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.conv-unit-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.conv-unit-caret {
  color: var(--color-muted);
  font-size: 22rpx;
}

.conv-input,
.conv-output {
  margin-top: 16rpx;
  min-height: 64rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.conv-output {
  line-height: 64rpx;
  word-break: break-all;
}

.conv-swap {
  flex-shrink: 0;
  align-self: center;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid var(--color-line);
  color: var(--color-brand);
  font-size: 28rpx;
}

.swap-link {
  margin-top: 8rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-brand);
}

.mini-seg {
  display: flex;
  gap: 8rpx;
}

.mini-seg-item {
  min-width: 88rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-muted);
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid var(--color-line);
}

.mini-seg-item.active {
  color: #fff;
  background: var(--color-brand);
  border-color: transparent;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.quick-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-ink);
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid var(--color-line);
}

.quick-chip:active {
  opacity: 0.75;
}

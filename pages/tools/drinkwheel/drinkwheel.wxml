<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-drinkwheel">
            <text class="tool-icon">🎡</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">酒桌 · 转盘 · 自定义</view>
            <view class="conv-title">喝酒转盘</view>
          </view>
        </view>
        <view
          class="edit-chip {{spinning ? 'is-off' : ''}} {{editHint ? 'is-hint' : ''}}"
          hover-class="edit-chip-hover"
          hover-stay-time="80"
          bindtap="onOpenOptions"
        >
          <text class="edit-chip-mark">✎</text>
          <text>改内容</text>
        </view>
      </view>
      <view class="conv-eq" wx:if="{{lastText}}">指针停在</view>
      <view class="conv-result" wx:if="{{lastText}}">{{lastText}}</view>
      <view class="conv-eq" wx:else>转一次看谁喝。右上角可改惩罚</view>
    </view>

    <view class="panel wheel-panel">
      <view class="wheel-stage">
        <view class="wheel-pointer"></view>
        <view class="wheel" style="{{wheelBg}}; {{wheelStyle}}">
          <view class="wheel-slice" wx:for="{{slices}}" wx:key="id" style="{{item.style}}">
            <text class="wheel-label">{{item.short}}</text>
          </view>
          <view class="wheel-hub"></view>
        </view>
      </view>
      <button class="primary-btn" disabled="{{spinning}}" bindtap="onSpin">
        {{spinning ? '转动中…' : '转一次'}}
      </button>
      <view
        class="options-entry {{spinning ? 'is-off' : ''}}"
        hover-class="options-entry-hover"
        hover-stay-time="80"
        bindtap="onOpenOptions"
      >
        <view class="options-entry-copy">
          <view class="options-entry-title">修改转盘内容</view>
          <view class="options-entry-sub">当前 {{optionCount}} / {{maxOptions}} 条，点这里换惩罚</view>
        </view>
        <view class="options-entry-go">去修改</view>
      </view>
      <view class="tool-note">仅供聚会娱乐，请适量饮酒，不要酒驾。</view>
    </view>
  </scroll-view>

  <view class="tip-mask" wx:if="{{showOptions}}" catchtouchmove="preventMove" catchtap="onCloseOptions">
    <view class="options-dialog" catchtap="preventMove">
      <view class="options-head">
        <view class="options-title">转盘内容</view>
        <view class="options-sub">{{optionCount}} / {{maxOptions}} 条 · 点文字可改</view>
      </view>
      <view class="options-actions">
        <view class="options-action" catchtap="onShuffle">打乱顺序</view>
        <view class="options-action {{isDefault ? 'is-off' : ''}}" catchtap="onResetDefault">恢复默认</view>
      </view>
      <scroll-view scroll-y class="options-body" enhanced show-scrollbar="{{false}}">
        <view class="option-row" wx:for="{{optionRows}}" wx:key="id">
          <view class="option-index">{{item.index + 1}}</view>
          <view class="option-text" catchtap="onOpenEdit" data-index="{{item.index}}">{{item.text}}</view>
          <view class="option-del {{canRemove ? '' : 'is-off'}}" catchtap="onRemoveOption" data-index="{{item.index}}">删除</view>
        </view>
      </scroll-view>
      <view class="add-btn {{canAdd ? '' : 'is-off'}}" catchtap="onOpenAdd">＋ 添加一条（{{minOptions}}–{{maxOptions}} 条）</view>
      <view class="options-done" catchtap="onCloseOptions">完成</view>
    </view>
  </view>

  <view wx:if="{{showEditor}}" class="editor-mask" catchtap="onCancelEditor" catchtouchmove="preventMove">
    <view class="editor-sheet" catchtap="onSheetTap">
      <view class="editor-head">
        <view class="editor-cancel" catchtap="onCancelEditor">取消</view>
        <view class="editor-title">{{editorTitle}}</view>
        <view class="editor-ok" catchtap="onConfirmEditor">保存</view>
      </view>
      <view class="editor-body">
        <input
          class="editor-input"
          maxlength="12"
          value="{{editValue}}"
          placeholder="最多 12 个字"
          focus="{{showEditor}}"
          bindinput="onEditInput"
          bindconfirm="onConfirmEditor"
        />
      </view>
    </view>
  </view>
</view>

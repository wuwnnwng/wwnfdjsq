<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-fuel">
            <text class="tool-icon">🚗</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">油耗 · 电耗 · 花费</view>
            <view class="conv-title">汽车油耗电耗</view>
          </view>
        </view>
      </view>
      <block wx:if="{{result && result.valid}}">
        <view class="conv-eq">{{result.formulaText}}</view>
        <view class="conv-result">{{result.heroText}}</view>
        <view class="conv-result-unit">{{result.subText}}</view>
      </block>
      <view class="tool-note warn" wx:elif="{{result && !result.valid}}">{{result.message}}</view>
    </view>

    <view class="panel">
      <view class="seg-row">
        <view class="seg-item {{kind === 'fuel' ? 'active' : ''}}" bindtap="onSwitchKind" data-kind="fuel">油耗</view>
        <view class="seg-item {{kind === 'ev' ? 'active' : ''}}" bindtap="onSwitchKind" data-kind="ev">电耗</view>
      </view>
      <view class="seg-row">
        <view class="seg-item {{mode === 'trip' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="trip">算百公里消耗</view>
        <view class="seg-item {{mode === 'plan' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="plan">按消耗估费用</view>
      </view>

      <block wx:if="{{kind === 'fuel'}}">
        <block wx:if="{{mode === 'trip'}}">
          <view class="field">
            <text class="field-label">行驶里程</text>
            <view class="field-control">
              <input class="field-input" type="digit" value="{{fuelDistance}}" data-field="fuelDistance" bindinput="onInput" placeholder="例如 500" />
              <text class="field-unit">公里</text>
            </view>
          </view>
          <view class="field">
            <text class="field-label">加油量</text>
            <view class="field-control">
              <input class="field-input" type="digit" value="{{fuelAmount}}" data-field="fuelAmount" bindinput="onInput" placeholder="例如 40" />
              <text class="field-unit">升</text>
            </view>
          </view>
          <view class="field">
            <text class="field-label">油价</text>
            <view class="field-control">
              <input class="field-input" type="digit" value="{{fuelPrice}}" data-field="fuelPrice" bindinput="onInput" placeholder="可不填" />
              <text class="field-unit">元/升</text>
            </view>
          </view>
          <view class="tool-note">记下两次加油之间的里程和加了多少升，就能算出百公里油耗。油价选填，填了会算出花费。</view>
        </block>
        <block wx:else>
          <view class="field">
            <text class="field-label">百公里油耗</text>
            <view class="field-control">
              <input class="field-input" type="digit" value="{{fuelRate}}" data-field="fuelRate" bindinput="onInput" placeholder="例如 8" />
              <text class="field-unit">L/100km</text>
            </view>
          </view>
          <view class="field">
            <text class="field-label">行驶里程</text>
            <view class="field-control">
              <input class="field-input" type="digit" value="{{fuelDistance}}" data-field="fuelDistance" bindinput="onInput" placeholder="例如 500" />
              <text class="field-unit">公里</text>
            </view>
          </view>
          <view class="field">
            <text class="field-label">油价</text>
            <view class="field-control">
              <input class="field-input" type="digit" value="{{fuelPrice}}" data-field="fuelPrice" bindinput="onInput" placeholder="可不填" />
              <text class="field-unit">元/升</text>
            </view>
          </view>
          <view class="tool-note">已知百公里油耗时，估算这段路要加多少油、花多少钱。</view>
        </block>
      </block>

      <block wx:else>
        <block wx:if="{{mode === 'trip'}}">
          <view class="field">
            <text class="field-label">行驶里程</text>
            <view class="field-control">
              <input class="field-input" type="digit" value="{{evDistance}}" data-field="evDistance" bindinput="onInput" placeholder="例如 400" />
              <text class="field-unit">公里</text>
            </view>
          </view>
          <view class="field">
            <text class="field-label">充电量</text>
            <view class="field-control">
              <input class="field-input" type="digit" value="{{evAmount}}" data-field="evAmount" bindinput="onInput" placeholder="例如 60" />
              <text class="field-unit">度</text>
            </view>
          </view>
          <view class="field">
            <text class="field-label">电价</text>
            <view class="field-control">
              <input class="field-input" type="digit" value="{{evPrice}}" data-field="evPrice" bindinput="onInput" placeholder="可不填" />
              <text class="field-unit">元/度</text>
            </view>
          </view>
          <view class="tool-note">记下两次充电之间的里程和充了多少度，就能算出百公里电耗。电价选填，填了会算出花费。</view>
        </block>
        <block wx:else>
          <view class="field">
            <text class="field-label">百公里电耗</text>
            <view class="field-control">
              <input class="field-input" type="digit" value="{{evRate}}" data-field="evRate" bindinput="onInput" placeholder="例如 15" />
              <text class="field-unit">度/100km</text>
            </view>
          </view>
          <view class="field">
            <text class="field-label">行驶里程</text>
            <view class="field-control">
              <input class="field-input" type="digit" value="{{evDistance}}" data-field="evDistance" bindinput="onInput" placeholder="例如 400" />
              <text class="field-unit">公里</text>
            </view>
          </view>
          <view class="field">
            <text class="field-label">电价</text>
            <view class="field-control">
              <input class="field-input" type="digit" value="{{evPrice}}" data-field="evPrice" bindinput="onInput" placeholder="可不填" />
              <text class="field-unit">元/度</text>
            </view>
          </view>
          <view class="tool-note">已知百公里电耗时，估算这段路要充多少电、花多少钱。</view>
        </block>
      </block>
    </view>

    <view class="panel" wx:if="{{result && result.valid}}">
      <view class="section-title">明细</view>
      <view class="result-row" wx:for="{{result.rows}}" wx:key="label">
        <view class="result-row-label">{{item.label}}</view>
        <view class="result-row-value">{{item.value}}</view>
      </view>
      <view class="tool-note">{{result.hint}}</view>
    </view>
  </scroll-view>
</view>

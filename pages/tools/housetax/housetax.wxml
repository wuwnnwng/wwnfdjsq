<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-housetax">
            <text class="tool-icon">🏡</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">契税 · 增值税 · 个税</view>
            <view class="section-title-row">
              <view class="conv-title">房产交易税</view>
              <view class="help-icon" catchtap="onShowTip" aria-role="button" aria-label="计税说明">!</view>
            </view>
          </view>
        </view>
      </view>

      <block wx:if="{{result && result.valid}}">
        <view class="conv-eq">{{tab === 'buy' ? '买方应纳税费' : '卖方应纳税费'}}</view>
        <view class="conv-result">{{result.totalText}}</view>
        <view class="conv-result-unit">约占房价 {{result.totalRateText}}</view>
      </block>
      <view class="tool-note warn" wx:elif="{{result && !result.valid}}">{{result.message}}</view>
    </view>

    <view class="panel">
      <view class="seg-row">
        <view class="seg-item {{tab === 'buy' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="buy">买房</view>
        <view class="seg-item {{tab === 'sell' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="sell">卖房</view>
      </view>

      <view class="field">
        <text class="field-label">成交总价</text>
        <view class="field-control">
          <input class="field-input" type="digit" value="{{priceWan}}" data-field="priceWan" bindinput="onInput" placeholder="例如 200" />
          <text class="field-unit">万元</text>
        </view>
      </view>

      <block wx:if="{{tab === 'buy'}}">
        <view class="field">
          <text class="field-label">建筑面积</text>
          <view class="field-control">
            <input class="field-input" type="digit" value="{{area}}" data-field="area" bindinput="onInput" placeholder="例如 90" />
            <text class="field-unit">㎡</text>
          </view>
        </view>
        <view class="field field-stack">
          <text class="field-label">房屋套次</text>
          <view class="seg-row cols-3 field-seg">
            <view class="seg-item {{homeSet === 'first' ? 'active' : ''}}" bindtap="onSelect" data-field="homeSet" data-value="first">唯一</view>
            <view class="seg-item {{homeSet === 'second' ? 'active' : ''}}" bindtap="onSelect" data-field="homeSet" data-value="second">第二套</view>
            <view class="seg-item {{homeSet === 'third' ? 'active' : ''}}" bindtap="onSelect" data-field="homeSet" data-value="third">第三套+</view>
          </view>
        </view>
        <view class="tool-note">家庭范围含购房人、配偶及未成年子女。面积以不动产登记的建筑面积为准。</view>
      </block>

      <block wx:else>
        <view class="field field-stack">
          <text class="field-label">持有时长</text>
          <view class="seg-row cols-3 field-seg">
            <view class="seg-item {{hold === 'under2' ? 'active' : ''}}" bindtap="onSelect" data-field="hold" data-value="under2">未满2年</view>
            <view class="seg-item {{hold === 'over2' ? 'active' : ''}}" bindtap="onSelect" data-field="hold" data-value="over2">满2年</view>
            <view class="seg-item {{hold === 'over5' ? 'active' : ''}}" bindtap="onSelect" data-field="hold" data-value="over5">满5年</view>
          </view>
        </view>
        <view class="field field-stack">
          <text class="field-label">家庭唯一</text>
          <view class="seg-row field-seg">
            <view class="seg-item {{onlyHome === 'yes' ? 'active' : ''}}" bindtap="onSelect" data-field="onlyHome" data-value="yes">是</view>
            <view class="seg-item {{onlyHome === 'no' ? 'active' : ''}}" bindtap="onSelect" data-field="onlyHome" data-value="no">否</view>
          </view>
        </view>
        <block wx:if="{{hold !== 'over5' || onlyHome !== 'yes'}}">
          <view class="field field-stack">
            <text class="field-label">个税方式</text>
            <view class="seg-row field-seg">
              <view class="seg-item {{pitMethod === 'assessed' ? 'active' : ''}}" bindtap="onSelect" data-field="pitMethod" data-value="assessed">核定 1%</view>
              <view class="seg-item {{pitMethod === 'verified' ? 'active' : ''}}" bindtap="onSelect" data-field="pitMethod" data-value="verified">核实 20%</view>
            </view>
          </view>
          <view class="field" wx:if="{{pitMethod === 'verified'}}">
            <text class="field-label">房屋原值</text>
            <view class="field-control">
              <input class="field-input" type="digit" value="{{originalWan}}" data-field="originalWan" bindinput="onInput" placeholder="原购房价" />
              <text class="field-unit">万元</text>
            </view>
          </view>
        </block>
        <view class="tool-note">满2年免征增值税；满5年且为家庭唯一生活用房免征个人所得税。满2年指已满2年未满5年。</view>
      </block>
    </view>

    <view class="panel" wx:if="{{tab === 'buy' && result && result.valid}}">
      <view class="section-title">买方明细</view>
      <view class="result-row">
        <view class="result-row-label">契税税率</view>
        <view class="result-row-value">{{result.deedRateText}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">契税</view>
        <view class="result-row-value">{{result.deedTaxText}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">印花税</view>
        <view class="result-row-value">{{result.stampTaxText}}</view>
      </view>
      <view class="result-row result-row-wrap">
        <view class="result-row-label">适用规则</view>
        <view class="result-row-value">{{result.deedRuleText}}</view>
      </view>
      <view class="tool-note">个人购买住房暂免印花税。第三套及以上未列入低税率优惠，按 3% 测算，部分地区法定税率为 3%–5%。</view>
    </view>

    <view class="panel" wx:if="{{tab === 'sell' && result && result.valid}}">
      <view class="section-title">卖方明细</view>
      <view class="result-row">
        <view class="result-row-label">增值税</view>
        <view class="result-row-value">{{result.vatText}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">城建税及附加</view>
        <view class="result-row-value">{{result.surchargeText}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">个人所得税</view>
        <view class="result-row-value">{{result.incomeTaxText}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">印花税</view>
        <view class="result-row-value">{{result.stampTaxText}}</view>
      </view>
      <view class="result-row">
        <view class="result-row-label">土地增值税</view>
        <view class="result-row-value">{{result.landVatText}}</view>
      </view>
      <view class="tool-note" wx:if="{{result.incomeTaxRule}}">{{result.incomeTaxRule}}</view>
      <view class="tool-note">增值税附加按市区常见口径测算：城建税 7% + 教育费附加 3% + 地方教育附加 2%。县城及其他地区城建税税率不同，请以当地申报为准。</view>
    </view>
  </scroll-view>

  <view class="tip-mask" wx:if="{{showTip}}" catchtouchmove="preventMove" bindtap="onHideTip">
    <view class="tip-dialog" catchtap="preventMove">
      <view class="tip-title">计税规则说明</view>
      <view class="tip-text">
        买方主要缴纳契税：家庭唯一或第二套住房，建筑面积 140 ㎡及以下按 1%；唯一住房超过 140 ㎡按 1.5%，第二套超过 140 ㎡按 2%。卖方出售购买不足 2 年的住房，按成交价 3% 全额缴纳增值税，满 2 年免征。个人所得税在「满五唯一」时免征，否则可按核定 1% 或核实差价 20% 测算。个人买卖住房暂免印花税，个人销售住房暂免土地增值税。结果仅供测算，各地细则、核定率及附加税可能不同，请以税务机关核定为准。
      </view>
      <view class="tip-confirm" bindtap="onHideTip">我知道了</view>
    </view>
  </view>
</view>

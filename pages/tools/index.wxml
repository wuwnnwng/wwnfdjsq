<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel tool-intro-panel">
      <view class="section-title">工具箱</view>
      <view class="section-desc">日历黄历、个税测算、日期时间、二维码，还有更多工具</view>
    </view>

    <view class="panel tool-grid-panel">
      <view
        class="tool-card"
        wx:for="{{tools}}"
        wx:key="id"
        bindtap="onOpenTool"
        data-page="{{item.page}}"
      >
        <view class="tool-icon-wrap tool-icon-{{item.iconType}}">
          <text class="tool-icon">{{item.icon}}</text>
        </view>
        <view class="tool-card-name">{{item.name}}</view>
      </view>
    </view>
  </scroll-view>
</view>

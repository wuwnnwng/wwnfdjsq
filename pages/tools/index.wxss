@import "./tool-common.wxss";

.tool-search-panel {
  margin-top: 0;
  padding: 20rpx 22rpx;
}

.tool-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.tool-search-mark {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.tool-search-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 30rpx;
  color: var(--color-ink);
}

.tool-search-placeholder {
  color: var(--color-muted);
}

.tool-search-clear {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 32rpx;
  color: #fff;
  background: rgba(95, 114, 104, 0.45);
}

.tool-empty {
  margin-top: 20rpx;
  padding: 48rpx 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.tool-group-panel {
  margin-top: 20rpx;
  padding: 24rpx 20rpx 28rpx;
}

.tool-group-panel:last-child {
  margin-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.tool-group-title {
  margin: 0 8rpx 20rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-brand);
  letter-spacing: 1rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx 16rpx;
}

.tool-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 208rpx;
  padding: 26rpx 10rpx 22rpx;
  border-radius: 28rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-card-border);
  box-shadow: 0 10rpx 28rpx var(--color-shadow), 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.tool-card:active {
  transform: scale(0.97);
  opacity: 0.96;
}

.tool-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.12);
}

.tool-icon {
  font-size: 44rpx;
  line-height: 1;
}


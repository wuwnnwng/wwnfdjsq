<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-percent">
            <text class="tool-icon">％</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">占比 · 增减 · 折扣</view>
            <view class="conv-title">百分比</view>
          </view>
        </view>
      </view>
      <block wx:if="{{result && result.valid}}">
        <view class="conv-eq">{{result.formulaText}}</view>
        <view class="conv-result">{{result.valueText}}</view>
        <view class="conv-result-unit" wx:if="{{tab === 'of'}}">加上该比例 {{result.plusText}} · 减去该比例 {{result.minusText}}</view>
        <view class="conv-result-unit" wx:elif="{{tab === 'is'}}">剩余 {{result.restText}}</view>
        <view class="conv-result-unit" wx:elif="{{tab === 'change'}}">差额 {{result.deltaText}}</view>
      </block>
      <view class="tool-note warn" wx:elif="{{result && !result.valid}}">{{result.message}}</view>
    </view>

    <view class="panel">
      <view class="seg-row cols-3">
        <view class="seg-item {{tab === 'of' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="of">求数值</view>
        <view class="seg-item {{tab === 'is' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="is">求占比</view>
        <view class="seg-item {{tab === 'change' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="change">增减幅</view>
      </view>

      <block wx:if="{{tab === 'of'}}">
        <view class="field">
          <text class="field-label">基数</text>
          <view class="field-control">
            <input class="field-input" type="digit" value="{{base}}" data-field="base" bindinput="onInput" placeholder="例如 200" />
          </view>
        </view>
        <view class="field">
          <text class="field-label">百分比</text>
          <view class="field-control">
            <input class="field-input" type="digit" value="{{percent}}" data-field="percent" bindinput="onInput" placeholder="例如 15" />
            <text class="field-unit">%</text>
          </view>
        </view>
        <view class="tool-note">求「200 的 15% 是多少」，并同时给出加、减该比例后的结果。</view>
      </block>

      <block wx:elif="{{tab === 'is'}}">
        <view class="field">
          <text class="field-label">部分值</text>
          <view class="field-control">
            <input class="field-input" type="digit" value="{{part}}" data-field="part" bindinput="onInput" placeholder="例如 30" />
          </view>
        </view>
        <view class="field">
          <text class="field-label">整体值</text>
          <view class="field-control">
            <input class="field-input" type="digit" value="{{whole}}" data-field="whole" bindinput="onInput" placeholder="例如 200" />
          </view>
        </view>
        <view class="tool-note">求「30 是 200 的百分之几」。</view>
      </block>

      <block wx:else>
        <view class="field">
          <text class="field-label">原值</text>
          <view class="field-control">
            <input class="field-input" type="digit" value="{{fromValue}}" data-field="fromValue" bindinput="onInput" placeholder="例如 200" />
          </view>
        </view>
        <view class="field">
          <text class="field-label">新值</text>
          <view class="field-control">
            <input class="field-input" type="digit" value="{{toValue}}" data-field="toValue" bindinput="onInput" placeholder="例如 230" />
          </view>
        </view>
        <view class="tool-note">求从原值到新值增加或减少了百分之几。</view>
      </block>
    </view>
  </scroll-view>
</view>

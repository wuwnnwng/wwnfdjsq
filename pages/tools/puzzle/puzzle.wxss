@import "../doodle-kit.wxss";

.tool-icon-puzzle {
  background: linear-gradient(135deg, #dbeafe, #60a5fa);
}

.puzzle-hero {
  flex-shrink: 0;
  margin-top: 0;
  padding: 20rpx 24rpx 8rpx;
}

.play-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background:
    radial-gradient(120% 80% at 0% 0%, var(--bg-glow-1), transparent 55%),
    radial-gradient(90% 70% at 100% 10%, var(--bg-glow-2), transparent 50%),
    linear-gradient(180deg, var(--bg-grad-1) 0%, var(--bg-grad-2) 42%, var(--bg-grad-3) 100%);
}

.play-wrap {
  flex: 1;
  min-height: 0;
  padding: 0 8rpx 12rpx;
  overflow: auto;
}

.puzzle-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.play-board-wrap {
  display: flex;
  justify-content: center;
}

.puzzle-art-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 300px;
  height: 300px;
}

.puzzle-thumbs-canvas {
  position: fixed;
  left: -4000px;
  top: 0;
  width: 300px;
  height: 300px;
}

.tile-board-host {
  position: relative;
}

.tile.lifted {
  opacity: 0.38;
}

.tile-ghost {
  display: none;
  position: fixed;
  pointer-events: none;
  z-index: 40;
  border-radius: 8rpx;
  background-repeat: no-repeat;
  background-color: #e2e8f0;
  box-shadow: 0 16rpx 32rpx rgba(20, 35, 28, 0.28);
  opacity: 0.94;
}

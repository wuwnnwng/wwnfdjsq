<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-qrcode">
            <text class="tool-icon">🔳</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">文字 · 网址</view>
            <view class="conv-title">二维码</view>
          </view>
        </view>
      </view>
      <view class="conv-eq" wx:if="{{mode === 'url'}}">扫码打开网站；微信打不开时可复制网址到浏览器</view>
      <view class="conv-eq" wx:else>扫码不打开页面，可复制文字</view>
    </view>

    <view class="panel">
      <view class="seg-row">
        <view class="seg-item {{mode === 'text' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="text">文字</view>
        <view class="seg-item {{mode === 'url' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="url">网站</view>
      </view>
      <view class="seg-row protocol-row" wx:if="{{mode === 'url'}}">
        <view class="seg-item {{urlScheme === 'https' ? 'active' : ''}}" bindtap="onSwitchScheme" data-scheme="https">https://</view>
        <view class="seg-item {{urlScheme === 'http' ? 'active' : ''}}" bindtap="onSwitchScheme" data-scheme="http">http://</view>
      </view>
      <textarea
        class="qr-input"
        value="{{inputValue}}"
        maxlength="400"
        auto-height
        placeholder="{{mode === 'url' ? '输入网址，例如 www.example.com' : '输入要写入二维码的文字'}}"
        placeholder-class="qr-placeholder"
        bindinput="onInput"
      />
      <view class="qr-actions">
        <view class="qr-action" bindtap="onClear">清空</view>
        <view class="qr-action" wx:if="{{qrContent}}" bindtap="onCopy">{{mode === 'url' ? '复制网址' : '复制内容'}}</view>
      </view>
    </view>

    <view class="panel qr-board">
      <view class="qr-frame" wx:if="{{qrImage}}">
        <image class="qr-image" src="{{qrImage}}" mode="aspectFit" show-menu-by-longpress />
      </view>
      <view class="qr-empty" wx:elif="{{errorText}}">{{errorText}}</view>
      <view class="qr-empty" wx:elif="{{generating}}">正在生成二维码…</view>
      <view class="qr-empty" wx:else>二维码将显示在这里</view>
      <view class="qr-caption" wx:if="{{mode === 'url' && qrContent}}" bindtap="onCopy">{{qrContent}}</view>
      <view class="primary-btn" wx:if="{{qrImage}}" bindtap="onSave">保存到相册</view>
      <view class="tool-note" wx:if="{{mode === 'text'}}">微信扫一扫遇到文字时不会打开页面，可点「复制内容」拿到原文。</view>
      <block wx:else>
        <view class="tool-note warn">微信扫一扫打不开时，说明网址不在白名单。可点「复制网址」粘贴到系统浏览器打开。</view>
        <view class="tool-note">网站默认补 https://，需要明文传输时改成 http://。长按图片也可转发。</view>
      </block>
    </view>
  </scroll-view>

  <canvas type="2d" id="qrCanvas" class="qr-canvas"></canvas>
</view>

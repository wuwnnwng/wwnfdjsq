@import "../tool-common.wxss";

.conv-hero {
  margin-top: 0;
  padding: 32rpx 28rpx 36rpx;
  background:
    linear-gradient(160deg, rgba(15, 23, 42, 0.12) 0%, var(--color-hero-fade) 58%),
    var(--color-surface);
}

.conv-hero-top {
  display: flex;
  align-items: flex-start;
}

.conv-hero-id {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tool-icon-wrap {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.tool-icon {
  font-size: 42rpx;
  line-height: 1;
}

.tool-icon-qrcode {
  background: linear-gradient(135deg, #e2e8f0, #64748b);
}

.conv-kicker {
  font-size: 22rpx;
  color: var(--color-muted);
  letter-spacing: 2rpx;
}

.conv-title {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-brand);
  line-height: 1.25;
}

.conv-eq {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

.seg-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.seg-item {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-muted);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.seg-item.active {
  color: var(--color-on-brand);
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  border-color: transparent;
}

.protocol-row {
  margin-bottom: 8rpx;
}

.protocol-row .seg-item {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
}

.qr-input {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 8rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.55;
  color: var(--color-ink);
}

.qr-placeholder {
  color: var(--color-muted);
}

.qr-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.qr-action {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-brand);
}

.qr-board {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 28rpx 32rpx;
}

.qr-frame {
  width: 460rpx;
  height: 460rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.06);
}

.qr-image {
  width: 100%;
  height: 100%;
}

.qr-empty {
  width: 460rpx;
  height: 460rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: var(--color-soft);
  border: 2rpx dashed var(--color-line);
  color: var(--color-muted);
  font-size: 26rpx;
  text-align: center;
  line-height: 1.5;
}

.qr-caption {
  margin-top: 20rpx;
  max-width: 100%;
  font-size: 24rpx;
  color: var(--color-muted);
  text-align: center;
  word-break: break-all;
  line-height: 1.5;
}

.primary-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-on-brand);
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
}

.qr-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 280px;
  height: 280px;
}

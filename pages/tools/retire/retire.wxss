@import "../tool-common.wxss";
@import "../calc-kit.wxss";

.conv-hero {
  background:
    linear-gradient(160deg, rgba(99, 102, 241, 0.16) 0%, var(--color-hero-fade) 58%),
    var(--color-surface);
}

.tool-icon-retire {
  background: linear-gradient(135deg, #e0e7ff, #818cf8);
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
}

.help-icon {
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid rgba(95, 114, 104, 0.55);
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-metric {
  margin-top: 28rpx;
}

.hero-metric-label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--color-muted);
}

.hero-metric-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 6rpx;
}

.hero-metric-num {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 1.2;
  color: var(--color-brand);
  word-break: break-all;
}

.hero-metric-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-muted);
}

.hero-chips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.hero-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-ink);
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
}

.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.type-chip {
  min-height: 88rpx;
  padding: 12rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 20rpx;
  background: var(--color-soft);
  border: 1rpx solid var(--color-line);
  box-sizing: border-box;
}

.type-chip.active {
  color: var(--color-on-brand);
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  border-color: transparent;
}

.type-chip-name {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  color: inherit;
}

.type-chip-kicker {
  font-size: 18rpx;
  line-height: 1.3;
  text-align: center;
  color: var(--color-muted);
}

.type-chip.active .type-chip-kicker {
  color: inherit;
  opacity: 0.82;
}

.type-hint {
  margin: 8rpx 0 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-muted);
}

.retire-grid {
  margin-top: 0;
}

.retire-grid .info-card-value {
  font-size: 36rpx;
}

.tip-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: var(--color-mask);
}

.tip-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background: var(--color-dialog);
}

.tip-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-brand);
  text-align: center;
}

.tip-text {
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--color-muted);
  text-align: left;
}

.tip-confirm {
  margin-top: 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-on-brand);
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
}

<view class="page page-shell theme-{{theme}}">
  <scroll-view scroll-y class="tool-scroll" enhanced show-scrollbar="{{false}}">
    <view class="panel conv-hero">
      <view class="conv-hero-top">
        <view class="conv-hero-id">
          <view class="tool-icon-wrap tool-icon-rmb">
            <text class="tool-icon">¥</text>
          </view>
          <view class="conv-hero-copy">
            <view class="conv-kicker">金额 · 中文大写</view>
            <view class="conv-title">人民币大写</view>
          </view>
        </view>
      </view>
      <block wx:if="{{result && result.valid}}">
        <view class="conv-eq">{{result.amountText}} 元</view>
        <view class="conv-result compact">{{result.upper}}</view>
        <view class="copy-link" bindtap="onCopy">复制大写</view>
      </block>
      <view class="tool-note warn" wx:elif="{{result && !result.valid}}">{{result.message}}</view>
    </view>

    <view class="panel">
      <view class="field">
        <text class="field-label">金额</text>
        <view class="field-control">
          <input class="field-input" type="digit" value="{{amount}}" bindinput="onInput" placeholder="例如 1234.56" />
          <text class="field-unit">元</text>
        </view>
      </view>
      <view class="tool-note">按银行惯例精确到分，整数金额以「整」收尾。可用于收据、合同填写。</view>
    </view>
  </scroll-view>
</view>

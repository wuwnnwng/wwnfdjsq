@import "../tool-common.wxss";
@import "../calc-kit.wxss";

.conv-hero {
  background:
    linear-gradient(160deg, rgba(167, 139, 250, 0.18) 0%, rgba(255, 255, 255, 0.55) 58%),
    var(--color-surface);
}

.tool-icon-safeperiod {
  background: linear-gradient(135deg, #ede9fe, #a78bfa);
}

.kind-period {
  color: #9f1239;
  background: #fb7185;
}

.kind-fertile {
  color: #9a3412;
  background: #fdba74;
}

.kind-ovulation {
  color: #86198f;
  background: #e879f9;
}

.kind-safe {
  color: #047857;
  background: #6ee7b7;
}

.conv-result.kind-period,
.conv-result.kind-fertile,
.conv-result.kind-ovulation,
.conv-result.kind-safe {
  background: transparent;
}

.cycle-legend {
  display: flex;
  gap: 12rpx;
  margin: 8rpx 0 20rpx;
}

.cycle-swatch {
  flex: 1;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.cycle-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.cycle-day {
  min-height: 88rpx;
  padding: 8rpx 4rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cycle-day.is-today {
  box-shadow: inset 0 0 0 4rpx rgba(20, 35, 28, 0.42);
}

.cycle-day-num,
.cycle-day-date {
  color: inherit;
}

.cycle-day-num {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
}

.cycle-day-date {
  margin-top: 2rpx;
  font-size: 18rpx;
  opacity: 0.78;
}

.tip-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: var(--color-mask);
}

.tip-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background: var(--color-dialog);
  text-align: center;
}

.day-tip-swatch {
  display: inline-block;
  min-width: 96rpx;
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.tip-title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-brand);
}

.day-tip-date {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.day-tip-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.tip-text {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--color-muted);
  text-align: left;
}

.tip-confirm {
  margin-top: 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
}

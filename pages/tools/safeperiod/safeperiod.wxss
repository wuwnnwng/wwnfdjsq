@import "../tool-common.wxss";
@import "../calc-kit.wxss";

.conv-hero {
  background:
    linear-gradient(160deg, rgba(167, 139, 250, 0.18) 0%, rgba(255, 255, 255, 0.55) 58%),
    var(--color-surface);
}

.tool-icon-safeperiod {
  background: linear-gradient(135deg, #ede9fe, #a78bfa);
}

.kind-period {
  color: #e11d48;
}

.kind-fertile {
  color: #ea580c;
}

.kind-ovulation {
  color: #c026d3;
}

.kind-safe {
  color: #059669;
}

.cycle-legend {
  display: flex;
  gap: 16rpx;
  margin: 8rpx 0 20rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.cycle-legend-item::before {
  content: '';
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  margin-right: 8rpx;
  border-radius: 4rpx;
  vertical-align: middle;
}

.cycle-legend-item.period::before {
  background: #fb7185;
}

.cycle-legend-item.fertile::before {
  background: #fdba74;
}

.cycle-legend-item.ovulation::before {
  background: #e879f9;
}

.cycle-legend-item.safe::before {
  background: #6ee7b7;
}

.cycle-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.cycle-day {
  min-height: 88rpx;
  padding: 8rpx 4rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #ecfdf5;
}

.cycle-day.kind-period {
  background: #ffe4e6;
}

.cycle-day.kind-fertile {
  background: #ffedd5;
}

.cycle-day.kind-ovulation {
  background: #fae8ff;
}

.cycle-day.is-today {
  box-shadow: inset 0 0 0 3rpx var(--color-brand);
}

.cycle-day-num {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-ink);
  line-height: 1.2;
}

.cycle-day-date {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: var(--color-muted);
}

@import "../tool-common.wxss";

.conv-hero {
  margin-top: 0;
  padding: 32rpx 28rpx 36rpx;
  background:
    linear-gradient(160deg, rgba(251, 191, 36, 0.18) 0%, rgba(255, 255, 255, 0.55) 58%),
    var(--color-surface);
}

.conv-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.conv-hero-id {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tool-icon-wrap {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.tool-icon {
  font-size: 42rpx;
  line-height: 1;
}

.tool-icon-tax {
  background: linear-gradient(135deg, #fef3c7, #f59e0b);
}

.conv-kicker {
  font-size: 22rpx;
  color: var(--color-muted);
  letter-spacing: 2rpx;
}

.conv-title {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-brand);
  line-height: 1.25;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
}

.help-icon {
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid rgba(95, 114, 104, 0.55);
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 700;
}

.conv-eq {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.conv-result {
  margin-top: 8rpx;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: var(--color-brand);
  line-height: 1.15;
  word-break: break-all;
}

.conv-result-unit {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.seg-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.seg-item {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-muted);
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid var(--color-line);
}

.seg-item.active {
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
  border-color: transparent;
}

.tip-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: var(--color-mask);
}

.tip-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background: var(--color-dialog);
}

.tip-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-brand);
  text-align: center;
}

.tip-text {
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--color-muted);
  text-align: center;
}

.tip-confirm {
  margin-top: 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-soft) 100%);
}

@import "../tool-common.wxss";

.weather-hero {
  margin-top: 0;
}

.weather-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.weather-place {
  flex: 1;
  min-width: 0;
}

.weather-city {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-brand);
  line-height: 1.3;
}

.weather-updated {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.weather-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.weather-action {
  padding: 10rpx 18rpx;
  font-size: 24rpx;
  color: var(--color-brand-soft);
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
}

.weather-now {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
}

.weather-icon {
  font-size: 88rpx;
  line-height: 1;
}

.weather-temp-wrap {
  min-width: 0;
}

.weather-temp {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--color-ink);
}

.weather-temp-unit {
  margin-left: 4rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.weather-summary {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--color-ink);
}

.weather-range {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.weather-metrics {
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-line);
}

.weather-metric {
  flex: 1;
  min-width: 0;
}

.weather-metric-label {
  font-size: 22rpx;
  color: var(--color-muted);
}

.weather-metric-value {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-ink);
  line-height: 1.4;
  word-break: break-all;
}

.hourly-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}

.hourly-row {
  display: inline-flex;
  gap: 8rpx;
  padding-bottom: 8rpx;
}

.hourly-item {
  width: 112rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.45);
}

.hourly-label,
.hourly-pop {
  font-size: 22rpx;
  color: var(--color-muted);
}

.hourly-icon {
  font-size: 36rpx;
  line-height: 1;
}

.hourly-temp {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-ink);
}

.daily-list {
  margin-top: 8rpx;
}

.daily-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.daily-row:last-child {
  border-bottom: none;
}

.daily-label {
  width: 88rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.daily-icon {
  width: 48rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 32rpx;
  line-height: 1;
}

.daily-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-muted);
}

.daily-pop {
  flex-shrink: 0;
  width: 72rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--color-muted);
}

.daily-range {
  flex-shrink: 0;
  width: 140rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.city-picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: var(--color-mask);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.city-picker-sheet {
  width: 100%;
  max-height: 78vh;
  border-radius: 24rpx 24rpx 0 0;
  background: var(--color-dialog);
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.city-picker-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-brand);
  text-align: center;
}

.city-picker-search {
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--color-line);
  font-size: 28rpx;
  color: var(--color-ink);
}

.city-picker-list {
  margin-top: 16rpx;
  max-height: 52vh;
}

.city-picker-group {
  padding: 12rpx 8rpx 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.city-picker-item {
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.city-picker-item.active .city-picker-name {
  color: var(--color-brand);
  font-weight: 700;
}

.city-picker-name {
  font-size: 28rpx;
  color: var(--color-ink);
}

.city-picker-region {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.city-picker-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-muted);
}

.city-picker-close {
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-brand-soft);
}
